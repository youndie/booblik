# Образ **собирает** дистрибутив, а не компилирует его.
#
# Сборочная стадия здесь была и убрана намеренно. Она обещала «результат не зависит от того, что
# стоит у собирающего» — но это уже обеспечивает обёртка Gradle: версия Gradle прибита в
# `gradle-wrapper.properties`, JDK 25 приезжает сам через foojay-резолвер. Взамен она приносила
# три беды: `docker build` компилировал код, **не прошедший гейт** (ни тестов, ни ktlint, ни
# проверки ABI внутри образа не запускается); в контекст приходилось тащить `booblik-benchmark`
# только потому, что Gradle требует существования всех модулей из `settings.gradle.kts`; и любая
# сетевая неурядица роняла сборку до первой прочитанной строки.
#
# Так же устроены образы, на которые мы смотрели: Apache Kafka кладёт в образ готовый `kafka.tgz`,
# Confluent — собранные пакеты. Компиляция внутри образа в этом классе не встречается (§1.20).
#
# Собирать через `ci/docker-build.sh`: он прогоняет гейт и `installDist`, и только потом зовёт
# `docker build`. Прямой `docker build .` тоже сработает — но соберёт то, что лежит в
# `booblik-app/build/install` прямо сейчас, каким бы оно ни было.
FROM bellsoft/liberica-openjre-alpine:25

# Один образ, одна база, и каждая её часть выбрана по причине.
#
# **JRE, а не JDK** — компилятор в рантайме не нужен.
#
# **Alpine** — маленькая, и busybox покрывает всё, что нужно скриптам запуска: они `#!/bin/sh`
# и пользуются только `sed`, `uname` и `command -v` (проверено). Поэтому сюда ничего не
# доустанавливается: Kafka ставит в свой образ `bash`, потому что её скрипты его требуют, — у нас
# такого требования нет, а пакет «на всякий случай» это лишняя поверхность, которую кто-то обязан
# патчить.
#
# **glibc, а не musl.** У BellSoft на Alpine есть оба варианта: `-alpine-musl` (46 МиБ) и
# `-alpine` (50 МиБ), где java слинкована с glibc — проверено `ldd`: `libc.so.6` против
# `libc.musl-x86_64.so.1`. Все замеры проекта сняты на glibc, и четыре мегабайта — плохая цена
# за то, чтобы поставляемый рантайм отличался от измеренного (риск 7).
#
# **BellSoft** — выбор вендора: сборки OpenJDK взаимозаменяемы технически и различаются сроками
# поддержки и скоростью обновлений (§1.20).
LABEL org.opencontainers.image.title="booblik" \
      org.opencontainers.image.description="Брокер сообщений: append-only лог, один процесс, без кластера" \
      org.opencontainers.image.licenses="Apache-2.0"

# Не root. Данные лежат на томе, и владелец каталога должен совпадать с пользователем процесса,
# иначе брокер не сможет создать первый сегмент — и узнает об этом уже в рантайме.
#
# Идентификатор закреплён: файлы на bind-mount принадлежат числу, а не имени, поэтому «плавающий»
# uid между пересборками означал бы, что после обновления образа брокер не может писать в
# собственные данные. 10001 — потому что 1000 в базовых образах обычно занят.
RUN addgroup -S -g 10001 booblik \
    && adduser -S -u 10001 -G booblik -h /var/lib/booblik booblik \
    && mkdir -p /var/lib/booblik \
    && chown booblik:booblik /var/lib/booblik

# Готовый дистрибутив: `./gradlew :booblik-app:installDist`. Если каталога нет, сборка падает
# здесь с внятным «not found» — это и есть напоминание собрать его.
COPY booblik-app/build/install/booblik-app /opt/booblik

# Конфигурация — через окружение: `booblik.port` читается как `BOOBLIK_PORT` и так далее
# (см. BooblikConfig). Файл конфигурации не нужен, поэтому его здесь и нет.
ENV BOOBLIK_DATA_DIR=/var/lib/booblik \
    BOOBLIK_PORT=9092

# **JAVA_OPTS здесь намеренно не задаётся.**
# Профиль рантайма зашит в `DEFAULT_JVM_OPTS` стартового скрипта — те же шесть флагов, под
# которыми сняты все замеры. `JAVA_OPTS` их перебивает, и тогда образ поставляет процесс, который
# никто не мерил (риск 7). Если профиль надо изменить — он меняется в `brokerJvmArgs` корневого
# `build.gradle.kts`, и тогда меняются и замеры. Что флаги доехали, проверяет `ci/docker-smoke.sh`.

USER booblik
WORKDIR /var/lib/booblik
VOLUME ["/var/lib/booblik"]
EXPOSE 9092

# Проверка здоровья — METADATA, а не TCP-connect. Соединение ядро принимает в бэклог само,
# без участия процесса, поэтому connect не отличает работающий брокер от повешенного — ровно та
# неразличимость, которая стоила дня в M-64. Интервал задан явно: каждая проверка поднимает JVM
# (~150 мс, ресёрч §1.19), и на секундном интервале это было бы заметной долей машины.
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD ["/opt/booblik/bin/booblik-health", "127.0.0.1", "9092"]

ENTRYPOINT ["/opt/booblik/bin/booblik-app"]
