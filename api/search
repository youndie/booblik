/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"`MAPPED`"},"1207":{"id":"/docs/benchmarking-1022","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**2 871 080**"},"1208":{"id":"/docs/benchmarking-1023","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**3 115 117**"},"1209":{"id":"/docs/benchmarking-1024","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**−7,8 %**"},"1210":{"id":"/docs/benchmarking-1025","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**да**"},"1211":{"id":"/docs/benchmarking-1026","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"`NONE`"},"1212":{"id":"/docs/benchmarking-1027","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"10"},"1213":{"id":"/docs/benchmarking-1028","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"`MAPPED`"},"1214":{"id":"/docs/benchmarking-1029","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"8 031 780"},"1215":{"id":"/docs/benchmarking-1030","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"7 963 981"},"1216":{"id":"/docs/benchmarking-1031","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"+0,9 %"},"1217":{"id":"/docs/benchmarking-1032","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"нет"},"1218":{"id":"/docs/benchmarking-1033","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"`NONE`"},"1219":{"id":"/docs/benchmarking-1034","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"100"},"1220":{"id":"/docs/benchmarking-1035","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"`MAPPED`"},"1221":{"id":"/docs/benchmarking-1036","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"10 153 188"},"1222":{"id":"/docs/benchmarking-1037","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"10 490 833"},"1223":{"id":"/docs/benchmarking-1038","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"−3,2 %"},"1224":{"id":"/docs/benchmarking-1039","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"нет"},"1225":{"id":"/docs/benchmarking-1040","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"(Полные двенадцать строк — в отчёте прогона; здесь показаны крайние и та единственная, где\nразница вышла за интервалы.)"},"1226":{"id":"/docs/benchmarking-1041","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**Стоимость — одна запись на групповой коммит, ≈ 27 нс.** Считается из единственной строки, где\nэффект отделился от шума: 348,3 нс на коммит против 321,0 нс. Это ровно та конфигурация, где он\nи обязан был проявиться — коммит на каждую запись, без барьера, самый быстрый путь записи, то есть\nмаксимально возможная частота публикаций."},"1227":{"id":"/docs/benchmarking-1042","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**При батчах эффект исчезает, и это не удача, а арифметика.** Публикация происходит раз на\nкоммит, а не раз на запись: при батче 100 те же 27 нс приходятся на сотню записей — **0,27 нс на\nзапись**, что ниже разрешения стенда. Одиннадцать строк из двенадцати это и показывают."},"1228":{"id":"/docs/benchmarking-1043","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**Вывод для M-75: цена приемлема, гейта не требует.** Единственный режим, где она видна, — коммит\nна каждую запись, а он и так противопоказан: M-14 показала, что батч стоит 54 раза. Платить 8 % в\nконфигурации, которая и без того в 54 раза хуже доступной, — не тот размен, ради которого стоит\nусложнять код условной публикацией «только когда есть ожидающие»."},"1229":{"id":"/docs/benchmarking-1044","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-14-m-75-чего-стоит-публикация-highwatermark","content":"**Оговорка.** Одна выделяющаяся строка из двенадцати при доверительном интервале 99,9 % могла бы\nбыть и случайностью (\\~1 %). Но она оказалась ровно там, куда её помещает теория, и величина\nсовпадает с ценой volatile-записи. Отдельного подтверждения это не заменяет; если однажды\nпонадобится, повторить надо на арендованной машине, а не на WSL."},"1230":{"id":"/docs/benchmarking-1045","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-15-m-74-что-купил-долгий-fetch-и-чего-стоит-подписка","content":"Две половины, и у них разная судьба: первая дала число, вторая дала отказ — и он такой же\nрезультат, как число."},"1231":{"id":"/docs/benchmarking-1046","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"То, ради чего делалась M-75. Догнавшему потребителю нечего читать; весь вопрос в том, как часто\nон спрашивает. Восемь потребителей, 20 с, мак."},"1232":{"id":"/docs/benchmarking-1047","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"Стратегия"},"1233":{"id":"/docs/benchmarking-1048","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"Запросов за окно"},"1234":{"id":"/docs/benchmarking-1049","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"В секунду"},"1235":{"id":"/docs/benchmarking-1050","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"На потребителя"},"1236":{"id":"/docs/benchmarking-1051","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"Предсказание"},"1237":{"id":"/docs/benchmarking-1052","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"опрос каждые 50 мс"},"1238":{"id":"/docs/benchmarking-1053","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"2 952"},"1239":{"id":"/docs/benchmarking-1054","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"147,6"},"1240":{"id":"/docs/benchmarking-1055","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**18,45**"},"1241":{"id":"/docs/benchmarking-1056","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"20,00"},"1242":{"id":"/docs/benchmarking-1057","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"долгий FETCH, ожидание 2 с"},"1243":{"id":"/docs/benchmarking-1058","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"80"},"1244":{"id":"/docs/benchmarking-1059","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"4,0"},"1245":{"id":"/docs/benchmarking-1060","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**0,50**"},"1246":{"id":"/docs/benchmarking-1061","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"0,50"},"1247":{"id":"/docs/benchmarking-1062","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**Измеренное сходится с арифметикой**, и колонка «предсказание» в отчёте стоит именно для этого:\nчастота — это `1/интервал` против `1/ожидание`. Опрос слегка отстаёт от предсказанных 20/с, потому\nчто сам `poll()` занимает время сверх задержки; удержание совпало точно."},"1248":{"id":"/docs/benchmarking-1063","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**Отношение — это отношение интервала к ожиданию, а не свойство реализации.** На замеренных\nнастройках 37×; на поставляемом умолчании (опрос 50 мс против ожидания 30 с) это &#x2A;*600×**."},"1249":{"id":"/docs/benchmarking-1064","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**Первый прогон был поставлен неправильно, и это стоит запомнить.** При ожидании 30 с в\nдесятисекундном окне не обновился ни один запрос: «ноль запросов» — правда, которая не говорит\nничего о частоте, а отношение из неё получается делением на ноль. Ожидание должно быть короче\nокна, иначе меряется окно."},"1250":{"id":"/docs/benchmarking-1065","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#151-холостой-трафик-догнавшего-потребителя","content":"**Чего это не отменяет.** Догнавший потребитель не бесплатен и с долгим FETCH: он держит\nсоединение на партицию. Он перестаёт быть источником **трафика** — это другой ресурс, и путать\nих не надо."},"1251":{"id":"/docs/benchmarking-1066","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"Вопрос был: сколько стоит подписка против цикла вокруг `Consumer.poll()` на тех же записях.\nОтвета нет, и вот почему."},"1252":{"id":"/docs/benchmarking-1067","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"Проход"},"1253":{"id":"/docs/benchmarking-1068","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"Мак"},"1254":{"id":"/docs/benchmarking-1069","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"WSL"},"1255":{"id":"/docs/benchmarking-1070","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"1 (холодный)"},"1256":{"id":"/docs/benchmarking-1071","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"+49,0 %"},"1257":{"id":"/docs/benchmarking-1072","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"+49 %"},"1258":{"id":"/docs/benchmarking-1073","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"2"},"1259":{"id":"/docs/benchmarking-1074","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"−9,0 %"},"1260":{"id":"/docs/benchmarking-1075","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"+22,6 %"},"1261":{"id":"/docs/benchmarking-1076","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"3"},"1262":{"id":"/docs/benchmarking-1077","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"−2,8 %"},"1263":{"id":"/docs/benchmarking-1078","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"+1,1 %"},"1264":{"id":"/docs/benchmarking-1079","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"4"},"1265":{"id":"/docs/benchmarking-1080","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"+9,5 %"},"1266":{"id":"/docs/benchmarking-1081","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"−38,2 %"},"1267":{"id":"/docs/benchmarking-1082","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"**Первый проход — чистый прогрев JIT.** Три чтения идут подряд в одной JVM: первое платит за\nкомпиляцию, последнее её наследует. Если бы проба печатала один проход — а она сначала так и\nделала, — выводом было бы «обёртка на 49 % быстрее того, что оборачивает», то есть заведомая\nбессмыслица, поданная как измерение."},"1268":{"id":"/docs/benchmarking-1083","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"**Установившиеся проходы расходятся сильнее возможного эффекта** — от −38 % до +23 %. Это не шум\nвокруг маленькой разницы, это отсутствие разрешения. Честный вывод: **стенд не может ответить на\nэтот вопрос**, и выбирать из этих проходов удобный было бы подгонкой."},"1269":{"id":"/docs/benchmarking-1084","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#152-чего-стоит-flow-против-голого-poll--не-измерено","content":"**Упирается это в M-37.** Стенд и брокер живут в одной JVM и делят кучу, планировщик и GC; при\nчтении миллионов записей в секунду планирование и составляет измеряемую величину. Пока они не\nразведены по процессам, разница в единицы процентов между двумя способами читать одни и те же\nбайты неразличима. M-74 закрыта наполовину, и вторая половина — не «доделать пробу», а **сделать\nM-37**."},"1270":{"id":"/docs/benchmarking-1085","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"Стенд и брокер жили в одной JVM с M3. Это записано в правиле 6 как оговорка ко всем сквозным\nчислам; здесь она наконец измерена, а не оговорена."},"1271":{"id":"/docs/benchmarking-1086","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"**A/B в одной сессии**, две арендованные машины (§1.15), брокер отдельным процессом на `10.0.0.2`,\nгенератор на `10.0.0.3`, между ними 7,85 Гбит/с. Контроль — тот же `probeLoad` на **той же машине**\nчерез час, со стендом внутри процесса брокера. PRODUCE, 8 соединений, батчи по 10 записей на 128 Б."},"1272":{"id":"/docs/benchmarking-1087","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"Цель, запросов/с"},"1273":{"id":"/docs/benchmarking-1088","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"Разнесённые процессы"},"1274":{"id":"/docs/benchmarking-1089","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"Стенд в процессе брокера"},"1275":{"id":"/docs/benchmarking-1090","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"100 000"},"1276":{"id":"/docs/benchmarking-1091","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"принято 99 660 (100 %), p50 **0,736 мс**, p99 102,9 мс"},"1277":{"id":"/docs/benchmarking-1092","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"принято 99 702 (100 %), p50 **6,762 мс**, p99 531,1 мс"},"1278":{"id":"/docs/benchmarking-1093","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"2 000 000 (потолок)"},"1279":{"id":"/docs/benchmarking-1094","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"**140 475** зап/с = 1 404 750 записей/с"},"1280":{"id":"/docs/benchmarking-1095","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"117 669 зап/с = 1 176 689 записей/с"},"1281":{"id":"/docs/benchmarking-1096","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"**Соседство стоило 9,2× по медиане и 19 % потолка.** И это нижняя оценка: разнесённый вариант\nдополнительно тащит трафик через настоящую сеть, то есть платит за то, чего у контроля нет вовсе.\nХвост показателен отдельно — p99 упал в 5,2 раза: конкуренция за процессор и общий GC бьют именно\nпо хвосту, а сквозные числа всех прошлых вех измерялись с этим внутри."},"1282":{"id":"/docs/benchmarking-1097","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-16-m-37-чего-стоило-соседство-стенда-и-брокера","content":"**Что это значит для замера 12.6.** Числа там описывали пару «брокер + нагрузчик» на четырёх ядрах,\nкак и было честно написано. Теперь известен масштаб поправки: медиана там завышена примерно на\nпорядок. Пересчитывать старую таблицу не нужно и нельзя — сравнивать прогоны разных сессий\nзапрещено правилом 3, — но читать её теперь следует с этим коэффициентом."},"1283":{"id":"/docs/benchmarking-1098","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"M-74 не смогла сравнить подписку с голым `poll()` и списала это на общую JVM. Разнесли —\nне помогло:"},"1284":{"id":"/docs/benchmarking-1099","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"Проход"},"1285":{"id":"/docs/benchmarking-1100","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"`Flow` против цикла"},"1286":{"id":"/docs/benchmarking-1101","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"1"},"1287":{"id":"/docs/benchmarking-1102","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"+119,8 %"},"1288":{"id":"/docs/benchmarking-1103","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"2"},"1289":{"id":"/docs/benchmarking-1104","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"+37,4 %"},"1290":{"id":"/docs/benchmarking-1105","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"3"},"1291":{"id":"/docs/benchmarking-1106","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"+8,9 %"},"1292":{"id":"/docs/benchmarking-1107","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"4"},"1293":{"id":"/docs/benchmarking-1108","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"+71,5 %"},"1294":{"id":"/docs/benchmarking-1109","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"**`Flow` стабильно быстрее того, что оборачивает, во всех четырёх проходах.** Обёртка так не\nможет, и разброс 9–120 % это подтверждает. Параметры запросов у обоих путей совпадают\n(`maxBytes` 1 МиБ, ожидание 0), а установка у подписки **дороже** — лишнее соединение и\nround-trip METADATA, — то есть она должна проигрывать, а не выигрывать."},"1295":{"id":"/docs/benchmarking-1110","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#161-стоимость-flow--по-прежнему-не-измерена-и-причина-другая","content":"Вывод не «подписка быстрее», а &#x2A;*«проба сравнивает две программы, а не две абстракции»**.\nСистематическая разница, которую нельзя объяснить, — это диагноз измерителя, а не результат.\nПрежде чем спрашивать снова, пробу надо переделать так, чтобы оба пути отличались **только**\nналичием `Flow`: одно и то же соединение, одна и та же установка, один и тот же цикл выборки.\nЗаведено как M-76."},"1296":{"id":"/docs/benchmarking-1111","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-17-m-76-чего-стоит-flow-в-подписке","content":"Вопрос задавался дважды и дважды не получал ответа: сначала стенд делил JVM с брокером\n(замер 15.2), потом их развели, и `Flow` вышел стабильно **быстрее** оборачиваемого цикла\n(замер 16.1) — что невозможно и означало сломанный измеритель. M-76 чинила измеритель."},"1297":{"id":"/docs/benchmarking-1112","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#171-почему-прошлое-сравнение-было-неверным","content":"Диагноз оказался содержательнее числа. Подписка построена на `callbackFlow`, а он ставит **канал**\nмежду циклом выборки и коллектором: следующий запрос уходит, пока предыдущий батч ещё разбирают.\nГолый цикл строго последователен. То есть сравнивались не две абстракции, а **последовательное\nчтение против конвейерного** — и подписка выигрывала за счёт конкурентности, которой у цикла нет."},"1298":{"id":"/docs/benchmarking-1113","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#171-почему-прошлое-сравнение-было-неверным","content":"Проба переделана в лестницу, где каждая ступень отличается от предыдущей **одним**: соединение\nодно и то же, открыто до начала замера, оффсеты и цикл выборки общие. После этого систематический\nперекос исчез — знак разницы стал скакать в обе стороны, что и подтвердило диагноз."},"1299":{"id":"/docs/benchmarking-1114","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#171-почему-прошлое-сравнение-было-неверным","content":"Но величина осталась ниже разрешения: на сетевом стенде разброс между проходами ±20 %, и он\nхоронит всё, что абстракция может стоить. Это честный ответ **про практику** — на скоростях,\nна которых работает брокер, обёртка не является ограничением, — но не ответ про обёртку."},"1300":{"id":"/docs/benchmarking-1115","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"Сокет убран, осталась форма: те же батчи, отданные тремя способами. JMH, WSL, 5 прогревов +\n10 итераций. Счёт — **на выдачу**, не на запись."},"1301":{"id":"/docs/benchmarking-1116","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"Способ"},"1302":{"id":"/docs/benchmarking-1117","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"Выдач в секунду (батч 10)"},"1303":{"id":"/docs/benchmarking-1118","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"На выдачу"},"1304":{"id":"/docs/benchmarking-1119","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"цикл `for`"},"1305":{"id":"/docs/benchmarking-1120","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"4 565 919 219"},"1306":{"id":"/docs/benchmarking-1121","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"0,22 нс"},"1307":{"id":"/docs/benchmarking-1122","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"холодный `flow { }`"},"1308":{"id":"/docs/benchmarking-1123","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"183 547 381"},"1309":{"id":"/docs/benchmarking-1124","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**5,70 нс**"},"1310":{"id":"/docs/benchmarking-1125","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"он же плюс `buffer()`"},"1311":{"id":"/docs/benchmarking-1126","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"16 697 793"},"1312":{"id":"/docs/benchmarking-1127","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**59,64 нс**"},"1313":{"id":"/docs/benchmarking-1128","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**Машинерия `Flow` — 5,5 нс на выдачу. Канал сверху — ещё 54 нс.** Размер батча на эти числа\nпочти не влияет (16,4–16,8 млн выдач/с при батче от 1 до 100), и это ровно то, чего следовало\nожидать: цена платится за **выдачу**, а не за запись."},"1314":{"id":"/docs/benchmarking-1129","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"Отсюда прямое следствие для API — то самое, ради которого `RecordBatch`\nотдаёт батч, а не запись:"},"1315":{"id":"/docs/benchmarking-1130","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"Батч"},"1316":{"id":"/docs/benchmarking-1131","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"`flow { }` на запись"},"1317":{"id":"/docs/benchmarking-1132","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"с `buffer()` на запись"},"1318":{"id":"/docs/benchmarking-1133","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"1"},"1319":{"id":"/docs/benchmarking-1134","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"5,70 нс"},"1320":{"id":"/docs/benchmarking-1135","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"59,64 нс"},"1321":{"id":"/docs/benchmarking-1136","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"10"},"1322":{"id":"/docs/benchmarking-1137","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"0,57 нс"},"1323":{"id":"/docs/benchmarking-1138","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"5,96 нс"},"1324":{"id":"/docs/benchmarking-1139","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"100"},"1325":{"id":"/docs/benchmarking-1140","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**0,057 нс**"},"1326":{"id":"/docs/benchmarking-1141","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**0,60 нс**"},"1327":{"id":"/docs/benchmarking-1142","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**Сравнивать это надо со сквозным путём: 712 нс на запись** (замер 16, потолок 1 404 750\nзаписей/с). При батче 100 холодный `Flow` — 0,008 % от него, с каналом — 0,08 %. Даже при выдаче\nпо одной записи канал стоит 8 % пути, а `Flow` — меньше процента."},"1328":{"id":"/docs/benchmarking-1143","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**Вот почему сетевая проба не могла это увидеть**, и это не её недоделка: 5,7 нс против 712 нс —\n0,8 %, а разброс стенда ±20 %. Величина была не «зарыта в шуме», а **на два порядка меньше шума**;\nникакая аккуратность в той пробе ответа бы не дала."},"1329":{"id":"/docs/benchmarking-1144","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#172-число-снятое-там-где-оно-измеримо","content":"**Оговорка про базовую строку.** 0,22 нс на выдачу у цикла `for` — это примерно один такт, то есть\nJIT почти наверняка свернул сложение размеров предпосчитанного списка. Читать эту строку как\n«цикл стоит столько» нельзя; она годится только как ноль, относительно которого две другие\nизмерены. Абсолютные 5,70 и 59,64 нс от этого не страдают."},"1330":{"id":"/docs/benchmarking-1145","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"Решение Р9 говорило: базовый образ выбирается замером, а не размером. Вот замер."},"1331":{"id":"/docs/benchmarking-1146","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**Стенд.** WSL, Docker overlayfs. Брокер — **в контейнере**, генератор `probeRemoteLoad` — на хосте,\nто есть разные процессы (M-37). Образы отличаются ровно одной строкой — базой рантайма; сборочная\nстадия общая. Прогоны чередуются: glibc, musl, glibc, musl."},"1332":{"id":"/docs/benchmarking-1147","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"`eclipse-temurin:25-jre`"},"1333":{"id":"/docs/benchmarking-1148","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"`bellsoft/liberica-openjre-alpine-musl:25`"},"1334":{"id":"/docs/benchmarking-1149","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"Размер образа"},"1335":{"id":"/docs/benchmarking-1150","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"514 МБ"},"1336":{"id":"/docs/benchmarking-1151","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**197 МБ**"},"1337":{"id":"/docs/benchmarking-1152","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"Принято, проход 1"},"1338":{"id":"/docs/benchmarking-1153","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"83 464 зап/с"},"1339":{"id":"/docs/benchmarking-1154","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"74 137 зап/с"},"1340":{"id":"/docs/benchmarking-1155","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"Принято, проход 2"},"1341":{"id":"/docs/benchmarking-1156","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"77 222 зап/с"},"1342":{"id":"/docs/benchmarking-1157","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"76 733 зап/с"},"1343":{"id":"/docs/benchmarking-1158","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"p50, проход 1 / 2"},"1344":{"id":"/docs/benchmarking-1159","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"4 163 / 4 580 мс"},"1345":{"id":"/docs/benchmarking-1160","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"4 576 / 4 719 мс"},"1346":{"id":"/docs/benchmarking-1161","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**Образ меньше в 2,6 раза** — отношение держится, а сами мегабайты отозваны в 18.2: перемер\nна другом хосте не воспроизвёл ни 514, ни 197. Таблица оставлена как есть, потому что вывод замера\nпро **производительность** от этого не зависит."},"1347":{"id":"/docs/benchmarking-1162","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**По производительности они неразличимы.** В первом проходе glibc впереди на 12,6 %, во втором —\nна 0,6 %. И главное: &#x2A;*два прохода самого glibc расходятся на 8 %**, то есть собственный разброс\nстенда того же порядка, что и разрыв между базами. Вывод «musl медленнее» отсюда не следует;\nвывод «они одинаковы» — тоже, следует только «здесь не различаются»."},"1348":{"id":"/docs/benchmarking-1163","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**Умолчание остаётся glibc, и это суждение, а не измерение.** «Неразличимы при разрешении 8 %»\nслабее, чем «измерено на этом рантайме», а все восемнадцать замеров проекта сняты на glibc.\nСтавить умолчанием рантайм, под которым не мерил никто, — ровно та подмена, от которой предостерегает\nриск 7. Musl доступен одной строкой:"},"1349":{"id":"/docs/benchmarking-1164","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**Что решило бы вопрос по-настоящему:** тот же замер на арендованной паре, где разрешение было\n2–8 % (замер 16), а не 8 % на WSL. Триста мегабайт образа — достаточный повод это сделать, когда\nмашины снова будут."},"1350":{"id":"/docs/benchmarking-1165","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-18-m-83-базовый-образ--glibc-против-musl","content":"**Побочная находка, за которую пришлось заплатить сборкой.** `Dockerfile` не переносится между\nбазами как есть: Alpine — busybox, там нет `useradd`, а у `adduser` другие флаги."},"1351":{"id":"/docs/benchmarking-1166","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"Развилка «маленький musl против измеренного glibc» оказалась ложной. У BellSoft на Alpine есть\n**оба** варианта, и второй из них — glibc:"},"1352":{"id":"/docs/benchmarking-1167","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"Образ"},"1353":{"id":"/docs/benchmarking-1168","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"Чем слинкована java"},"1354":{"id":"/docs/benchmarking-1169","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"Размер базы"},"1355":{"id":"/docs/benchmarking-1170","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"`bellsoft/liberica-openjre-alpine-musl:25`"},"1356":{"id":"/docs/benchmarking-1171","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"`libc.musl-x86_64.so.1`"},"1357":{"id":"/docs/benchmarking-1172","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"46 МиБ"},"1358":{"id":"/docs/benchmarking-1173","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"`bellsoft/liberica-openjre-alpine:25`"},"1359":{"id":"/docs/benchmarking-1174","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"**`libc.so.6`** (glibc)"},"1360":{"id":"/docs/benchmarking-1175","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"50 МиБ"},"1361":{"id":"/docs/benchmarking-1176","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"Проверено `ldd` внутри обоих образов, а не по названию тега. Оба на Alpine 3.24 с busybox, в\nкотором есть `sed` и `uname` — всё, что нужно нашим скриптам запуска."},"1362":{"id":"/docs/benchmarking-1177","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"**Итоговый образ — `bellsoft/liberica-openjre-alpine:25`, 240 МБ против 514 у temurin на Debian**\n(на Linux; на Docker Desktop те же образы читаются как 176 и 364 — см. 18.3, где разобрано,\nпочему это одно и то же). Размер уменьшился в 2,1 раза,\nа libc остался тем, на котором сняты все замеры. Четыре мегабайта разницы с musl — плохая цена за то, чтобы поставляемый рантайм отличался от измеренного, тем более\nчто замер 18 не нашёл между ними разницы и в скорости."},"1363":{"id":"/docs/benchmarking-1178","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#181-чем-это-кончилось-размер-без-смены-libc","content":"**Ничего не доустанавливается.** Kafka в своём образе ставит `bash`, потому что её скрипты его\nтребуют (§1.20); наши — `#!/bin/sh` и обходятся busybox. Пакет «на всякий случай» — это лишняя\nповерхность, которую потом кто-то обязан патчить."},"1364":{"id":"/docs/benchmarking-1179","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"Пара 240/514 из 18.1 снималась на WSL и попала оттуда в README, `CLAUDE.md`, ресёрч и бэклог.\nПри подготовке репозитория к публикации она не сошлась с базовыми образами: `docker pull` даёт\nу `bellsoft/liberica-openjre-alpine:25` 172 МБ, а дистрибутив добавляет около четырёх, — то есть\n240 неоткуда взять."},"1365":{"id":"/docs/benchmarking-1180","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"Перемер, macOS/Docker Desktop, обе сборки подряд из одного и того же `build/install`, обе под\n`--platform linux/amd64`, `Dockerfile` отличается только строкой `FROM` (и `adduser` против\n`useradd` — Alpine это busybox):"},"1366":{"id":"/docs/benchmarking-1181","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"База"},"1367":{"id":"/docs/benchmarking-1182","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"Размер образа"},"1368":{"id":"/docs/benchmarking-1183","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"Размер базы"},"1369":{"id":"/docs/benchmarking-1184","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"`eclipse-temurin:25-jre`"},"1370":{"id":"/docs/benchmarking-1185","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"364 МБ"},"1371":{"id":"/docs/benchmarking-1186","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"360 МБ"},"1372":{"id":"/docs/benchmarking-1187","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"`bellsoft/liberica-openjre-alpine:25`"},"1373":{"id":"/docs/benchmarking-1188","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"**176 МБ**"},"1374":{"id":"/docs/benchmarking-1189","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"172 МБ"},"1375":{"id":"/docs/benchmarking-1190","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"**Отношение 2,1× подтвердилось. Вывод про «отозванные абсолютные числа» неверен — см. 18.3.**\nЗдесь было написано, что 240, 514 и 197 «неоткуда взять», потому что база плюс дистрибутив дают\nменьше. Проверка базы делалась на том же хосте, где считалась арифметика, и не делалась на том,\nоткуда пришли исходные числа. Они воспроизводятся там до мегабайта: размер образа просто\nне сравним между хостами."},"1376":{"id":"/docs/benchmarking-1191","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"Разница между архитектурами при этом невелика и целиком приходится на базу: arm64 — 154 МБ базы\nи 158 МБ образа против 172 и 176 на amd64. В документах остаётся **amd64**: это то, на чём\nброкер будет работать."},"1377":{"id":"/docs/benchmarking-1192","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#182-перемер-размеров-отношение-уцелело-абсолютные-числа--нет-️-вывод-отозван-в-183","content":"**Что это не отменяет.** Вывод 18.1 — «размер и тот же libc не противоречат друг другу» — держится\nна `ldd` внутри образов, а не на мегабайтах, и от перемера не зависит."},"1378":{"id":"/docs/benchmarking-1193","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-19-2026-08-11-чего-не-может-измерить-общий-раннер","content":"Первый прогон `benchmark.yml` на раннере GitHub закончился зелёным порогом и **таблицей, которую\nя прочитал неправильно**. Разбор этого чтения полезнее самих чисел, поэтому записан целиком."},"1379":{"id":"/docs/benchmarking-1194","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"В отчёте, при сравнении **внутри одного прогона** (правило 3 такое сравнение разрешает):"},"1380":{"id":"/docs/benchmarking-1195","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"Конфигурация"},"1381":{"id":"/docs/benchmarking-1196","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"`FILE_CHANNEL`"},"1382":{"id":"/docs/benchmarking-1197","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"`MAPPED`"},"1383":{"id":"/docs/benchmarking-1198","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"сброс на запись, 64 Б"},"1384":{"id":"/docs/benchmarking-1199","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"**4 821 ± 248**"},"1385":{"id":"/docs/benchmarking-1200","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"3 150 ± 35"},"1386":{"id":"/docs/benchmarking-1201","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"`FILE_CHANNEL` в 1,53×"},"1387":{"id":"/docs/benchmarking-1202","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"сброс на запись, 1 КиБ"},"1388":{"id":"/docs/benchmarking-1203","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"**4 436 ± 387**"},"1389":{"id":"/docs/benchmarking-1204","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"3 123 ± 38"},"1390":{"id":"/docs/benchmarking-1205","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"`FILE_CHANNEL` в 1,42×"},"1391":{"id":"/docs/benchmarking-1206","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"групповой коммит, 1 продюсер"},"1392":{"id":"/docs/benchmarking-1207","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"**4 124 ± 207**"},"1393":{"id":"/docs/benchmarking-1208","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"3 148 ± 32"},"1394":{"id":"/docs/benchmarking-1209","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"`FILE_CHANNEL` в 1,31×"},"1395":{"id":"/docs/benchmarking-1210","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"Это противоречит итогу M-46 — «маппинг быстрее по всем осям без исключения, 1,7× со сбросом\nна каждую запись». Разница на операцию — 0,110 мс на 64 Б и 0,095 мс на килобайте, то есть\n**от размера записи не зависит**, и это выглядело как механизм: `MappedSegmentWriter.force()`\nзовёт `msync` и `fsync`, а `FileChannelSegmentWriter` — один `fdatasync`."},"1396":{"id":"/docs/benchmarking-1211","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#191-что-показалось","content":"Гипотез было две, и у них разные последствия: либо барьер на этом хосте дёшев и второй вызов\nперестал теряться в шуме (свойство машины), либо `msync` обходит весь маппинг, а бенчмарк маппит\n**1 ГиБ** на сегмент (дефект нашего кода, чинится сужением диапазона)."},"1397":{"id":"/docs/benchmarking-1212","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"Обе гипотезы неверны. Проверено на том же классе раннера."},"1398":{"id":"/docs/benchmarking-1213","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**`msync` не зависит от размера маппинга и не стоит второго барьера.** `force()` на всём маппинге,\nна одной странице и вовсе без `msync` дают одно и то же:"},"1399":{"id":"/docs/benchmarking-1214","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"1 ГиБ маппинг"},"1400":{"id":"/docs/benchmarking-1215","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"16 МиБ маппинг"},"1401":{"id":"/docs/benchmarking-1216","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`force()` на весь маппинг + `fdatasync`"},"1402":{"id":"/docs/benchmarking-1217","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,133 мс"},"1403":{"id":"/docs/benchmarking-1218","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,129 мс"},"1404":{"id":"/docs/benchmarking-1219","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`force()` на записанную страницу + `fdatasync`"},"1405":{"id":"/docs/benchmarking-1220","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,136 мс"},"1406":{"id":"/docs/benchmarking-1221","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,131 мс"},"1407":{"id":"/docs/benchmarking-1222","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"только `fdatasync`"},"1408":{"id":"/docs/benchmarking-1223","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,137 мс"},"1409":{"id":"/docs/benchmarking-1224","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,135 мс"},"1410":{"id":"/docs/benchmarking-1225","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**Разница между путями не воспроизводится.** Оба пути, собранные рядом в одном процессе, с теми же\nпараметрами (1 ГиБ, записи по 64 Б, барьер на каждую):"},"1411":{"id":"/docs/benchmarking-1226","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"Проход"},"1412":{"id":"/docs/benchmarking-1227","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`mapped`"},"1413":{"id":"/docs/benchmarking-1228","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`channel`"},"1414":{"id":"/docs/benchmarking-1229","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"1"},"1415":{"id":"/docs/benchmarking-1230","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,119 мс"},"1416":{"id":"/docs/benchmarking-1231","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,104 мс"},"1417":{"id":"/docs/benchmarking-1232","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"2"},"1418":{"id":"/docs/benchmarking-1233","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**0,091 мс**"},"1419":{"id":"/docs/benchmarking-1234","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"0,094 мс"},"1420":{"id":"/docs/benchmarking-1235","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"В первом проходе маппинг медленнее на 14 %, во втором — быстрее на 3 %. Разница между путями\nменьше разницы между двумя проходами одной программы. Вариант без `msync` — 0,095 мс, то есть\nнеотличим; вариант без барьера вовсе — 0,004 мс, барьер и есть вся стоимость."},"1421":{"id":"/docs/benchmarking-1236","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**У хоста нет разрешения для этого вопроса.** `probeDurability`, запущенная дважды на раннерах\nодного класса:"},"1422":{"id":"/docs/benchmarking-1237","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"прогон 1"},"1423":{"id":"/docs/benchmarking-1238","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"прогон 2"},"1424":{"id":"/docs/benchmarking-1239","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`fsync` один"},"1425":{"id":"/docs/benchmarking-1240","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"46,50 мс"},"1426":{"id":"/docs/benchmarking-1241","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**75,81 мс**"},"1427":{"id":"/docs/benchmarking-1242","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"`msync` один"},"1428":{"id":"/docs/benchmarking-1243","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"68,26 мс"},"1429":{"id":"/docs/benchmarking-1244","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"**40,54 мс**"},"1430":{"id":"/docs/benchmarking-1245","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"разброс мин–макс"},"1431":{"id":"/docs/benchmarking-1246","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"9,62 … 91,40 мс"},"1432":{"id":"/docs/benchmarking-1247","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#192-что-оказалось","content":"Знак перевернулся между прогонами. В `host.txt` раннера стоит `rotational: 1`."},"1433":{"id":"/docs/benchmarking-1248","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#193-вывод-и-он-не-про-маппинг","content":"Итог M-46 **не оговаривается и не отзывается**: CI-прогон не может высказаться о нём ни за,\nни против. Числа M-46 сняты на машине с барьерами по 11,36 мс, где 0,11 мс хвостового `fsync`\nсоставляли 1 %; здесь барьер сам по себе — шум амплитудой в два раза."},"1434":{"id":"/docs/benchmarking-1249","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#193-вывод-и-он-не-про-маппинг","content":"Что здесь по-настоящему поучительно — **узкий доверительный интервал JMH ничего не гарантирует**.\n±1 % у `MAPPED` означает, что десять итераций подряд легли одинаково, потому что состояние диска\nне менялось эти двадцать секунд. Это не то же самое, что «число описывает код», и именно узость\nинтервала делает такую строку убедительной."},"1435":{"id":"/docs/benchmarking-1250","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#193-вывод-и-он-не-про-маппинг","content":"**Что сделано.** `benchmark.yml` переведён на `mainCiBenchmark`: из прогона убраны\n`GroupCommitBenchmark` целиком и строки `SegmentAppendBenchmark` со сбросом на каждую запись.\nОтчёт, который никто не может прочитать правильно, — приглашение к ошибке, а не данные."},"1436":{"id":"/docs/benchmarking-1251","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#193-вывод-и-он-не-про-маппинг","content":"**Чего сделано не было, хотя предлагалось.** Добавить `probeDurability` в регулярный прогон CI.\nИдея была превратить арифметику в измерение; этот замер показал, что получилось бы регулярное\nчисло с перевёрнутым знаком через раз."},"1437":{"id":"/docs/benchmarking-1252","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"Отношения, снятые в том же прогоне, воспроизводят выводы проекта близко к машине M-46:"},"1438":{"id":"/docs/benchmarking-1253","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"этот прогон"},"1439":{"id":"/docs/benchmarking-1254","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"M-46"},"1440":{"id":"/docs/benchmarking-1255","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"батч 1 → 100, `FILE_CHANNEL`, `WRITTEN`"},"1441":{"id":"/docs/benchmarking-1256","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"13,8×"},"1442":{"id":"/docs/benchmarking-1257","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"14,3×"},"1443":{"id":"/docs/benchmarking-1258","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"батч 1 → 100, `MAPPED`, `WRITTEN`"},"1444":{"id":"/docs/benchmarking-1259","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"56,3×"},"1445":{"id":"/docs/benchmarking-1260","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"58,6×"},"1446":{"id":"/docs/benchmarking-1261","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"`FILE_CHANNEL` перестаёт отвечать на батч (`NONE`, 1 → 100)"},"1447":{"id":"/docs/benchmarking-1262","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"1,1×"},"1448":{"id":"/docs/benchmarking-1263","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"подтверждено"},"1449":{"id":"/docs/benchmarking-1264","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"маппинг без сброса, 64 Б"},"1450":{"id":"/docs/benchmarking-1265","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"15,3×"},"1451":{"id":"/docs/benchmarking-1266","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"13,9×"},"1452":{"id":"/docs/benchmarking-1267","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#194-что-осталось-верным","content":"**Отношения переносятся между машинами, абсолютные значения — нет.** Это лучшее, что можно было\nузнать про устойчивость выводов, и получено оно из прогона, который затевался ради одной строчки\n«ничего не рухнуло»."},"1453":{"id":"/docs/benchmarking-1268","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-20-m-103-чего-стоит-очередь-без-координатора","content":"Очередь из M-102 берёт задачу кругом «записал заявку → дочитал лог до неё», а\nконфликты разрешает порядком записей. Вопрос замера: сколько стоит круг и сколько работы уходит\nв проигранные заявки."},"1454":{"id":"/docs/benchmarking-1269","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-20-m-103-чего-стоит-очередь-без-координатора","content":"**Стенд назван, потому что он слабый.** macOS, Docker Desktop (то есть Linux в виртуалке),\nброкер — **нативный arm64-образ**, а не опубликованный amd64: под эмуляцией мерился бы QEMU.\nПять контейнеров: брокер, паблишер, три воркера. Задачи каждые 10 мс, работа над задачей 400 мс,\nто есть очередь всегда с заделом — три воркера дают потолок 7,5 задач/с."},"1455":{"id":"/docs/benchmarking-1270","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-20-m-103-чего-стоит-очередь-без-координатора","content":"Числа — **разность двух снимков лога** в окне 60 с, а не «сколько накопилось»: стартовые эффекты\nиначе попадают в результат, о чём ниже."},"1456":{"id":"/docs/benchmarking-1271","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Две пары прогонов подряд, в одной сессии."},"1457":{"id":"/docs/benchmarking-1272","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Стратегия выбора"},"1458":{"id":"/docs/benchmarking-1273","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Пропускная"},"1459":{"id":"/docs/benchmarking-1274","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Попыток на задачу"},"1460":{"id":"/docs/benchmarking-1275","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Потеряно"},"1461":{"id":"/docs/benchmarking-1276","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"Круг p50"},"1462":{"id":"/docs/benchmarking-1277","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"p90"},"1463":{"id":"/docs/benchmarking-1278","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"p99"},"1464":{"id":"/docs/benchmarking-1279","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"`first`, прогон 1"},"1465":{"id":"/docs/benchmarking-1280","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"6,6/с"},"1466":{"id":"/docs/benchmarking-1281","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,38"},"1467":{"id":"/docs/benchmarking-1282","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"27,3 %"},"1468":{"id":"/docs/benchmarking-1283","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"0,49 мс"},"1469":{"id":"/docs/benchmarking-1284","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,05"},"1470":{"id":"/docs/benchmarking-1285","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"2,30"},"1471":{"id":"/docs/benchmarking-1286","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"`first`, прогон 2"},"1472":{"id":"/docs/benchmarking-1287","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"7,2/с"},"1473":{"id":"/docs/benchmarking-1288","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,09"},"1474":{"id":"/docs/benchmarking-1289","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"8,2 %"},"1475":{"id":"/docs/benchmarking-1290","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"0,42 мс"},"1476":{"id":"/docs/benchmarking-1291","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"0,85"},"1477":{"id":"/docs/benchmarking-1292","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"5,47"},"1478":{"id":"/docs/benchmarking-1293","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"`random`, прогон 1"},"1479":{"id":"/docs/benchmarking-1294","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"7,2/с"},"1480":{"id":"/docs/benchmarking-1295","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**1,00**"},"1481":{"id":"/docs/benchmarking-1296","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**0 %**"},"1482":{"id":"/docs/benchmarking-1297","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"0,56 мс"},"1483":{"id":"/docs/benchmarking-1298","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,13"},"1484":{"id":"/docs/benchmarking-1299","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,91"},"1485":{"id":"/docs/benchmarking-1300","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"`random`, прогон 2"},"1486":{"id":"/docs/benchmarking-1301","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"7,2/с"},"1487":{"id":"/docs/benchmarking-1302","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**1,00**"},"1488":{"id":"/docs/benchmarking-1303","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**0 %**"},"1489":{"id":"/docs/benchmarking-1304","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"0,51 мс"},"1490":{"id":"/docs/benchmarking-1305","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"1,37"},"1491":{"id":"/docs/benchmarking-1306","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"2,94"},"1492":{"id":"/docs/benchmarking-1307","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**Круг стоит полмиллисекунды.** Это не то, чем очередь дорога."},"1493":{"id":"/docs/benchmarking-1308","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"**Дорога она столкновениями, и однострочная правка их убирает.** Брать первую доступную задачу —\nочевидный выбор: все свободные воркеры видят одну и ту же голову очереди и пишут заявки\nодновременно. Брать случайную из доступных — то же самое количество кода, и на трёх воркерах\nс заделом столкновений не остаётся вовсе, а пропускная выходит на потолок."},"1494":{"id":"/docs/benchmarking-1309","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#201-три-воркера-задел-в-очереди","content":"`random` воспроизводится точно (1,00 и 0 % оба раза), `first` гуляет между 8 % и 27 % — доля\nстолкновений у него зависит от того, как легли фазы."},"1495":{"id":"/docs/benchmarking-1310","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#202-что-оказалось-измерением-режима-а-не-протокола","content":"Первые прогоны давали 62 % и 91 % потерь, и это было правдой про **другой режим**. Задачи шли\nраз в 700 мс на три (и на тридцать) воркеров — очередь пуста, доступная задача обычно одна,\nи все бросаются на неё. Доля потерь тогда описывает **отношение прихода задач к числу воркеров**,\nа не протокол."},"1496":{"id":"/docs/benchmarking-1311","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#202-что-оказалось-измерением-режима-а-не-протокола","content":"Отсюда же следствие: `random` в пустой очереди не помогает и не может — выбор случайного элемента\nиз списка длины один это `first`."},"1497":{"id":"/docs/benchmarking-1312","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#203-тридцать-воркеров--не-измерено-и-вот-доказательство","content":"Прогон с `--scale worker=30` на этом стенде дал **0 задач за 60 секунд** и p50 в 198 мс. Это\nне свойство протокола: 31 контейнер на ноутбуке в виртуалке — не стенд для вопроса о конкуренции.\nСтрока остаётся незаполненной до арендованной пары (M-105)."},"1498":{"id":"/docs/benchmarking-1313","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"Четыре поломки, все — в измерителе, и все найдены тем, что число выглядело невозможным."},"1499":{"id":"/docs/benchmarking-1314","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"**Паблишер молчал.** Первые прогоны шли на клиенте `0.1.2`, где аккумулятор терял запись,\nесли таймер сброса срабатывал в момент её прихода. Публикация задач вставала после первой,\nа события шли. Это оказался настоящий дефект клиента — тот же, что проект уже находил\nи чинил на серверной стороне (`PartitionWriter.awaitCommand`), — и он исправлен в `0.1.3`."},"1500":{"id":"/docs/benchmarking-1315","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"**Два прогона разной длины.** Сравнивались «сколько накопилось», а поднять 31 контейнер\nв первый раз дольше, чем во второй: вышло 1 задача против 1711. Отсюда окно и два снимка."},"1501":{"id":"/docs/benchmarking-1316","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"**Отрицательное число потерь.** `попытки − завершённые` не является числом проигравших:\nзадача, взятая до окна и завершённая внутри, попадает в один счётчик и не попадает в другой.\nСчитать надо выигравшие заявки, и это видно прямо при проигрывании лога."},"1502":{"id":"/docs/benchmarking-1317","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"**Перепутанные поля.** `grep` отдаёт строки в порядке файла, а отчёт печатает попытки выше\nпобед — два числа приехали местами, и потери снова вышли отрицательными. Теперь каждое поле\nберётся по имени, а измеритель **отказывается печатать** результат, где побед больше, чем\nпопыток."},"1503":{"id":"/docs/benchmarking-1318","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#204-что-стоило-этому-замеру","content":"Общее у всех четырёх: невозможное число видно сразу, если его напечатать. Три из четырёх поймало\nне рассуждение, а то, что на экране стояло `-26`."},"1504":{"id":"/docs/benchmarking-1319","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"Замер 18.2 объявил числа 240 и 514 невоспроизводимыми — «неоткуда взять», потому что база плюс\nдистрибутив дают 176. &#x2A;*Это неверно, и проверено на том самом хосте, где числа снимались.**"},"1505":{"id":"/docs/benchmarking-1320","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"Тот же `Dockerfile`, тот же тег базы, та же архитектура amd64, WSL-машина (20 ядер, Docker 29.1.3):"},"1506":{"id":"/docs/benchmarking-1321","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"`docker images` на WSL"},"1507":{"id":"/docs/benchmarking-1322","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"`docker images` на маке"},"1508":{"id":"/docs/benchmarking-1323","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"`docker image inspect .Size` на WSL"},"1509":{"id":"/docs/benchmarking-1324","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"`bellsoft/liberica-openjre-alpine:25` + дистрибутив"},"1510":{"id":"/docs/benchmarking-1325","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**240 МБ**"},"1511":{"id":"/docs/benchmarking-1326","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"176 МБ"},"1512":{"id":"/docs/benchmarking-1327","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"62 МБ"},"1513":{"id":"/docs/benchmarking-1328","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"`eclipse-temurin:25-jre` + дистрибутив"},"1514":{"id":"/docs/benchmarking-1329","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**514 МБ**"},"1515":{"id":"/docs/benchmarking-1330","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"364 МБ"},"1516":{"id":"/docs/benchmarking-1331","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"—"},"1517":{"id":"/docs/benchmarking-1332","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"отношение"},"1518":{"id":"/docs/benchmarking-1333","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"2,14×"},"1519":{"id":"/docs/benchmarking-1334","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"2,07×"},"1520":{"id":"/docs/benchmarking-1335","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"Исходная пара воспроизвелась **до мегабайта**. Ошибка была не в ней, а в моём предположении, что\nразмер образа — величина, сравнимая между хостами. Он таковой не является: `docker images` и\n`docker image inspect` на одной и той же машине расходятся втрое (240 против 62 — второе\nэто суммарный размер сжатых слоёв, то есть то, что качается), а между хостами расходится и то,\nчто печатает `docker images`."},"1521":{"id":"/docs/benchmarking-1336","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**Что в силе:** отношение 2,07–2,14× — оно устойчиво и на нём держится решение Р9."},"1522":{"id":"/docs/benchmarking-1337","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**Что отзывается — вывод 18.2, а не 18.1.** Числа 240/514 возвращаются как корректные для Linux;\nчисла 176/364 остаются корректными для Docker Desktop. Ни одна пара не «правильнее», и обе\nбесполезны без имени хоста рядом."},"1523":{"id":"/docs/benchmarking-1338","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**Как это вышло.** Я увидел расхождение, построил правдоподобное объяснение («база плюс дистрибутив\nстолько не дают»), проверил базу **на том же хосте, где считал**, и не проверил на том, откуда\nпришло исходное число. Ровно то, о чём написан замер 19, — только в обратную сторону: там я поверил\nузкому доверительному интервалу, здесь — арифметике, сошедшейся на одной машине из двух."},"1524":{"id":"/docs/benchmarking-1339","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#183-отзыв-отзыва-пара-240514-верна-а-мегабайты-непереносимы","content":"**Правило, которое из этого следует:** размер образа записывается **с именем хоста и командой**,\nкоторой он получен, или не записывается вовсе. Полезнее всего для README сжатый размер — это то,\nчто человек скачает, и он от хоста не зависит."},"1525":{"id":"/docs/benchmarking-1340","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-21-m-105-очередь-при-тридцати-воркерах","content":"Открытый вопрос замера 20: доля столкновений при тридцати воркерах. На ноутбуке он не разрешался\n(0 задач за 60 с), и был отложен до машины посильнее."},"1526":{"id":"/docs/benchmarking-1341","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-21-m-105-очередь-при-тридцати-воркерах","content":"**Стенд.** Linux, 20 ядер, 23 ГиБ, только что перезагружена; брокер — опубликованный образ\n`ghcr.io/youndie/booblik:0.1.0`. Соседи на машине есть и названы: четыре простаивающих контейнера\nMongoDB чужого проекта, суммарно \\~6 % одного ядра. **Всё на одной машине**, поэтому записывается\nтолько отношение: воркеры делят процессор с брокером, а M-37 измерила, чего это стоит по задержке\n(9,2×). Абсолютные задержки из этих прогонов не приводятся вовсе."},"1527":{"id":"/docs/benchmarking-1342","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-21-m-105-очередь-при-тридцати-воркерах","content":"Задачи каждые 10 мс (100/с), работа над задачей 400 мс, окно 60 с. Потолок арифметический:\n30 / 0,4 с = 75 задач/с."},"1528":{"id":"/docs/benchmarking-1343","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"Порядок"},"1529":{"id":"/docs/benchmarking-1344","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"Стратегия"},"1530":{"id":"/docs/benchmarking-1345","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"Пропускная"},"1531":{"id":"/docs/benchmarking-1346","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"Попыток на задачу"},"1532":{"id":"/docs/benchmarking-1347","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"Потеряно"},"1533":{"id":"/docs/benchmarking-1348","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"1"},"1534":{"id":"/docs/benchmarking-1349","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"`first`"},"1535":{"id":"/docs/benchmarking-1350","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"73,6/с"},"1536":{"id":"/docs/benchmarking-1351","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"1,04"},"1537":{"id":"/docs/benchmarking-1352","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"3,7 %"},"1538":{"id":"/docs/benchmarking-1353","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"1"},"1539":{"id":"/docs/benchmarking-1354","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"`random`"},"1540":{"id":"/docs/benchmarking-1355","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"73,7/с"},"1541":{"id":"/docs/benchmarking-1356","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"**1,00**"},"1542":{"id":"/docs/benchmarking-1357","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"**0,2 %**"},"1543":{"id":"/docs/benchmarking-1358","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"2 (обратный)"},"1544":{"id":"/docs/benchmarking-1359","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"`random`"},"1545":{"id":"/docs/benchmarking-1360","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"73,5/с"},"1546":{"id":"/docs/benchmarking-1361","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"**1,00**"},"1547":{"id":"/docs/benchmarking-1362","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"**0,2 %**"},"1548":{"id":"/docs/benchmarking-1363","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"2 (обратный)"},"1549":{"id":"/docs/benchmarking-1364","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"`first`"},"1550":{"id":"/docs/benchmarking-1365","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"73,6/с"},"1551":{"id":"/docs/benchmarking-1366","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"1,02"},"1552":{"id":"/docs/benchmarking-1367","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"1,6 %"},"1553":{"id":"/docs/benchmarking-1368","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#211-две-пары-подряд-вторая-в-обратном-порядке","content":"`random` воспроизводится **точно**: 1,00 попытки на задачу и 0,2 % в обоих прогонах. `first` гуляет\nмежду 1,6 % и 3,7 %, но всегда хуже. Обратный порядок нужен был не для симметрии: в первой паре\n`first` стартовал при load 0,59, а `random` при 2,22, и объяснение «дело в стартовой нагрузке»\nнадо было исключить. Во второй паре `first` шёл при **более высокой** нагрузке (5,59 против 4,56)\nи дал **лучшее** число — значит направление задаёт не нагрузка."},"1554":{"id":"/docs/benchmarking-1369","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"В комментарии к коду воркера было записано: «каждый простаивающий воркер видит одну и ту же задачу\nв голове очереди, поэтому попыток на задачу растёт **к числу воркеров**»."},"1555":{"id":"/docs/benchmarking-1370","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"При тридцати воркерах с заделом попыток на задачу — **1,04**, а не тридцать. Больше того,\nстолкновений стало **меньше**, чем на трёх:"},"1556":{"id":"/docs/benchmarking-1371","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"Воркеров"},"1557":{"id":"/docs/benchmarking-1372","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"Режим"},"1558":{"id":"/docs/benchmarking-1373","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"`first`, потеряно"},"1559":{"id":"/docs/benchmarking-1374","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"`random`, потеряно"},"1560":{"id":"/docs/benchmarking-1375","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"3"},"1561":{"id":"/docs/benchmarking-1376","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"очередь пуста"},"1562":{"id":"/docs/benchmarking-1377","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"62 %"},"1563":{"id":"/docs/benchmarking-1378","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"(не помогает)"},"1564":{"id":"/docs/benchmarking-1379","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"3"},"1565":{"id":"/docs/benchmarking-1380","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"задел"},"1566":{"id":"/docs/benchmarking-1381","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"8–27 %"},"1567":{"id":"/docs/benchmarking-1382","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"0 %"},"1568":{"id":"/docs/benchmarking-1383","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"30"},"1569":{"id":"/docs/benchmarking-1384","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"задел"},"1570":{"id":"/docs/benchmarking-1385","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"**1,6–3,7 %**"},"1571":{"id":"/docs/benchmarking-1386","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"**0,2 %**"},"1572":{"id":"/docs/benchmarking-1387","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"Механизм, судя по числам, обратный написанному: **работа расфазирует воркеров**. При четырёхстах\nмиллисекундах на задачу тридцать воркеров освобождаются в разные моменты и смотрят в голову очереди\nпоодиночке. Столкновения возникают там, где воркеры **синхронны**, — а синхронны они, когда\nпростаивают и разом просыпаются на приходящую задачу. Это же объясняет 62 % на пустой очереди\nи три воркера, попадающие в такт чаще тридцати."},"1573":{"id":"/docs/benchmarking-1388","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#212-предсказание-не-подтвердилось-и-это-главное-здесь","content":"Комментарий в коде исправлен по факту."},"1574":{"id":"/docs/benchmarking-1389","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#213-чего-столкновения-стоят-а-чего-нет","content":"На тридцати воркерах пропускная **одинакова** во всех четырёх прогонах (73,5–73,7/с) и равна\nарифметическому потолку. То есть на этом масштабе проигранные заявки стоят **попыток, а не\nпропускной способности**: система упирается в работу, а не в лог."},"1575":{"id":"/docs/benchmarking-1390","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#213-чего-столкновения-стоят-а-чего-нет","content":"На трёх воркерах было иначе — там `first` давал 6,6/с против 7,2/с у `random`, то есть терялось\n8 % потолка. Разница в том, что три воркера при 400 мс работы дают потолок 7,5/с, и круг по логу\nзанимает в их бюджете заметную долю."},"1576":{"id":"/docs/benchmarking-1391","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#213-чего-столкновения-стоят-а-чего-нет","content":"**Вывод для образца остаётся прежним, но по другой причине.** Умолчание `random` оправдано: оно\nдаёт 1,00 попытки на задачу при любом из проверенных масштабов и не стоит ничего. А вот пугать\nростом столкновений с числом воркеров — неправильно, и это утверждение отозвано."},"1577":{"id":"/docs/benchmarking-1392","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-22-m-120-окно-группового-коммита","content":"Открытый вопрос 3 ресёрча: стоит ли держать группу открытой несколько миллисекунд, чтобы в неё\nуспело набиться больше участников. Гипотеза была записана заранее: **при 64 продюсерах выигрыш\nбудет небольшим** (группы и так крупные), **а при 2–4 — заметным**."},"1578":{"id":"/docs/benchmarking-1393","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-22-m-120-окно-группового-коммита","content":"**Стенд.** Linux, 20 ядер, JMH, 5 прогревов + 10 итераций, обе оси в одном прогоне.\n`GroupCommitBenchmark`, `FORCED`, одна запись на продюсера; счёт — **инвокаций** в секунду, где\nинвокация это `producers` одновременных долговечных записей."},"1579":{"id":"/docs/benchmarking-1394","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"Коммитов в секунду, `groupWindowMillis` 0 против 2:"},"1580":{"id":"/docs/benchmarking-1395","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"Продюсеров"},"1581":{"id":"/docs/benchmarking-1396","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"`FILE_CHANNEL` 0"},"1582":{"id":"/docs/benchmarking-1397","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"2"},"1583":{"id":"/docs/benchmarking-1398","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"`MAPPED` 0"},"1584":{"id":"/docs/benchmarking-1399","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"2"},"1585":{"id":"/docs/benchmarking-1400","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-окно-проигрывает-везде","content":"1"},"1586":{"id":"/docs/benchmarking-1401","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#221-