 in `client.py:25-29`, the mapping of verbs to actions is as follows:"},"3990":{"id":"/wiki/booblik-conformance/the-conformance-client-10","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"Verb"},"3991":{"id":"/wiki/booblik-conformance/the-conformance-client-11","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"Arguments"},"3992":{"id":"/wiki/booblik-conformance/the-conformance-client-12","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"Expected Answers"},"3993":{"id":"/wiki/booblik-conformance/the-conformance-client-13","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`capabilities`"},"3994":{"id":"/wiki/booblik-conformance/the-conformance-client-14","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"—"},"3995":{"id":"/wiki/booblik-conformance/the-conformance-client-15","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`roles=...`, `name=...`"},"3996":{"id":"/wiki/booblik-conformance/the-conformance-client-16","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`metadata`"},"3997":{"id":"/wiki/booblik-conformance/the-conformance-client-17","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`<topic>`"},"3998":{"id":"/wiki/booblik-conformance/the-conformance-client-18","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`partition=<id> <logStartOffset> <highWatermark>`"},"3999":{"id":"/wiki/booblik-conformance/the-conformance-client-19","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`produce`"},"4000":{"id":"/wiki/booblik-conformance/the-conformance-client-20","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`<topic> <partition> <ack> <hex>[,<hex>…]`"},"4001":{"id":"/wiki/booblik-conformance/the-conformance-client-21","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`baseOffset=`, `logEndOffset=`"},"4002":{"id":"/wiki/booblik-conformance/the-conformance-client-22","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`produce-keyed`"},"4003":{"id":"/wiki/booblik-conformance/the-conformance-client-23","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`<topic> <keyHex> <payloadHex>`"},"4004":{"id":"/wiki/booblik-conformance/the-conformance-client-24","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`partition=`, `baseOffset=`"},"4005":{"id":"/wiki/booblik-conformance/the-conformance-client-25","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`fetch`"},"4006":{"id":"/wiki/booblik-conformance/the-conformance-client-26","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`<topic> <partition> <offset> <maxBytes>`"},"4007":{"id":"/wiki/booblik-conformance/the-conformance-client-27","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-cli-verb-interface","content":"`highWatermark=`, `record=<hex>`"},"4008":{"id":"/wiki/booblik-conformance/the-conformance-client-28","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-capabilities-declaration","content":"Before testing logic, the harness calls the `capabilities` verb to understand what the client is capable of. According to `Main.kt:43-46`, the client must declare its roles (such as `producer` or `consumer`) and its name. The harness uses this to decide whether to skip certain checks, such as `fetch` for a producer-only client (`client.py:39`)."},"4009":{"id":"/wiki/booblik-conformance/the-conformance-client-29","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-produce-and-produce-keyed-mechanics","content":"There is a critical distinction between standard production and keyed production:"},"4010":{"id":"/wiki/booblik-conformance/the-conformance-client-30","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-produce-and-produce-keyed-mechanics","content":"**Standard `produce`**: The caller specifies the partition directly. If `ack=none` is used, the client must return immediately without reading a response (`Main.kt:124-126`)."},"4011":{"id":"/wiki/booblik-conformance/the-conformance-client-31","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-produce-and-produce-keyed-mechanics","content":"**`produce-keyed`**: The client is responsible for selecting the partition. The client must first fetch metadata to discover available partitions and then use a partitioner to select one based on the key (`Main.kt:154-158`)."},"4012":{"id":"/wiki/booblik-conformance/the-conformance-client-32","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#the-fetch-and-truncated-edge-case","content":"When fetching data, the client must handle cases where the response is incomplete. If a record is larger than the `maxBytes` requested, the broker may return a truncated response. In this scenario, the client must report the `truncatedRecordBytes` and the `highWatermark` (`Main.kt:182-183`). This prevents the caller from misinterpreting a partial record as the end of the log."},"4013":{"id":"/wiki/booblik-conformance/the-conformance-client-33","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#exit-codes-and-error-reporting","content":"The contract distinguishes between protocol-level errors and client-level failures:"},"4014":{"id":"/wiki/booblik-conformance/the-conformance-client-34","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#exit-codes-and-error-reporting","content":"**Protocol Errors**: If the broker refuses a request (e.g., `UNKNOWN_TOPIC_OR_PARTITION`), the client must report this via `stdout` using the format `error=CODE` and exit with code `0` (`Main.kt:96`)."},"4015":{"id":"/wiki/booblik-conformance/the-conformance-client-35","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#exit-codes-and-error-reporting","content":"**Client Failures**: Any exception that is not a protocol error (such as a network failure or a crash) results in a non-zero exit code and a diagnostic message on `stderr` (`Main.kt:85-86`)."},"4016":{"id":"/wiki/booblik-conformance/the-conformance-client-36","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"File"},"4017":{"id":"/wiki/booblik-conformance/the-conformance-client-37","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"Lines"},"4018":{"id":"/wiki/booblik-conformance/the-conformance-client-38","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"What is there"},"4019":{"id":"/wiki/booblik-conformance/the-conformance-client-39","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"`…/conformance/Main.kt`"},"4020":{"id":"/wiki/booblik-conformance/the-conformance-client-40","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"`37-88`"},"4021":{"id":"/wiki/booblik-conformance/the-conformance-client-41","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"The `main` entry point and verb dispatching logic."},"4022":{"id":"/wiki/booblik-conformance/the-conformance-client-42","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"`…/harness/client.py`"},"4023":{"id":"/wiki/booblik-conformance/the-conformance-client-43","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"`51-98`"},"4024":{"id":"/wiki/booblik-conformance/the-conformance-client-44","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#key-files","content":"The Python `Client` class used by the harness to drive the CLI."},"4025":{"id":"/wiki/booblik-conformance/the-conformance-client-45","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#behaviour-that-surprises","content":"**Immediate Return on `none`**: In the `produce` function, if the `AckPolicy` is `NONE`, the client must not attempt to read a response from the socket, as the broker will not send one (`Main.kt:124-126`)."},"4026":{"id":"/wiki/booblik-conformance/the-conformance-client-46","page_id":"/wiki/booblik-conformance/the-conformance-client","tags":[],"type":"text","url":"/wiki/booblik-conformance/the-conformance-client#behaviour-that-surprises","content":"**Metadata-Driven Partitioning**: In `produceKeyed`, the client must not rely on a hardcoded partition count; it must fetch the actual partition list from the broker via `sendMetadata` to ensure the `Partitioner.Fnv1a` logic matches the broker's view (`Main.kt:149-157`)."},"4027":{"id":"/wiki/booblik-native-conformance","page_id":"/wiki/booblik-native-conformance","type":"page","content":"booblik-native-conformance","breadcrumbs":["Docs","Wiki","booblik-native-conformance"],"tags":[],"url":"/wiki/booblik-native-conformance"},"4028":{"id":"/wiki/booblik-native-conformance-0","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#diagram","content":"Diagram"},"4029":{"id":"/wiki/booblik-native-conformance-1","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-conformance-executable","content":"The conformance executable"},"4030":{"id":"/wiki/booblik-native-conformance-2","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"The conformance verb interface"},"4031":{"id":"/wiki/booblik-native-conformance-3","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-probe-performance-measurement","content":"The probe performance measurement"},"4032":{"id":"/wiki/booblik-native-conformance-4","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-direct-mode","content":"The DIRECT mode"},"4033":{"id":"/wiki/booblik-native-conformance-5","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-batched-mode","content":"The BATCHED mode"},"4034":{"id":"/wiki/booblik-native-conformance-6","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#the-batched_not_awaited-mode","content":"The BATCHED_NOT_AWAITED mode"},"4035":{"id":"/wiki/booblik-native-conformance-7","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#key-files","content":"Key files"},"4036":{"id":"/wiki/booblik-native-conformance-8","page_id":"/wiki/booblik-native-conformance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance#behaviour-that-surprise","content":"Behaviour that surprise"},"4037":{"id":"/wiki/booblik-native-conformance-9","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 3. Edit the code or the hand-written documentation instead."},"4038":{"id":"/wiki/booblik-native-conformance-10","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-executable","content":"The `booblik-native-conformance` module serves as a test harness for the Kotlin/Native client, designed to verify the protocol implementation against a real broker. As specified in `build.gradle.kts:18-32`, the module defines two distinct Kotlin/Native binaries: a `conformance` executable and a `probe` executable, both targeting `linuxX64` and `macosArm64`."},"4039":{"id":"/wiki/booblik-native-conformance-11","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-executable","content":"More: The conformance executable"},"4040":{"id":"/wiki/booblik-native-conformance-12","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"The `conformance` executable provides a command-line interface to exercise specific protocol operations. According to `Main.kt:47-68`, the available verbs are:"},"4041":{"id":"/wiki/booblik-native-conformance-13","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Verb"},"4042":{"id":"/wiki/booblik-native-conformance-14","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Description"},"4043":{"id":"/wiki/booblik-native-conformance-15","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"`metadata`"},"4044":{"id":"/wiki/booblik-native-conformance-16","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Retrieves topic metadata, including partition offsets (`Main.kt:73-86`)."},"4045":{"id":"/wiki/booblik-native-conformance-17","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"`produce`"},"4046":{"id":"/wiki/booblik-native-conformance-18","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Sends records to a specific partition with a chosen `AckPolicy` (`Main.kt:89-115`)."},"4047":{"id":"/wiki/booblik-native-conformance-19","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"`produce-keyed`"},"4048":{"id":"/wiki/booblik-native-conformance-20","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Uses a partitioner to select a partition based on a key before producing (`Main.kt:121-135`)."},"4049":{"id":"/wiki/booblik-native-conformance-21","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"`fetch`"},"4050":{"id":"/wiki/booblik-native-conformance-22","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"Retrieves records from a partition at a specific offset (`Main.kt:143-164`)."},"4051":{"id":"/wiki/booblik-native-conformance-23","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-conformance-verb-interface","content":"More: The conformance verb interface"},"4052":{"id":"/wiki/booblik-native-conformance-24","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-probe-performance-measurement","content":"The `probe` executable is used to measure the throughput of the native client under different concurrency models. As implemented in `Probe.kt:65-75`, the benchmark compares throughput (records per second) across different numbers of callers (1, 8, and 64) to determine the efficiency of the accumulator."},"4053":{"id":"/wiki/booblik-native-conformance-25","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-probe-performance-measurement","content":"More: The probe performance measurement"},"4054":{"id":"/wiki/booblik-native-conformance-26","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-direct-mode","content":"In `DIRECT` mode, the system operates without an accumulator. As described in `Probe.kt:79-80`, each caller uses its own `BooblikConnection` and sends every record as its own request, awaiting the response before proceeding."},"4055":{"id":"/wiki/booblik-native-conformance-27","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-batched-mode","content":"The `BATCHED` mode utilizes an accumulator to group multiple records into a single request. According to `Probe.kt:82-83`, all callers share a single connection and a single accumulator, but they still await the result of each `send` operation before moving to the next record."},"4056":{"id":"/wiki/booblik-native-conformance-28","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#the-batched_not_awaited-mode","content":"This mode implements a pipelined approach to batching. As detailed in `Probe.kt:85-87`, multiple records are queued via `producer.send` without being immediately awaited, allowing the accumulator to build larger batches by overlapping requests."},"4057":{"id":"/wiki/booblik-native-conformance-29","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"File"},"4058":{"id":"/wiki/booblik-native-conformance-30","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"Lines"},"4059":{"id":"/wiki/booblik-native-conformance-31","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"What is there"},"4060":{"id":"/wiki/booblik-native-conformance-32","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`booblik-native-conformance/build.gradle.kts`"},"4061":{"id":"/wiki/booblik-native-conformance-33","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`18-32`"},"4062":{"id":"/wiki/booblik-native-conformance-34","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"Configuration of Kotlin/Native targets and binary entry points."},"4063":{"id":"/wiki/booblik-native-conformance-35","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`…/conformance/Main.kt`"},"4064":{"id":"/wiki/booblik-native-conformance-36","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`47-68`"},"4065":{"id":"/wiki/booblik-native-conformance-37","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"The main command-line dispatch logic for the conformance client."},"4066":{"id":"/wiki/booblik-native-conformance-38","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`…/conformance/Probe.kt`"},"4067":{"id":"/wiki/booblik-native-conformance-39","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"`79-87`"},"4068":{"id":"/wiki/booblik-native-conformance-40","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#key-files","content":"Definition of the different benchmarking modes."},"4069":{"id":"/wiki/booblik-native-conformance-41","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#behaviour-that-surprise","content":"The `conformance` executable's `main` function is designed to return exit code 0 even if the broker refuses a request, provided the refusal is a valid protocol result (`Main.kt:19-20`)."},"4070":{"id":"/wiki/booblik-native-conformance-42","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#behaviour-that-surprise","content":"In `BATCHED_NOT_AWAITED` mode, the `producer.send` calls are collected into a list and then `awaitAll` is called, which allows the `lingerMillis` window to fill by having more than one record in flight (`Probe.kt:140-145`)."},"4071":{"id":"/wiki/booblik-native-conformance-43","page_id":"/wiki/booblik-native-conformance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance#behaviour-that-surprise","content":"The `verify` function in the probe ensures that no two records are assigned the same `Offset` and that the total count of returned offsets matches the expected number of sent records (`Probe.kt:174-185`)."},"4072":{"id":"/wiki/booblik-native-conformance/the-conformance-executable","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"page","content":"The conformance executable","breadcrumbs":["Docs","Wiki","booblik-native-conformance"],"tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable"},"4073":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-0","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#diagram","content":"Diagram"},"4074":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-1","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-conformance-and-probe-binaries","content":"The `conformance` and `probe` binaries"},"4075":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-2","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"The `main` entry point and command verbs"},"4076":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-3","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-fetch-decoding-and-truncated-tail-edge-cases","content":"The `fetch` decoding and truncated tail edge cases"},"4077":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-4","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-produce-keyed-partitioner-exercise","content":"The `produce-keyed` partitioner exercise"},"4078":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-5","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-report-error-mechanism","content":"The `report` error mechanism"},"4079":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-6","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#the-hex-payload-encoding","content":"The `hex` payload encoding"},"4080":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-7","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"Key files"},"4081":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-8","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-executable#behaviour-that-surprises","content":"Behaviour that surprises"},"4082":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-9","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4083":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-10","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable","content":"The conformance executable is a specialized Kotlin/Native binary designed to validate the Booblik protocol implementation by acting as a driver for specific verbs. Unlike standard clients, it is a fixture used by the conformance harness to ensure the broker adheres to the wire specification, specifically targeting edge cases in decoding and error reporting."},"4084":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-11","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-conformance-and-probe-binaries","content":"The module is structured to produce two distinct executables to keep the library surface clean. As noted in `build.gradle.kts:8-11`, a Kotlin/Native binary is linked from the target's own compilation; placing an entry point in the library would pollute the published klib and its ABI dump. Consequently, the module defines two separate binaries: the standard `conformance` client and a `probe` binary used for measurement (`build.gradle.kts:26-31`)."},"4085":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-12","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"The lifecycle of a conformance run begins with a `capabilities` check, where the executable responds with its roles and name (`Main.kt:33-36`). If not checking capabilities, it retrieves the broker address from the `BOOBLIK_BROKER` environment variable (`Main.kt:40-44`) and dispatches one of the following verbs:"},"4086":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-13","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Verb"},"4087":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-14","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Description"},"4088":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-15","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"`metadata`"},"4089":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-16","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Retrieves topic and partition information (`Main.kt:48-50`)"},"4090":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-17","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"`produce`"},"4091":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-18","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Sends records with a specified `AckPolicy` (`Main.kt:52-54`)"},"4092":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-19","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"`produce-keyed`"},"4093":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-20","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Performs local partitioning before sending (`Main.kt:56-58`)"},"4094":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-21","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"`fetch`"},"4095":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-22","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-main-entry-point-and-command-verbs","content":"Requests records from a specific offset (`Main.kt:60-62`)"},"4096":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-23","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-fetch-decoding-and-truncated-tail-edge-cases","content":"The `fetch` implementation specifically tests the client's ability to handle partial data. It validates the `truncated` flag and `truncatedRecordBytes` when a record is larger than the `maxBytes` requested (`Main.kt:156-158`). This ensures the reader can distinguish between a state where they have caught up to the high watermark and a state where a record is simply too large to be fully read in one request."},"4097":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-24","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-produce-keyed-partitioner-exercise","content":"Because the broker does not see the key in the wire protocol, the client must perform the partitioning logic itself to ensure the data lands in the correct location. The `produceKeyed` verb uses `topic.partitionFor(key)` to determine the destination partition before calling the produce command (`Main.kt:128-130`)."},"4098":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-25","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-report-error-mechanism","content":"The executable distinguishes between a client-side failure and a broker-side refusal. A successful operation requires `ErrorCode.NONE` (`Main.kt:77`). If the broker returns an error, it is reported via `error=CODE` on stdout, but the process still exits with code 0 because the refusal is a valid protocol result (`Main.kt:19-20`). A non-zero exit code is reserved for actual program failures."},"4099":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-26","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#the-hex-payload-encoding","content":"To allow for raw data transmission via command line arguments, the client provides a helper to transform hex-encoded strings into `ByteArray` objects (`Main.kt:170-171`)."},"4100":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-27","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"File"},"4101":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-28","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"Lines"},"4102":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-29","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"What is there"},"4103":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-30","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"`booblik-native-conformance/build.gradle.kts`"},"4104":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-31","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"`18-32`"},"4105":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-32","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"Configuration for the Kotlin/Native targets and the two executable binaries."},"4106":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-33","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"`…/conformance/Main.kt`"},"4107":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-34","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"`27-68`"},"4108":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-35","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#key-files","content":"The `main` function and the command verb dispatch logic."},"4109":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-36","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#behaviour-that-surprises","content":"The `main` function uses `exitProcess(2)` for usage errors or missing environment variables, but returns a successful exit code even when the broker returns an `ErrorCode` (`booblik-native-conformance/src/nativeMain/kotlin/ru/workinprogress/booblik/native/conformance/Main.kt:30, 67`)."},"4110":{"id":"/wiki/booblik-native-conformance/the-conformance-executable-37","page_id":"/wiki/booblik-native-conformance/the-conformance-executable","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-executable#behaviour-that-surprises","content":"The `produceKeyed` function performs the partitioning logic locally using `topic.partitionFor` because the broker is unaware of the key used for partitioning (`Main.kt:128`)."},"4111":{"id":"/wiki/booblik-native-conformance/the-conformance-verb","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"page","content":"The conformance verb interface","breadcrumbs":["Docs","Wiki","booblik-native-conformance"],"tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb"},"4112":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-0","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#what-this-module-is-responsible-for","content":"What this module is responsible for"},"4113":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-1","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#diagram","content":"Diagram"},"4114":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-2","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#the-capabilities-verb","content":"The `capabilities` verb"},"4115":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-3","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#the-metadata-verb","content":"The `metadata` verb"},"4116":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-4","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"The `produce` and `produce-keyed` verbs"},"4117":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-5","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#the-fetch-verb-and-truncated-records","content":"The `fetch` verb and truncated records"},"4118":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-6","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#exit-codes-and-errorcode-reporting","content":"Exit codes and `ErrorCode` reporting"},"4119":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-7","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"Key files"},"4120":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-8","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-conformance-verb#behaviour-that-surprises","content":"Behaviour that surprises"},"4121":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-9","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4122":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-10","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#what-this-module-is-responsible-for","content":"The conformance verb interface provides a minimal, language-neutral command-line contract used to drive clients under test. It allows a harness to verify that a client implementation correctly implements the Booblik protocol by communicating via `stdin`/`stdout` and environment variables."},"4123":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-11","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-capabilities-verb","content":"The handshake begins with the `capabilities` verb, which allows the client to declare its supported roles and its identity to the harness. As seen in `Main.kt:33-36`, the client must output `roles=producer,consumer` and a `name` (e.g., `kotlin-native` or `python`). This allows the harness to determine which subsequent tests (like `fetch`) are valid for the specific client implementation."},"4124":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-12","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-metadata-verb","content":"The `metadata` verb is used to retrieve the current state of a topic. The client must report the status of each partition, specifically the partition ID, the `logStartOffset`, and the `highWatermark` (`Main.kt:79-84`). This is used to verify that the client can correctly interpret the broker's view of the log boundaries."},"4125":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-13","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"These verbs handle the submission of records. The `produce` verb supports different `AckPolicy` modes, which are mapped as follows:"},"4126":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-14","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"AckPolicy"},"4127":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-15","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"Description"},"4128":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-16","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"`none`"},"4129":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-17","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"No response expected; the client returns immediately (`Main.kt:98`)"},"4130":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-18","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"`written`"},"4131":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-19","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"Waits for the broker to acknowledge the write"},"4132":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-20","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"`forced`"},"4133":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-21","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"Waits for the broker to flush to disk"},"4134":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-22","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-produce-and-produce-keyed-verbs","content":"The `produce-keyed` verb specifically exercises the client-side partitioner. The client must use its own logic to determine the partition from the key via `partitionFor` before sending the request to the broker, as the broker does not see the key (`Main.kt:128`)."},"4135":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-23","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#the-fetch-verb-and-truncated-records","content":"The `fetch` verb tests the client's ability to consume records and handle edge cases in the response stream. The client must report the `highWatermark` and the hex-encoded records (`Main.kt:152-163`). A critical edge case involves truncated records: if a response contains no complete records but the `truncated` flag is set, the client must report `recordExceedsMaxBytes` to indicate that the next record is larger than the requested `maxBytes` (`Main.kt:156-158`)."},"4136":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-24","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#exit-codes-and-errorcode-reporting","content":"The interface maintains a strict distinction between client-side failures and broker-side refusals:"},"4137":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-25","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#exit-codes-and-errorcode-reporting","content":"**Exit 0**: The verb was carried out successfully. This includes cases where the broker refused the request (e.g., `error=UNKNOWN_TOPIC_OR_PARTITION`), which is considered a valid result of the operation (`client.py:18-19`)."},"4138":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-26","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#exit-codes-and-errorcode-reporting","content":"**Non-zero Exit**: The client itself encountered a failure (e.g., a crash or invalid arguments), which is considered an unexpected outcome by the harness (`client.py:19`)."},"4139":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-27","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"File"},"4140":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-28","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"Lines"},"4141":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-29","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"What is there"},"4142":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-30","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`…/conformance/Main.kt`"},"4143":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-31","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`27-68`"},"4144":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-32","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"The `main` entry point and verb dispatching logic for the Kotlin/Native client."},"4145":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-33","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`…/harness/client.py`"},"4146":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-34","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`51-94`"},"4147":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-35","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"The Python `Client` class that executes subprocesses and parses `key=value` stdout."},"4148":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-36","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`…/python/conformance.py`"},"4149":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-37","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"`20-53`"},"4150":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-38","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#key-files","content":"The Python implementation of the conformance client."},"4151":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-39","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#behaviour-that-surprises","content":"**Open-loop measurement**: In `LoadDriver.kt:162-164`, latency is measured from the moment a request was *due* according to a fixed schedule, rather than when it was actually sent. This prevents \"coordinated omission\" where a slow broker hides its own latency by slowing down the client's request rate."},"4152":{"id":"/wiki/booblik-native-conformance/the-conformance-verb-40","page_id":"/wiki/booblik-native-conformance/the-conformance-verb","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-conformance-verb#behaviour-that-surprises","content":"**Spin-tailing**: To achieve high precision without burning CPU, `parkNanos` in `LoadDriver.kt:234-240` uses a hybrid approach: it `parkNanos` for the bulk of the wait and then uses `Thread.onSpinWait()` for the final 50 microseconds."},"4153":{"id":"/wiki/booblik-native-conformance/the-probe-performance","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"page","content":"The probe performance measurement","breadcrumbs":["Docs","Wiki","booblik-native-conformance"],"tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance"},"4154":{"id":"/wiki/booblik-native-conformance/the-probe-performance-0","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#diagram","content":"Diagram"},"4155":{"id":"/wiki/booblik-native-conformance/the-probe-performance-1","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#the-probe-function","content":"The `probe` function"},"4156":{"id":"/wiki/booblik-native-conformance/the-probe-performance-2","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"The `Mode` enumeration"},"4157":{"id":"/wiki/booblik-native-conformance/the-probe-performance-3","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#the-verify-mechanism","content":"The `verify` mechanism"},"4158":{"id":"/wiki/booblik-native-conformance/the-probe-performance-4","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#the-subscriptionprobe-lifecycle","content":"The `SubscriptionProbe` lifecycle"},"4159":{"id":"/wiki/booblik-native-conformance/the-probe-performance-5","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#the-measurementdir-constraint","content":"The `MeasurementDir` constraint"},"4160":{"id":"/wiki/booblik-native-conformance/the-probe-performance-6","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"Key files"},"4161":{"id":"/wiki/booblik-native-conformance/the-probe-performance-7","page_id":"/wiki/booblik-native-conformance/the-probe-performance","type":"heading","tags":[],"url":"/wiki/booblik-native-conformance/the-probe-performance#behaviour-that-surprises","content":"Behaviour that surprises"},"4162":{"id":"/wiki/booblik-native-conformance/the-probe-performance-8","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4163":{"id":"/wiki/booblik-native-conformance/the-probe-performance-9","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-probe-function","content":"The entry point for manual performance verification, comparing different execution modes and scaling across multiple callers. It reads the broker address from the `BOOBLIK_BROKER` environment variable `Probe.kt:52-56` and iterates through a set of caller counts (1, 8, and 64) to measure throughput `Probe.kt:65-75`."},"4164":{"id":"/wiki/booblik-native-conformance/the-probe-performance-10","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"The three execution strategies: `DIRECT` (no accumulator), `BATCHED` (awaited), and `BATCHED_NOT_AWAITED` (pipelined)."},"4165":{"id":"/wiki/booblik-native-conformance/the-probe-performance-11","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"Mode"},"4166":{"id":"/wiki/booblik-native-conformance/the-probe-performance-12","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"Description"},"4167":{"id":"/wiki/booblik-native-conformance/the-probe-performance-13","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"`DIRECT`"},"4168":{"id":"/wiki/booblik-native-conformance/the-probe-performance-14","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"Every record itsown request, awaited before the next. What a caller without one does. `Probe.kt:79-81`"},"4169":{"id":"/wiki/booblik-native-conformance/the-probe-performance-15","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"`BATCHED`"},"4170":{"id":"/wiki/booblik-native-conformance/the-probe-performance-16","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"Through the accumulator, still awaited before the next — a request handler's pattern. `Probe.kt:83`"},"4171":{"id":"/wiki/booblik-native-conformance/the-probe-performance-17","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"`BATCHED_NOT_AWAITED`"},"4172":{"id":"/wiki/booblik-native-conformance/the-probe-performance-18","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-mode-enumeration","content":"Through the accumulator, awaited at the end. The case the accumulator exists for. `Probe.kt:86-92`"},"4173":{"id":"/wiki/booblik-native-conformance/the-probe-performance-19","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-verify-mechanism","content":"Integrity checks ensuring every record is accounted for and that all produced offsets are distinct. The `verify` function checks if the number of returned offsets matches the expected count and ensures no two records were given the same offset `Probe.kt:173-185`."},"4174":{"id":"/wiki/booblik-native-conformance/the-probe-performance-20","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-subscriptionprobe-lifecycle","content":"Measuring the cost of `IDLE` vs `THROUGHPUT` modes and the performance overhead of the `Flow` abstraction via `bare fetch loop`, `cold flow { }`, and `buffer()`. The probe measures the number of fetch requests answered by the server during a specific duration `SubscriptionProbe.kt:208-225` and compares three rungs of the `readThreeWays` ladder to isolate the cost of the `Flow` machinery and the decoupling provided by `buffer()` `SubscriptionProbe.kt:289-329`."},"4175":{"id":"/wiki/booblik-native-conformance/the-probe-performance-21","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#the-measurementdir-constraint","content":"The refusal to run measurements on volatile filesystems (like `tmpfs` or `ramfs`) to prevent measuring memory instead of disk. The `create` function checks the file store type and throws an `IllegalStateException` if the directory is on a volatile filesystem, as `fsync` is a no-op there `MeasurementDir.kt:39-48`."},"4176":{"id":"/wiki/booblik-native-conformance/the-probe-performance-22","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"File"},"4177":{"id":"/wiki/booblik-native-conformance/the-probe-performance-23","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"Lines"},"4178":{"id":"/wiki/booblik-native-conformance/the-probe-performance-24","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"What is there"},"4179":{"id":"/wiki/booblik-native-conformance/the-probe-performance-25","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`…/conformance/Probe.kt`"},"4180":{"id":"/wiki/booblik-native-conformance/the-probe-performance-26","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`65-75`"},"4181":{"id":"/wiki/booblik-native-conformance/the-probe-performance-27","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"The main loop iterating through different caller counts for benchmarking."},"4182":{"id":"/wiki/booblik-native-conformance/the-probe-performance-28","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`…/probe/SubscriptionProbe.kt`"},"4183":{"id":"/wiki/booblik-native-conformance/the-probe-performance-29","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`289-329`"},"4184":{"id":"/wiki/booblik-native-conformance/the-probe-performance-30","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"The implementation of the three-way comparison for Flow abstraction overhead."},"4185":{"id":"/wiki/booblik-native-conformance/the-probe-performance-31","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`…/benchmark/MeasurementDir.kt`"},"4186":{"id":"/wiki/booblik-native-conformance/the-probe-performance-32","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"`39-48`"},"4187":{"id":"/wiki/booblik-native-conformance/the-probe-performance-33","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#key-files","content":"Logic to prevent measurements on volatile filesystems like `tmpfs`."},"4188":{"id":"/wiki/booblik-native-conformance/the-probe-performance-34","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#behaviour-that-surprises","content":"The `SubscriptionProbe` can report that a `Flow` is faster than the loop it wraps if the comparison is not performed in sequence, because `callbackFlow` introduces real concurrency (decoupling) that a bare loop lacks `SubscriptionProbe.kt:272-277`."},"4189":{"id":"/wiki/booblik-native-conformance/the-probe-performance-35","page_id":"/wiki/booblik-native-conformance/the-probe-performance","tags":[],"type":"text","url":"/wiki/booblik-native-conformance/the-probe-performance#behaviour-that-surprises","content":"The `MeasurementDir` will actively refuse to run a test if it detects a `tmpfs` or `ramfs` filesystem to avoid reporting \"fiction\" numbers where `fsync` is a no-op `MeasurementDir.kt:32-48`."},"4190":{"id":"/wiki/booblik-protocol/ackpolicy","page_id":"/wiki/booblik-protocol/ackpolicy","type":"page","content":"AckPolicy","breadcrumbs":["Docs","Wiki","booblik-protocol"],"tags":[],"url":"/wiki/booblik-protocol/ackpolicy"},"4191":{"id":"/wiki/booblik-protocol/ackpolicy-0","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#what-this-module-is-responsible-for","content":"What this module is responsible for"},"4192":{"id":"/wiki/booblik-protocol/ackpolicy-1","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#diagram","content":"Diagram"},"4193":{"id":"/wiki/booblik-protocol/ackpolicy-2","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"AckPolicy modes"},"4194":{"id":"/wiki/booblik-protocol/ackpolicy-3","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#the-partitionwriter-write-loop-and-group-commit","content":"The PartitionWriter write loop and group commit"},"4195":{"id":"/wiki/booblik-protocol/ackpolicy-4","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#the-distinction-between-written-and-forced","content":"The distinction between WRITTEN and FORCED"},"4196":{"id":"/wiki/booblik-protocol/ackpolicy-5","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#ackpolicynone-and-the-fire-and-forget-mechanism","content":"AckPolicy.NONE and the fire-and-forget mechanism"},"4197":{"id":"/wiki/booblik-protocol/ackpolicy-6","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#verification-of-offset-continuity-and-batching","content":"Verification of offset continuity and batching"},"4198":{"id":"/wiki/booblik-protocol/ackpolicy-7","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#testing-group-commit-efficiency","content":"Testing group commit efficiency"},"4199":{"id":"/wiki/booblik-protocol/ackpolicy-8","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"Key files"},"4200":{"id":"/wiki/booblik-protocol/ackpolicy-9","page_id":"/wiki/booblik-protocol/ackpolicy","type":"heading","tags":[],"url":"/wiki/booblik-protocol/ackpolicy#behaviour-that-surprising","content":"Behaviour that surprising"},"4201":{"id":"/wiki/booblik-protocol/ackpolicy-10","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4202":{"id":"/wiki/booblik-protocol/ackpolicy-11","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#what-this-module-is-responsible-for","content":"The `AckPolicy` defines the durability contract between a producer and the broker. It determines how long a producer waits for an acknowledgement and what level of guarantee is provided regarding the persistence of the data. This policy is processed by the `PartitionWriter`, which manages the lifecycle of a write from the moment it enters the mailbox until it is either written to the log or flushed to disk."},"4203":{"id":"/wiki/booblik-protocol/ackpolicy-12","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"The durability promises are represented as a single byte on the wire and are defined in `AckPolicy.kt:21-25`:"},"4204":{"id":"/wiki/booblik-protocol/ackpolicy-13","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Mode"},"4205":{"id":"/wiki/booblik-protocol/ackpolicy-14","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Promise"},"4206":{"id":"/wiki/booblik-protocol/ackpolicy-15","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Durability Guarantee"},"4207":{"id":"/wiki/booblik-protocol/ackpolicy-16","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"`NONE`"},"4208":{"id":"/wiki/booblik-protocol/ackpolicy-17","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Promises nothing."},"4209":{"id":"/wiki/booblik-protocol/ackpolicy-18","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Fire-and-forget; no reply is sent to the producer."},"4210":{"id":"/wiki/booblik-protocol/ackpolicy-19","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"`WRITTEN`"},"4211":{"id":"/wiki/booblik-protocol/ackpolicy-20","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Bytes are in the log and offset is final."},"4212":{"id":"/wiki/booblik-protocol/ackpolicy-21","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"No disk barrier; data may be lost on power failure."},"4213":{"id":"/wiki/booblik-protocol/ackpolicy-22","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"`FORCED`"},"4214":{"id":"/wiki/booblik-protocol/ackpolicy-23","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"Data is durable."},"4215":{"id":"/wiki/booblik-protocol/ackpolicy-24","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicy-modes","content":"A disk barrier (`force`) is performed."},"4216":{"id":"/wiki/booblik-protocol/ackpolicy-25","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#the-partitionwriter-write-loop-and-group-commit","content":"The `PartitionWriter` uses an actor-like model where a single coroutine owns the write side of a partition. The `runLoop` function in `PartitionWriter.kt:163-196` implements a group commit mechanism. Instead of processing one message at a time, it takes the first command and then drains all other currently queued messages from the mailbox without suspending. This allows the writer to aggregate multiple `WriteCommand` objects into a single group, ensuring that if any command in the group requires a durability guarantee, the cost of the disk barrier is shared."},"4217":{"id":"/wiki/booblik-protocol/ackpolicy-26","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#the-distinction-between-written-and-forced","content":"The distinction lies in the execution of the disk barrier. As seen in `PartitionWriter.kt:178-184`, the writer iterates through the group and checks if any command's policy is `AckPolicy.FORCED`. If so, it triggers `flushNow()`, which calls `log.force()`. In contrast, `AckPolicy.WRITTEN` only ensures the bytes are appended to the log segment, and as verified in `PartitionWriterTest.kt:96-97`, it must not trigger a `force` operation."},"4218":{"id":"/wiki/booblik-protocol/ackpolicy-27","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#ackpolicynone-and-the-fire-and-forget-mechanism","content":"When `AckPolicy.NONE` is used, the `append` function in `PartitionWriter.kt:135-149` returns `null` immediately. This is because the offset is not known until the writer coroutine actually processes the batch in the `runLoop`. Because no `CompletableDeferred` is created for the acknowledgement, the producer receives no reply, making it a true fire-and-forget operation."},"4219":{"id":"/wiki/booblik-protocol/ackpolicy-28","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#verification-of-offset-continuity-and-batching","content":"The system ensures that offsets are assigned in a strict, gap-free sequence. Tests in `PartitionWriterTest.kt:45-55` verify that a batch of records results in a single base offset and that subsequent records follow consecutively. Furthermore, tests in `PartitionWriterTest.kt:129-155` confirm that even with many concurrent producers, the resulting offsets are unique and form a continuous range from `0` to `N`."},"4220":{"id":"/wiki/booblik-protocol/ackpolicy-29","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#testing-group-commit-efficiency","content":"The efficiency of the group commit is validated by simulating high contention. In `PartitionWriterTest.kt:105-126`, multiple producers send `FORCED` requests simultaneously. The test asserts that the number of actual `force` calls (disk barriers) is significantly lower than the number of producers, proving that the `PartitionWriter` successfully collapses multiple requests into a single barrier."},"4221":{"id":"/wiki/booblik-protocol/ackpolicy-30","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"File"},"4222":{"id":"/wiki/booblik-protocol/ackpolicy-31","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"Lines"},"4223":{"id":"/wiki/booblik-protocol/ackpolicy-32","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"What is there"},"4224":{"id":"/wiki/booblik-protocol/ackpolicy-33","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"`…/log/AckPolicy.kt`"},"4225":{"id":"/wiki/booblik-protocol/ackpolicy-34","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"`21-25`"},"4226":{"id":"/wiki/booblik-protocol/ackpolicy-35","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"The `AckPolicy` enum defining the three durability levels."},"4227":{"id":"/wiki/booblik-protocol/ackpolicy-36","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"`…/log/PartitionWriter.kt`"},"4228":{"id":"/wiki/booblik-protocol/ackpolicy-37","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"`163-196`"},"4229":{"id":"/wiki/booblik-protocol/ackpolicy-38","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-protocol/ackpolicy#key-files","content":"The `runLoop` implementation containing the group commit logic."},"4230":{"id":"/wiki/booblik-protocol/ackpolicy-39","page_id":"/wiki/booblik-protocol/ackpolicy","tags":[],"type":"text","url":"/wiki/booblik-