нт","content":"`MAPPED`"},"288":{"id":"/docs/benchmarking-130","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"1 КиБ"},"289":{"id":"/docs/benchmarking-131","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"1 854 553 ± 512 280 ⚠️"},"290":{"id":"/docs/benchmarking-132","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"4 574 411 ± 258 777 ⚠️"},"291":{"id":"/docs/benchmarking-133","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"на каждую запись"},"292":{"id":"/docs/benchmarking-134","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"`FILE_CHANNEL`"},"293":{"id":"/docs/benchmarking-135","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"64 Б"},"294":{"id":"/docs/benchmarking-136","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"257 ± 7"},"295":{"id":"/docs/benchmarking-137","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"254 ± 8"},"296":{"id":"/docs/benchmarking-138","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"на каждую запись"},"297":{"id":"/docs/benchmarking-139","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"`FILE_CHANNEL`"},"298":{"id":"/docs/benchmarking-140","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"1 КиБ"},"299":{"id":"/docs/benchmarking-141","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"245 ± 5"},"300":{"id":"/docs/benchmarking-142","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"249 ± 6"},"301":{"id":"/docs/benchmarking-143","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"на каждую запись"},"302":{"id":"/docs/benchmarking-144","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"`MAPPED`"},"303":{"id":"/docs/benchmarking-145","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"64 Б"},"304":{"id":"/docs/benchmarking-146","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"16 123 ± 4 069"},"305":{"id":"/docs/benchmarking-147","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"16 773 ± 3 923"},"306":{"id":"/docs/benchmarking-148","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"на каждую запись"},"307":{"id":"/docs/benchmarking-149","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"`MAPPED`"},"308":{"id":"/docs/benchmarking-150","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"1 КиБ"},"309":{"id":"/docs/benchmarking-151","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"4 135 ± 1 255"},"310":{"id":"/docs/benchmarking-152","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"4 725 ± 1 233"},"311":{"id":"/docs/benchmarking-153","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"**Профиль почти ничего не стоит — семь строк из восьми не отличаются за пределами погрешности.**\nЭто ожидаемо и всё же стоило проверки: горячий путь записи не аллоцирует в куче, поэтому ни\nразмер кучи, ни выбор сборщика мусора ему безразличны. `-Xmx64M` как рабочее ограничение для\nслоя хранения подтверждается."},"312":{"id":"/docs/benchmarking-154","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-1-m0-2026-08-10-запись-в-сегмент","content":"**Восьмая строка (⚠️) — не измерение записи, и её нельзя читать как «профиль замедлил втрое».**\nПри килобайтных записях маппинг выдаёт порядка 2–4,5 ГБ/с, то есть гигабайтный сегмент кончается\nза четверть секунды, и за двухсекундную итерацию происходит **до десяти переоткрытий** —\n`arena.close()` на гигабайтный маппинг, новый `map`, и гигабайт грязных страниц, с которым ядру\nнадо что-то делать. Меряется здесь именно это, а не `append`; отсюда и погрешность 28 % против\n3–8 % в остальных строках. Обе цифры в этой строке — мусор, просто разного размера.\nЧинится сокращением итерации (см. ниже), задача **M-26**."},"313":{"id":"/docs/benchmarking-155","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-из-этого-следует","content":"**Маппинг быстрее в 41 раз на 64-байтных записях, и драфт в этом был прав.** Но сравнение пока\nнечестное, и понятно почему, если перевести в наносекунды: `FILE_CHANNEL` — это 3,0 мкс на\nзапись, то есть ровно цена одного системного вызова `write`; `MAPPED` — 72 нс, то есть цена\n`memcpy` и ничего сверх. Мы сравниваем «системный вызов на каждую запись» с «записью в память».\nУ Kafka системного вызова на запись нет, потому что записи приходят батчами. **Честное сравнение\nбудет в M-14**, когда появится батчевая запись; ожидание — что разрыв схлопнется в разы, а не\nв десятки раз."},"314":{"id":"/docs/benchmarking-156","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-из-этого-следует","content":"На килобайтных записях сравнивать сейчас нечего: строка `MAPPED` там испорчена роллингом\nсегмента (см. ⚠️ выше)."},"315":{"id":"/docs/benchmarking-157","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-из-этого-следует","content":"**`fsync` стоит 3,9 мс и не зависит от размера записи.** 257 и 245 записей в секунду при\n64 байтах и при килобайте — это не пропускная способность, это частота барьеров. Отсюда прямое\nархитектурное следствие: политика `FORCED` на каждую запись не является рабочим режимом ни при\nкаких обстоятельствах; долговечность придётся покупать групповым сбросом раз в N записей или\nраз в T миллисекунд (задача M-12)."},"316":{"id":"/docs/benchmarking-158","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-из-этого-следует","content":"**А вот `msync` за 62 мкс — подозрительно дёшево, и это не победа.** 16 123 записи в секунду\nпротив 257 — разница в 63 раза между двумя вызовами, которые оба называются «сбрось на диск».\nПравдоподобное объяснение — что на APFS `msync` не даёт той же гарантии, что `fsync`.\nПока это не проверено (**M-24**), таблица выше **не является** аргументом в пользу того, чтобы\nсделать `MAPPED` умолчанием. Число, которое меряет более слабую гарантию, нельзя сравнивать\nс числом, которое меряет более сильную."},"317":{"id":"/docs/benchmarking-159","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-из-этого-следует","content":"**Разброс у `MAPPED` со сбросом — 25 %**, против 3–8 % у остальных строк. Это не шум измерения,\nа неравномерность writeback: страницы сбрасываются пачками, и итерация попадает то между\nпачками, то в них."},"318":{"id":"/docs/benchmarking-160","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-в-этом-замере-неправильно-и-это-надо-исправить-к-следующему","content":"**Сегмент переполняется прямо в итерации, и на килобайтных записях это съедает замер.** При\n13,9 млн записей в секунду по 68 байт за две секунды проходит около 1,9 ГБ — почти вдвое\nбольше гигабайтного сегмента, то есть пара переоткрытий за итерацию; на фоне миллионов вызовов\nэто доли процента. При килобайте всё иначе: до десяти переоткрытий, каждое — снятие и\nпостановка гигабайтного маппинга, и мерить `append` там уже не получается. Правильный ответ —\n**более короткая итерация**, а не сегмент побольше: ёмкость упирается в `Int.MAX_VALUE`\nу обоих путей."},"319":{"id":"/docs/benchmarking-161","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-в-этом-замере-неправильно-и-это-надо-исправить-к-следующему","content":"**Ещё важнее — что при этом переписываются уже грязные страницы.** Мы выдаём порядка гигабайта\nв секунду грязных страниц и обгоняем фоновый writeback ядра. На короткой дистанции это\nвыглядит как скорость RAM; на длинной начнётся деградация, и характер её у маппинга хуже —\nступенькой, а не плавно. Это риск 1 ресёрча, и проверяется он отдельной задачей **M-26**:\nпрогон на объёме заведомо большем свободной памяти."},"320":{"id":"/docs/benchmarking-162","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#что-в-этом-замере-неправильно-и-это-надо-исправить-к-следующему","content":"**`/tmp` на почти полном диске (94 %).** На APFS это не так больно, как на ext4, но\nфрагментация выделения при 13 ГБ свободного места — фактор, о котором честнее знать."},"321":{"id":"/docs/benchmarking-163","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#итог-для-решения-р1","content":"*(Ниже — итог замера 1, оставленный как есть: он показывает, на каком основании умолчание стояло\nна `FILE_CHANNEL` в начале. Актуальное решение — в конце документа.)*"},"322":{"id":"/docs/benchmarking-164","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#итог-для-решения-р1","content":"Умолчание `SegmentMode` остаётся `FILE_CHANNEL` — **не потому, что он быстрее**, а потому что\nтри вопроса ещё открыты: честное сравнение с батчами (M-14), эквивалентность гарантий `msync`\nи `fsync` (M-24) и поведение за пределами свободной памяти (M-26). Умолчание меняется по\nрезультатам, а не по этой таблице."},"323":{"id":"/docs/benchmarking-165","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#итог-для-решения-р1","content":"> **Замер 1 устарел в одной строке.** После M-24 выяснилось, что `msync` барьером долговечности\n> не является, и `MappedSegmentWriter.force()` теперь делает ещё и `fsync`. Строки со сбросом\n> в таблице выше описывают код, которого больше нет; актуальные — в замере 2. Строки без сброса\n> остаются в силе, кроме `MAPPED`/1 КиБ (⚠️), которую починил M-27."},"324":{"id":"/docs/benchmarking-166","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-2-m2-2026-08-10-всё-вместе-после-четырёх-исправлений","content":"**Хост и профиль** — те же, что в замере 1. Прогон: `mainBenchmark`, 5 прогревов + 10 итераций\nпо 2 с. Между замерами 1 и 2 поменялось четыре вещи, и три из них — в коде: `msync` дополнен\n`fsync` (M-24), восстановление забуферено (M-23), бенчмарк перестал мерить роллинг (M-27),\nи появился актор с батчами (M1)."},"325":{"id":"/docs/benchmarking-167","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"Сброс"},"326":{"id":"/docs/benchmarking-168","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"Режим"},"327":{"id":"/docs/benchmarking-169","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"Размер"},"328":{"id":"/docs/benchmarking-170","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"Записей в секунду"},"329":{"id":"/docs/benchmarking-171","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"Было в замере 1"},"330":{"id":"/docs/benchmarking-172","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"нет"},"331":{"id":"/docs/benchmarking-173","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`FILE_CHANNEL`"},"332":{"id":"/docs/benchmarking-174","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"64 Б"},"333":{"id":"/docs/benchmarking-175","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"213 859 ± 2 475"},"334":{"id":"/docs/benchmarking-176","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"335 984"},"335":{"id":"/docs/benchmarking-177","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"нет"},"336":{"id":"/docs/benchmarking-178","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/do