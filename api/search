ired for the broker to start. It implements a precedence rule where environment variables override properties files, which in turn override default values, as seen in the `load` function `BooblikConfig.kt:77-91`."},"3091":{"id":"/wiki/booblik-app-10","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"The configuration parameters are parsed as follows:"},"3092":{"id":"/wiki/booblik-app-11","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"Parameter"},"3093":{"id":"/wiki/booblik-app-12","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"Type"},"3094":{"id":"/wiki/booblik-app-13","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"Default / Source"},"3095":{"id":"/wiki/booblik-app-14","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`booblik.data.dir`"},"3096":{"id":"/wiki/booblik-app-15","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`Path`"},"3097":{"id":"/wiki/booblik-app-16","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`\"data\"`"},"3098":{"id":"/wiki/booblik-app-17","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`booblik.port`"},"3099":{"id":"/wiki/booblik-app-18","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`Int`"},"3100":{"id":"/wiki/booblik-app-19","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`9092`"},"3101":{"id":"/wiki/booblik-app-20","page_id":"/wiki/booblik-app","tags":[],"type":"text","url":"/wiki/booblik-app#booblikconfig","content":"`booblik.topics`"},"3102":{"id":"/wiki/booblik-app-21","page_id":