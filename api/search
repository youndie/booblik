arking","tags":[],"type":"text","url":"/docs/benchmarking#замер-3-m-26-минута-записи-а-не-две-секунды","content":"1,2×"},"452":{"id":"/docs/benchmarking-294","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-3-m-26-минута-записи-а-не-две-секунды","content":"Два вывода, и второй важнее первого:"},"453":{"id":"/docs/benchmarking-295","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-3-m-26-минута-записи-а-не-две-секунды","content":"**Короткий замер завышает маппинг в десять раз.** 8,88 млн записей в секунду в замере 2.1\nпротив 0,80 млн здесь. Свежий сегмент, пустой page cache и две секунды — самый выгодный\nдля маппинга случай из возможных."},"454":{"id":"/docs/benchmarking-296","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-3-m-26-минута-записи-а-не-две-секунды","content":"**Худшая секунда у маппинга хуже, чем у `FileChannel`.** 128 тыс против 204 тыс. Среднее\nу маппинга втрое выше, но очереди и таймауты в брокере считают по худшей секунде, а не по\nсредней. Разброс 15× означает, что планировать по среднему нельзя."},"455":{"id":"/docs/benchmarking-297","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-4-m-24-msync-и-fsync--не-одно-и-то-же","content":"`DurabilityProbe`, 32 МиБ грязных страниц на раунд, медиана 9 раундов. Полная таблица и метод —\nресёрч §1.9. Короткий ответ: после `msync` последующий\n`fsync` стоит &#x2A;*92 % от голого `fsync`** — то есть работа не была сделана. На одинаковом объёме\nданных `msync` вдобавок **дороже** (16,45 мс против 9,33 мс)."},"456":{"id":"/docs/benchmarking-298","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"`StartupProbe`, 256 МиБ лога в 16 сегментах."},"457":{"id":"/docs/benchmarking-299","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"Вариант чтения"},"458":{"id":"/docs/benchmarking-300","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"Скорость"},"459":{"id":"/docs/benchmarking-301","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"На гигабайт лога"},"460":{"id":"/docs/benchmarking-302","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"`read` на запись"},"461":{"id":"/docs/benchmarking-303","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"174 МиБ/с"},"462":{"id":"/docs/benchmarking-304","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"5,9 с"},"463":{"id":"/docs/benchmarking-305","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"буфер 1 МиБ"},"464":{"id":"/docs/benchmarking-306","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"**4 900 МиБ/с**"},"465":{"id":"/docs/benchmarking-307","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"**0,21 с**"},"466":{"id":"/docs/benchmarking-308","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-5-m-23-скорость-восстановления","content":"Оба режима записи восстанавливаются одинаково. Открытый вопрос 1 ресёрча — нужен ли индексный\nфайл — закрыт: не нужен, лог на 100 ГиБ открывается за \\~21 с."},"467":{"id":"/docs/benchmarking-309","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"`probeLoad`, 8 соединений, конвейеризация, **открытый цикл** — задержка считается от момента,\nкогда запрос был **должен** уйти, а не когда ушёл. Записи по 128 Б, батчи по 10, `WRITTEN`,\nтранспорт `SELECTOR`, 15 с на точку."},"468":{"id":"/docs/benchmarking-310","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"Цель, зап/с"},"469":{"id":"/docs/benchmarking-311","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"Достигнуто"},"470":{"id":"/docs/benchmarking-312","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"Записей/с"},"471":{"id":"/docs/benchmarking-313","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"p50"},"472":{"id":"/docs/benchmarking-314","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"p99"},"473":{"id":"/docs/benchmarking-315","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"max"},"474":{"id":"/docs/benchmarking-316","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"5 000"},"475":{"id":"/docs/benchmarking-317","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"5 001 (100 %)"},"476":{"id":"/docs/benchmarking-318","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"50 005"},"477":{"id":"/docs/benchmarking-319","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"0,60 мс"},"478":{"id":"/docs/