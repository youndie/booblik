ntent":"mac"},"788":{"id":"/docs/benchmarking-603","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"linux"},"789":{"id":"/docs/benchmarking-604","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Потолок PRODUCE"},"790":{"id":"/docs/benchmarking-605","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"268 270 записей/с"},"791":{"id":"/docs/benchmarking-606","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**1 245 583 записей/с**"},"792":{"id":"/docs/benchmarking-607","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"При 1 млн записей/с"},"793":{"id":"/docs/benchmarking-608","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"—"},"794":{"id":"/docs/benchmarking-609","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"p50 **0,187 мс**, p99 48 мс"},"795":{"id":"/docs/benchmarking-610","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"FETCH на 4 ГиБ/с"},"796":{"id":"/docs/benchmarking-611","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"не проверялось"},"797":{"id":"/docs/benchmarking-612","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"100 % цели, p50 0,154 мс"},"798":{"id":"/docs/benchmarking-613","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Селектор против виртуальных потоков (PRODUCE у потолка)"},"799":{"id":"/docs/benchmarking-614","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"20 001 против 20 001, p99 109 против 140 мс"},"800":{"id":"/docs/benchmarking-615","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**100 000** против 84 415, p50 0,19 против 1 445 мс"},"801":{"id":"/docs/benchmarking-616","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Конвейер: глубина 1 → 4"},"802":{"id":"/docs/benchmarking-617","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"17 977 → 20 001"},"803":{"id":"/docs/benchmarking-618","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**60 380 → 100 001**"},"804":{"id":"/docs/benchmarking-619","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Выводы M3 и M4 подтвердились на обеих машинах и на Linux стали резче: селектор обгоняет\nвиртуальные потоки, конвейер глубины 4 забирает всё, что даёт конвейеризация."},"805":{"id":"/docs/benchmarking-620","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Одна деталь видна только на маке: глубина 1024 даёт **p50 232 мс** против 2,0 мс у глубины 4 при\nтой же принятой нагрузке. Глубокая очередь не ускоряет, а копит — ещё один довод за «конвейер\nнужен неглубокий»."},"806":{"id":"/docs/benchmarking-621","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**M-35 на Linux:** до 4 ГиБ/с обе реализации принимают 100 % нагрузки; `ZERO_COPY` выигрывает\nхвостом (p99 16,4 против 27,2 мс). Насыщения не достигли — картина та же, что на маке, только\nграница дальше."},"807":{"id":"/docs/benchmarking-622","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Замер 1 отвечал на этот вопрос на маке и на слое хранения: там профиль оказался бесплатным.\nПовтор на Linux и на **сквозном пути**, где живёт вся аллокация сетевого слоя:"},"808":{"id":"/docs/benchmarking-623","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Нагрузка"},"809":{"id":"/docs/benchmarking-624","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Профиль"},"810":{"id":"/docs/benchmarking-625","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Достигнуто"},"811":{"id":"/docs/benchmarking-626","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"p50"},"812":{"id":"/docs/benchmarking-627","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"p99"},"813":{"id":"/docs/benchmarking-628","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"GC"},"814":{"id":"/docs/benchmarking-629","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"100 000 зап/с"},"815":{"id":"/docs/benchmarking-630","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"64 МиБ, SerialGC"},"816":{"id":"/docs/benchmarking-631","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"100 000 (100 %)"},"817":{"id":"/docs/benchmarking-632","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"0,187 мс