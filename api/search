iki/booblik-core-56","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"The actor responsible for batching and writing to the log."},"3427":{"id":"/wiki/booblik-core-57","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"`WriterClosedException`"},"3428":{"id":"/wiki/booblik-core-58","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"`PartitionWriter.kt:312`"},"3429":{"id":"/wiki/booblik-core-59","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"Thrown when attempting to write to a closed writer."},"3430":{"id":"/wiki/booblik-core-60","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"`FlushPolicy`"},"3431":{"id":"/wiki/booblik-core-61","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"`FlushPolicy.kt:27`"},"3432":{"id":"/wiki/booblik-core-62","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#public-api","content":"Defines when the writer should trigger a disk flush."},"3433":{"id":"/wiki/booblik-core-63","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#behaviour-that-surprises","content":"`PartitionWriter` uses a `select` expression in `awaitCommand` to avoid swallowing commands when a timeout occurs, preventing producers from hanging indefinitely (`PartitionWriter.kt:247-250`)."},"3434":{"id":"/wiki/booblik-core-64","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#behaviour-that-surprises","content":"`LogSegment.retire` unlinks the file from the filesystem immediately, but the file remains accessible to existing readers until their descriptors are closed (`LogSegment.kt:217-218`)."},"3435":{"id":"/wiki/booblik-core-65","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#behaviour-that-surprises","content":"`PartitionLog.append` will trigger a `roll()` if a record is too large to fit in the current `activeSegment`, provided it fits in a new empty segment (`PartitionLog.kt:75`)."},"3436":{"id":"/wiki/booblik-core/recovery-after-crash","page_id":"/wiki/booblik-core/recovery-after-crash","type":"page","content":"Recovery after a crash","breadcrumbs":["Docs","Wiki","booblik-core"],"tags":[],"url":"/wiki/booblik-core/recovery-after-crash"},"3437":{"id":"/wiki/booblik-core/recovery-after-crash-0","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#diagram","content":"Diagram"},"3438":{"id":"/wiki/booblik-core/recovery-after-crash-1","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#the-recovery-mechanism","content":"The recovery mechanism"},"3439":{"id":"/wiki/booblik-core/recovery-after-crash-2","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"SegmentMode and the end-of-log sentinel"},"3440":{"id":"/wiki/booblik-core/recovery-after-crash-3","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#torn-records-and-checksum-verification","content":"Torn records and checksum verification"},"3441":{"id":"/wiki/booblik-core/recovery-after-crash-4","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#sparseoffsetindex-reconstruction","content":"SparseOffsetIndex reconstruction"},"3442":{"id":"/wiki/booblik-core/recovery-after-crash-5","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#crashrecoverytest-invariants","content":"CrashRecoveryTest invariants"},"3443":{"id":"/wiki/booblik-core/recovery-after-crash-6","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#recoverytest-edge-cases","content":"RecoveryTest edge cases"},"3444":{"id":"/wiki/booblik-core/recovery-after-crash-7","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"Key files"},"3445":{"id":"/wiki/booblik-core/recovery-after-crash-8","page_id":"/wiki/booblik-core/recovery-after-crash","type":"heading","tags":[],"url":"/wiki/booblik-core/recovery-after-crash#behaviour-that-surprises","content":"Behaviour that surprises"},"3446":{"id":"/wiki/booblik-core/recovery-after-crash-9","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3447":{"id":"/wiki/booblik-core/recovery-after-crash-10","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#the-recovery-mechanism","content":"When a segment is opened, `LogSegment.open` invokes the `recover` function to reconstruct the state of the log from the raw bytes on disk (`LogSegment.kt:261-373`). This process involves walking the file by reading record headers in chunks (using a 1 MiB `RECOVERY_BUFFER` as seen in `LogSegment.kt:327`) to find valid record boundaries. As the function traverses the file, it populates the `SparseOffsetIndex` by calling `index.append` for each valid record found (`LogSegment.kt:368`)."},"3448":{"id":"/wiki/booblik-core/recovery-after-crash-11","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"The definition of the \"end of the log\" depends on the `SegmentMode` used, which determines how the `limit` for recovery is calculated (`LogSegment.kt:285`):"},"3449":{"id":"/wiki/booblik-core/recovery-after-crash-12","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"Mode"},"3450":{"id":"/wiki/booblik-core/recovery-after-crash-13","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"End-of-log Sentinel"},"3451":{"id":"/wiki/booblik-core/recovery-after-crash-14","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"`FILE_CHANNEL`"},"3452":{"id":"/wiki/booblik-core/recovery-after-crash-15","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"The physical file length (`readChannel.size()`)"},"3453":{"id":"/wiki/booblik-core/recovery-after-crash-16","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"`MAPPED`"},"3454":{"id":"/wiki/booblik-core/recovery-after-crash-17","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"A zero-length prefix in a pre-sized file"},"3455":{"id":"/wiki/booblik-core/recovery-after-crash-18","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#segmentmode-and-the-end-of-log-sentinel","content":"In `MAPPED` mode, because the file is pre-sized to its full capacity (`LogSegment.kt:288`), the recovery process must rely on finding a zero length or a checksum mismatch to stop, rather than the file size (`LogSegment.kt:349`)."},"3456":{"id":"/wiki/booblik-core/recovery-after-crash-19","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#torn-records-and-checksum-verification","content":"To handle crashes that occur during a write, the recovery process uses CRC32C checksums stored in the `RECORD_HEADER` (`SegmentWriter.kt:85`). During recovery, the `verify` function checks the payload against the expected CRC (`LogSegment.kt:405`). If a record's body was only partially written, the checksum will fail, and recovery will treat that point as the end of the log. However, there is a known gap: if a torn write occurs *inside* a record body, it is only detectable if the checksum is verified; without it, the length prefix alone is the only evidence of integrity (`LogSegment.kt:258`)."},"3457":{"id":"/wiki/booblik-core/recovery-after-crash-20","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#sparseoffsetindex-reconstruction","content":"The `SparseOffsetIndex` is rebuilt by scanning the log and adding entries only when the `intervalBytes` threshold is crossed (`SparseOffsetIndex.kt:73`). During recovery or manual truncation, the index is updated via `truncateTo`, which discards all entries at or above the specified offset to ensure the index does not describe data that no longer exists in the segment (`SparseOffsetIndex.kt:103`)."},"3458":{"id":"/wiki/booblik-core/recovery-after-crash-21","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#crashrecoverytest-invariants","content":"The `CrashRecoveryTest` ensures that the system remains consistent even after a `SIGKILL`. It spawns a `CrashWriter` as a separate subprocess to simulate a hard crash (`CrashRecoveryTest.kt:56`). The core invariant verified is that after reopening the segment, the log must end on a valid record boundary, meaning every reported record is readable and matches its original checksum (`CrashRecoveryTest.kt:106`)."},"3459":{"id":"/wiki/booblik-core/recovery-after-crash-22","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#recoverytest-edge-cases","content":"The `RecoveryTest` suite validates several critical recovery scenarios:"},"3460":{"id":"/wiki/booblik-core/recovery-after-crash-23","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#recoverytest-edge-cases","content":"**Offset Restoration:** Ensuring that reopening a segment restores the `nextOffset` and the index correctly (`RecoveryTest.kt:38`)."},"3461":{"id":"/wiki/booblik-core/recovery-after-crash-24","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#recoverytest-edge-cases","content":"**MAPPED Mode Orphans:** In `MAPPED` mode, if a crash leaves an \"orphaned body\" (data written but the header not yet reached), the recovery mechanism must correctly discard it by treating the missing header as the end of the log (`RecoveryTest.kt:98`)."},"3462":{"id":"/wiki/booblik-core/recovery-after-crash-25","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"File"},"3463":{"id":"/wiki/booblik-core/recovery-after-crash-26","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"Lines"},"3464":{"id":"/wiki/booblik-core/recovery-after-crash-27","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"What is there"},"3465":{"id":"/wiki/booblik-core/recovery-after-crash-28","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`…/storage/LogSegment.kt`"},"3466":{"id":"/wiki/booblik-core/recovery-after-crash-29","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`321-373`"},"3467":{"id":"/wiki/booblik-core/recovery-after-crash-30","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"The `recover` function implementation"},"3468":{"id":"/wiki/booblik-core/recovery-after-crash-31","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`…/storage/SparseOffsetIndex.kt`"},"3469":{"id":"/wiki/booblik-core/recovery-after-crash-32","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`71-85`"},"3470":{"id":"/wiki/booblik-core/recovery-after-crash-33","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"Logic for appending entries to the sparse index"},"3471":{"id":"/wiki/booblik-core/recovery-after-crash-34","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`…/storage/SegmentWriter.kt`"},"3472":{"id":"/wiki/booblik-core/recovery-after-crash-35","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`85-86`"},"3473":{"id":"/wiki/booblik-core/recovery-after-crash-36","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"Definition of the `RECORD_HEADER`"},"3474":{"id":"/wiki/booblik-core/recovery-after-crash-37","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`…/storage/CrashRecoveryTest.kt`"},"3475":{"id":"/wiki/booblik-core/recovery-after-crash-38","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`134-163`"},"3476":{"id":"/wiki/booblik-core/recovery-after-crash-39","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"The `CrashWriter` subprocess implementation"},"3477":{"id":"/wiki/booblik-core/recovery-after-crash-40","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`…/storage/RecoveryTest.kt`"},"3478":{"id":"/wiki/booblik-core/recovery-after-crash-41","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"`87-106`"},"3479":{"id":"/wiki/booblik-core/recovery-after-crash-42","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#key-files","content":"Tests for `MAPPED` mode edge cases"},"3480":{"id":"/wiki/booblik-core/recovery-after-crash-43","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#behaviour-that-surprises","content":"`LogSegment.open` in `MAPPED` mode may pre-size the file to its full capacity, meaning the file size on disk does not represent the amount of data actually written (`LogSegment.kt:282`)."},"3481":{"id":"/wiki/booblik-core/recovery-after-crash-44","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#behaviour-that-surprises","content":"The `SparseOffsetIndex` is not dense; it only stores an entry every `intervalBytes`, requiring a forward scan to find exact positions (`SparseOffsetIndex.kt:18`)."},"3482":{"id":"/wiki/booblik-core/recovery-after-crash-45","page_id":"/wiki/booblik-core/recovery-after-crash","tags":[],"type":"text","url":"/wiki/booblik-core/recovery-after-crash#behaviour-that-surprises","content":"`SegmentWriter.append` is not thread-safe by design; it assumes a single-threaded ownership by a single coroutine (`SegmentWriter.kt:15`)."},"3483":{"id":"/wiki/ci","page_id":"/wiki/ci","type":"page","content":"ci","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci"},"3484":{"id":"/wiki/ci-0","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3485":{"id":"/wiki/ci-1","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#diagram","content":"Diagram"},"3486":{"id":"/wiki/ci-2","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-performance-floor","content":"The performance floor"},"3487":{"id":"/wiki/ci-3","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-gated-docker-build","content":"The gated Docker build"},"3488":{"id":"/wiki/ci-4","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-docker-smoke-test","content":"The Docker smoke test"},"3489":{"id":"/wiki/ci-5","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-remote-execution-transport","content":"The remote execution transport"},"3490":{"id":"/wiki/ci-6","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-wsl-measurement-environment","content":"The WSL measurement environment"},"3491":{"id":"/wiki/ci-7","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-distribution-delivery-check","content":"The distribution delivery check"},"3492":{"id":"/wiki/ci-8","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#key-files","content":"Key files"},"3493":{"id":"/wiki/ci-9","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#behaviour-that-surprise","content":"Behaviour that surprise"},"3494":{"id":"/wiki/ci-10","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3495":{"id":"/wiki/ci-11","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#what-this-module-is-responsible-for","content":"The `ci` module provides a suite of automation scripts designed to ensure the reliability, performance, and correct delivery of the `booblik` broker. It covers everything from detecting catastrophic performance collapses to verifying that Docker images are built from validated distributions and behave correctly in a containerized environment."},"3496":{"id":"/wiki/ci-12","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-performance-floor","content":"The mechanism for detecting catastrophic performance collapses without using relative percentages. Instead of using percentages which are unreliable on different hardware, `benchmark-floor.sh:24-25` defines absolute thresholds (a tenth of the slowest measured host) to catch \"collapses\" rather than minor regressions."},"3497":{"id":"/wiki/ci-13","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-performance-floor","content":"More: The performance floor"},"3498":{"id":"/wiki/ci-14","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gated-docker-build","content":"The lifecycle stage ensuring images are built only from distributions that have passed all checks. As described in `docker-build.sh:20-22`, the script runs `gradlew check` to act as a gate, ensuring that the resulting image is built from code that has passed all tests."},"3499":{"id":"/wiki/ci-15","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gated-docker-build","content":"More: The gated Docker build"},"3500":{"id":"/wiki/ci-16","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-docker-smoke-test","content":"Verification of the container image, including runtime profiles, user permissions, and data sparseness. The script `docker-smoke.sh:76-83` explicitly verifies that the JVM flags (such as `-Xmx64M`) are present in the running process to ensure the container uses the intended resource profile."},"3501":{"id":"/wiki/ci-17","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-remote-execution-transport","content":"The mechanism for running tasks on remote Linux machines while avoiding network-induced measurement bias. To ensure measurements reflect the hardware and not the network, `remote-run.sh:53-66` refuses to run if the directory sits on a network filesystem like `nfs` or `cifs`."},"3502":{"id":"/wiki/ci-18","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-wsl-measurement-environment","content":"The specific configuration required to run benchmarks in WSL2 to avoid the performance characteristics of the Windows filesystem. The script `wsl-run.sh:60-61` prevents execution if the path is within `/mnt/*`, as measurements on the Windows filesystem (9p) are considered invalid for performance testing."},"3503":{"id":"/wiki/ci-19","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-distribution-delivery-check","content":"Testing the broker's ability to serve and survive a restart using a standalone Python client. This is implemented in `smoke.sh:109-122`, where a Python script independently implements the wire format to verify that the broker's `PRODUCE` and `FETCH` operations work correctly and that checksums match."},"3504":{"id":"/wiki/ci-20","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"File"},"3505":{"id":"/wiki/ci-21","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Lines"},"3506":{"id":"/wiki/ci-22","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"What is there"},"3507":{"id":"/wiki/ci-23","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/benchmark-floor.sh`"},"3508":{"id":"/wiki/ci-24","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`24-25`"},"3509":{"id":"/wiki/ci-25","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Absolute floor values for FILE\\_CHANNEL and MAPPED modes"},"3510":{"id":"/wiki/ci-26","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/docker-build.sh`"},"3511":{"id":"/wiki/ci-27","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`20-22`"},"3512":{"id":"/wiki/ci-28","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"The gate execution logic using `gradlew check`"},"3513":{"id":"/wiki/ci-29","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/docker-smoke.sh`"},"3514":{"id":"/wiki/ci-30","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`76-83`"},"3515":{"id":"/wiki/ci-31","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Verification of specific JVM runtime flags"},"3516":{"id":"/wiki/ci-32","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/remote-run.sh`"},"3517":{"id":"/wiki/ci-33","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`53-66`"},"3518":{"id":"/wiki/ci-34","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Logic to reject network-mounted filesystems"},"3519":{"id":"/wiki/ci-35","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/smoke.sh`"},"3520":{"id":"/wiki/ci-36","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`109-122`"},"3521":{"id":"/wiki/ci-37","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Python implementation of the wire format for verification"},"3522":{"id":"/wiki/ci-38","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/wsl-run.sh`"},"3523":{"id":"/wiki/ci-39","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`60-61`"},"3524":{"id":"/wiki/ci-40","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Protection against measuring the Windows filesystem"},"3525":{"id":"/wiki/ci-41","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"The `await_log` function in `docker-smoke.sh:43-51` must wait for log patterns because `docker logs` is not synchronous, and reading it once can lead to race conditions."},"3526":{"id":"/wiki/ci-42","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"In `remote-run.sh:76`, the `TASKS_QUOTED` variable uses `printf ' %q'` to ensure that complex arguments are parsed correctly by the remote shell rather than being split into multiple arguments."},"3527":{"id":"/wiki/ci-43","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"The `rsync` command in `wsl-run.sh:82` requires the `--rsync-path` flag to bridge the gap between the Windows host and the WSL2 Linux environment."},"3528":{"id":"/wiki/ci/the-gated-docker","page_id":"/wiki/ci/the-gated-docker","type":"page","content":"The gated Docker build","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-gated-docker"},"3529":{"id":"/wiki/ci/the-gated-docker-0","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#diagram","content":"Diagram"},"3530":{"id":"/wiki/ci/the-gated-docker-1","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-gate-and-the-distribution","content":"The gate and the distribution"},"3531":{"id":"/wiki/ci/the-gated-docker-2","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik_skip_gate-mode","content":"The `BOOBLIK_SKIP_GATE` mode"},"3532":{"id":"/wiki/ci/the-gated-docker-3","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-image-job-lifecycle","content":"The `image` job lifecycle"},"3533":{"id":"/wiki/ci/the-gated-docker-4","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblikci-image-verification","content":"The `booblik:ci` image verification"},"3534":{"id":"/wiki/ci/the-gated-docker-5","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `booblik-smoke` assertions"},"3535":{"id":"/wiki/ci/the-gated-docker-6","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik-smoke-segment-sparseness","content":"The `booblik-smoke` segment sparseness"},"3536":{"id":"/wiki/ci/the-gated-docker-7","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#key-files","content":"Key files"},"3537":{"id":"/wiki/ci/the-gated-docker-8","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"Behaviour that surprises"},"3538":{"id":"/wiki/ci/the-gated-docker-9","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3539":{"id":"/wiki/ci/the-gated-docker-10","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-gate-and-the-distribution","content":"To prevent packaging stale or broken code, `docker-build.sh:22` executes the full `check` task via Gradle before any packaging occurs. This ensures that the `installDist` stage, which prepares the files for the image (`docker-build.sh:27-29`), only operates on a distribution that has passed all tests and linting."},"3540":{"id":"/wiki/ci/the-gated-docker-11","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik_skip_gate-mode","content":"For local development and debugging, the build can be bypassed using the `BOOBLIK_SKIP_GATE=1` environment variable (`docker-build.sh:12`). When this mode is active, the script explicitly changes the build's truthfulness, labeling the resulting image as \"WITHOUT THE GATE — from unchecked code\" (`docker-build.sh:25`) instead of the standard \"passed the gate\" (`docker-build.sh:19`)."},"3541":{"id":"/wiki/ci/the-gated-docker-12","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-image-job-lifecycle","content":"The `image` job in `build.yml:65` is decoupled from the `check` job to satisfy two requirements: it requires a Docker daemon which the standard `check` runner lacks (`build.yml:63`), and it must not fail the entire CI pipeline if a Docker-specific issue occurs, as the code correctness was already verified in the `check` job (`build.yml:64`)."},"3542":{"id":"/wiki/ci/the-gated-docker-13","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblikci-image-verification","content":"The verification of the `booblik:ci` image follows a strict sequence: first, the image is built via `./ci/docker-build.sh booblik:ci` (`build.yml:84`), then it is subjected to runtime assertions in `ci/docker-smoke.sh` (`build.yml:89`), and finally, it is validated against a reference client via `./conformance/run.sh` (`build.yml:102`)."},"3543":{"id":"/wiki/ci/the-gated-docker-14","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `ci/docker-smoke.sh` script performs deep inspection of the running container to ensure the runtime environment matches the measured profile. It verifies that:"},"3544":{"id":"/wiki/ci/the-gated-docker-15","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The process runs as the `booblik` user (`docker-smoke.sh:95`)."},"3545":{"id":"/wiki/ci/the-gated-docker-16","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The JVM profile includes exactly six specific flags, such as `-Xmx64M` and `-XX:+UseSerialGC` (`docker-smoke.sh:76-83`)."},"3546":{"id":"/wiki/ci/the-gated-docker-17","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `booblik-health` tool can successfully query the broker's `METADATA` (`docker-smoke.sh:87`)."},"3547":{"id":"/wiki/ci/the-gated-docker-18","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-segment-sparseness","content":"To ensure the storage layer is efficient, `docker-smoke.sh:104` checks that segment files are created as sparse files. It verifies that the `BLOCKS` count reported by `stat` is less than 2048, ensuring the segment has not been fully materialized on disk."},"3548":{"id":"/wiki/ci/the-gated-docker-19","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"File"},"3549":{"id":"/wiki/ci/the-gated-docker-20","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Lines"},"3550":{"id":"/wiki/ci/the-gated-docker-21","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"What is there"},"3551":{"id":"/wiki/ci/the-gated-docker-22","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`ci/docker-build.sh`"},"3552":{"id":"/wiki/ci/the-gated-docker-23","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`17-38`"},"3553":{"id":"/wiki/ci/the-gated-docker-24","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Logic for gating, distribution, and image size reporting"},"3554":{"id":"/wiki/ci/the-gated-docker-25","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`ci/docker-smoke.sh`"},"3555":{"id":"/wiki/ci/the-gated-docker-26","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`43-85`"},"3556":{"id":"/wiki/ci/the-gated-docker-27","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Log awaiting mechanism and JVM flag verification"},"3557":{"id":"/wiki/ci/the-gated-docker-28","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`…/workflows/build.yml`"},"3558":{"id":"/wiki/ci/the-gated-docker-29","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`14-90`"},"3559":{"id":"/wiki/ci/the-gated-docker-30","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Definition of the `check` and `image` CI jobs"},"3560":{"id":"/wiki/ci/the-gated-docker-31","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `await_log` function in `docker-smoke.sh:43` uses a loop and a local variable to read `docker logs` into a variable before matching, avoiding a SIGPIPE failure that occurs when piping `docker logs` directly into `grep` under `set -o pipefail`."},"3561":{"id":"/wiki/ci/the-gated-docker-32","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `installDist` stage in `docker-build.sh:27` is a prerequisite for `docker build` because the Dockerfile does not contain a build stage; it relies on the files already present in the `build/install` directory."},"3562":{"id":"/wiki/ci/the-gated-docker-33","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `booblik-health` check in `docker-smoke.sh:88` is designed to fail if a port is \"healthy\" but no process is actually listening on it, by checking a secondary port that should have no service."},"3563":{"id":"/wiki/ci/the-performance-floor","page_id":"/wiki/ci/the-performance-floor","type":"page","content":"The performance floor","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-performance-floor"},"3564":{"id":"/wiki/ci/the-performance-floor-0","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#diagram","content":"Diagram"},"3565":{"id":"/wiki/ci/the-performance-floor-1","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#the-benchmark-floor","content":"The benchmark floor"},"3566":{"id":"/wiki/ci/the-performance-floor-2","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"SegmentMode and the disk barrier"},"3567":{"id":"/wiki/ci/the-performance-floor-3","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"SparseOffsetIndex"},"3568":{"id":"/wiki/ci/the-performance-floor-4","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"Recovery after a crash"},"3569":{"id":"/wiki/ci/the-performance-floor-5","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#the-write-actor-and-group-commit","content":"The write actor and group commit"},"3570":{"id":"/wiki/ci/the-performance-floor-6","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#key-files","content":"Key files"},"3571":{"id":"/wiki/ci/the-performance-floor-7","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"Behaviour that surprises"},"3572":{"id":"/wiki/ci/the-performance-floor-8","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3573":{"id":"/wiki/ci/the-performance-floor-9","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#the-benchmark-floor","content":"The logic and purpose of the CI check is to provide a \"floor\" that is an order of magnitude below the slowest plausible runner to avoid false positives caused by hardware variance. As noted in `benchmark-floor.sh:11-13`, the check deliberately ignores fine-grained regressions because different CI runs occur on different machines with different neighbors, making percentage-based comparisons unreliable. The script calculates a score by parsing the JMH report and comparing the whole number part of the throughput against a predefined threshold (`benchmark-floor.sh:24-51`)."},"3574":{"id":"/wiki/ci/the-performance-floor-10","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"The benchmarks distinguish between different write paths, specifically focusing on how they interact with the disk barrier. The `mainCiBenchmark` task excludes certain rows to avoid measuring the \"disk barrier\" (the cost of `fsync` or `msync`), which is too variable on hosted runners to be meaningful (`benchmark.yml:22-28`). The two primary modes are:"},"3575":{"id":"/wiki/ci/the-performance-floor-11","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Mode"},"3576":{"id":"/wiki/ci/the-performance-floor-12","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Description"},"3577":{"id":"/wiki/ci/the-performance-floor-13","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"`FILE_CHANNEL`"},"3578":{"id":"/wiki/ci/the-performance-floor-14","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Uses `FileChannel` where the file length acts as a boundary for recovery (`RecoveryTest.kt:67-71`)."},"3579":{"id":"/wiki/ci/the-performance-floor-15","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"`MAPPED`"},"3580":{"id":"/wiki/ci/the-performance-floor-16","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Uses memory mapping where the file is pre-sized, requiring a zero-length prefix to mark record boundaries (`RecoveryTest.kt:87-91`)."},"3581":{"id":"/wiki/ci/the-performance-floor-17","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"The `SparseOffsetIndex` provides a memory-efficient way to map offsets to positions without the allocation overhead of a standard `Map`. It uses a `LongArray` where each entry stores a relative offset in the high 32 bits and a position in the low 32 bits (`SparseOffsetIndex.kt:15-16`)."},"3582":{"id":"/wiki/ci/the-performance-floor-18","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"The mechanics of the index include:"},"3583":{"id":"/wiki/ci/the-performance-floor-19","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Sparsity**: An entry is only added when `intervalBytes` (default 4 KiB) of log data has passed (`SparseOffsetIndex.kt:73-75`)."},"3584":{"id":"/wiki/ci/the-performance-floor-20","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Lookup**: A binary search is performed on the `entries` array to find the largest entry where the relative offset is less than or equal to the target (`SparseOffsetIndex.kt:124-136`)."},"3585":{"id":"/wiki/ci/the-performance-floor-21","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Concurrency**: The `count` is marked `@Volatile` and updated after the array slot is filled to ensure readers see a consistent view (`SparseOffsetIndex.kt:80-82`)."},"3586":{"id":"/wiki/ci/the-performance-floor-22","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"The system is designed to survive a `SIGKILL` during a write operation, ensuring the log remains usable. The invariant is that reopening the log must result in a log that ends on a record boundary with valid checksums (`CrashRecoveryTest.kt:24-28`)."},"3587":{"id":"/wiki/ci/the-performance-floor-23","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"Recovery behavior depends on the `SegmentMode`:"},"3588":{"id":"/wiki/ci/the-performance-floor-24","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"**FILE\\_CHANNEL**: Recovery stops at the last intact record boundary because the file length bounds the data (`RecoveryTest.kt:67-71`)."},"3589":{"id":"/wiki/ci/the-performance-floor-25","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"**MAPPED**: Since the file is pre-sized, recovery relies on the fact that the writer stores the body before the prefix; a crash leaves an \"orphaned body\" without a header, which is treated as the end of the log (`RecoveryTest.kt:87-91`)."},"3590":{"id":"/wiki/ci/the-performance-floor-26","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#the-write-actor-and-group-commit","content":"The interaction between `append` calls and the `force` mechanism is central to performance. In a real scenario, group commits allow many appends to be collapsed into a single barrier. This can be tested using `CountingLog`, which tracks the number of `append` calls versus `force` calls (`CountingLog.kt:10-12`). By using `forceMillis` in the test, one can simulate a slow barrier to ensure that the grouping of multiple appends into a single `force` call is functioning as expected (`CountingLog.kt:44`)."},"3591":{"id":"/wiki/ci/the-performance-floor-27","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"File"},"3592":{"id":"/wiki/ci/the-performance-floor-28","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Lines"},"3593":{"id":"/wiki/ci/the-performance-floor-29","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"What is there"},"3594":{"id":"/wiki/ci/the-performance-floor-30","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`ci/benchmark-floor.sh`"},"3595":{"id":"/wiki/ci/the-performance-floor-31","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`24-25`"},"3596":{"id":"/wiki/ci/the-performance-floor-32","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Definition of the floor thresholds for `FILE_CHANNEL` and `MAPPED`."},"3597":{"id":"/wiki/ci/the-performance-floor-33","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`…/storage/SparseOffsetIndex.kt`"},"3598":{"id":"/wiki/ci/the-performance-floor-34","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`130-136`"},"3599":{"id":"/wiki/ci/the-performance-floor-35","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Binary search implementation for the sparse index lookup."},"3600":{"id":"/wiki/ci/the-performance-floor-36","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`…/log/CountingLog.kt`"},"3601":{"id":"/wiki/ci/the-performance-floor-37","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`37-40`"},"3602":{"id":"/wiki/ci/the-performance-floor-38","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"The `append` implementation that increments the `appendCount`."},"3603":{"id":"/wiki/ci/the-performance-floor-39","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"The `SparseOffsetIndex` uses a `LongArray` instead of a `ConcurrentSkipListMap` specifically to avoid boxing `Offset` and `Position` values, which would cause allocations in the hot path (`SparseOffsetIndex.kt:13-15`)."},"3604":{"id":"/wiki/ci/the-performance-floor-40","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"In `MAPPED` mode, a crash can leave \"orphaned\" bytes in the file that are not considered part of the log because they lack a valid header (`RecoveryTest.kt:97-98`)."},"3605":{"id":"/wiki/ci/the-performance-floor-41","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"The `count` in `SparseOffsetIndex` is updated *after* the entry is written to the array to ensure that a reader seeing a new `count` is guaranteed to see the corresponding data in the array (`SparseOffsetIndex.kt:80-82`)."},"3606":{"id":"/wiki/booblik-net/booblikserver","page_id":"/wiki/booblik-net/booblikserver","type":"page","content":"BooblikServer","breadcrumbs":["Docs","Wiki","booblik-net"],"tags":[],"url":"/wiki/booblik-net/booblikserver"},"3607":{"id":"/wiki/booblik-net/booblikserver-0","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3608":{"id":"/wiki/booblik-net/booblikserver-1","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#diagram","content":"Diagram"},"3609":{"id":"/wiki/booblik-net/booblikserver-2","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Transport Modes: SELECTOR vs VIRTUAL_THREADS"},"3610":{"id":"/wiki/booblik-net/booblikserver-3","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"FetchMode: ZERO_COPY and the FileChannel Path"},"3611":{"id":"/wiki/booblik-net/booblikserver-4","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#the-acceptor-loop-and-connection-lifecycle","content":"The Acceptor Loop and Connection Lifecycle"},"3612":{"id":"/wiki/booblik-net/booblikserver-5","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#session-failure-domains-and-supervisorjob","content":"Session Failure Domains and SupervisorJob"},"3613":{"id":"/wiki/booblik-net/booblikserver-6","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#the-m-64-bind-address-fix","content":"The M-64 Bind Address Fix"},"3614":{"id":"/wiki/booblik-net/booblikserver-7","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"Server Configuration and TCP Options"},"3615":{"id":"/wiki/booblik-net/booblikserver-8","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#key-files","content":"Key files"},"3616":{"id":"/wiki/booblik-net/booblikserver-9","page_id":"/wiki/booblik-net/booblikserver","type":"heading","tags":[],"url":"/wiki/booblik-net/booblikserver#behaviour-that-surprises","content":"Behaviour that surprises"},"3617":{"id":"/wiki/booblik-net/booblikserver-10","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3618":{"id":"/wiki/booblik-net/booblikserver-11","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#what-this-module-is-responsible-for","content":"The `BooblikServer` acts as the network front end of the broker, managing the lifecycle of connections and dispatching requests to the appropriate partitions. It provides two distinct transport mechanisms and supports zero-copy data transfer for high-performance fetching."},"3619":{"id":"/wiki/booblik-net/booblikserver-12","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"The server supports two different execution models for handling connections, which can be configured via `ServerConfig` (`BooblikServer.kt:59`):"},"3620":{"id":"/wiki/booblik-net/booblikserver-13","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Mode"},"3621":{"id":"/wiki/booblik-net/booblikserver-14","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Mechanism"},"3622":{"id":"/wiki/booblik-net/booblikserver-15","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Implementation Detail"},"3623":{"id":"/wiki/booblik-net/booblikserver-16","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"`SELECTOR`"},"3624":{"id":"/wiki/booblik-net/booblikserver-17","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"NIO-based selector loop"},"3625":{"id":"/wiki/booblik-net/booblikserver-18","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Uses `SelectorLoop` to manage readiness and one coroutine per connection (`BooblikServer.kt:150-188`)"},"3626":{"id":"/wiki/booblik-net/booblikserver-19","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"`VIRTUAL_THREADS`"},"3627":{"id":"/wiki/booblik-net/booblikserver-20","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Thread-per-connection"},"3628":{"id":"/wiki/booblik-net/booblikserver-21","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#transport-modes-selector-vs-virtual_threads","content":"Uses a `VirtualThreadPerTaskExecutor` where `runBlocking` turns suspension points into thread parks (`BooblikServer.kt:200-218`)"},"3629":{"id":"/wiki/booblik-net/booblikserver-22","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"To achieve high performance, the server provides two ways to deliver data to the client (`BooblikServer.kt:37-43`):"},"3630":{"id":"/wiki/booblik-net/booblikserver-23","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Mode"},"3631":{"id":"/wiki/booblik-net/booblikserver-24","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Mechanism"},"3632":{"id":"/wiki/booblik-net/booblikserver-25","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Description"},"3633":{"id":"/wiki/booblik-net/booblikserver-26","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"`ZERO_COPY`"},"3634":{"id":"/wiki/booblik-net/booblikserver-27","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"`sendfile`"},"3635":{"id":"/wiki/booblik-net/booblikserver-28","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Uses `FileChannel.transferTo` to move data from the page cache directly to the socket buffer, bypassing the JVM heap (`BooblikServer.kt:113-115`)"},"3636":{"id":"/wiki/booblik-net/booblikserver-29","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"`HEAP`"},"3637":{"id":"/wiki/booblik-net/booblikserver-30","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Heap Buffer"},"3638":{"id":"/wiki/booblik-net/booblikserver-31","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#fetchmode-zero_copy-and-the-filechannel-path","content":"Reads data into a heap buffer and then writes it, serving as the control group for experiments (`BooblikServer.kt:41-42`)"},"3639":{"id":"/wiki/booblik-net/booblikserver-32","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#the-acceptor-loop-and-connection-lifecycle","content":"The server maintains an acceptor loop that is responsible for accepting new `SocketChannel` instances. In `SELECTOR` mode, this loop is a coroutine running within a `SupervisorJob` (`BooblikServer.kt:154-159`). The loop is designed to be resilient: if an exception occurs during `serverChannel.accept()`, it is treated as transient, the error is recorded in `metrics`, and the loop continues to prevent the broker from hanging silently (`BooblikServer.kt:169-175`)."},"3640":{"id":"/wiki/booblik-net/booblikserver-33","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#session-failure-domains-and-supervisorjob","content":"To ensure high availability, each client connection is isolated within its own coroutine scope. By using a `SupervisorJob` (`BooblikServer.kt:123-124`), the server ensures that a failure in a single `Session` (such as a malformed request or a sudden connection drop) only terminates that specific session and does not propagate upwards to crash the entire `BooblikServer` (`BooblikServer.kt:185-187`)."},"3641":{"id":"/wiki/booblik-net/booblikserver-34","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#the-m-64-bind-address-fix","content":"A critical correctness feature is the ability to bind to a specific `bindAddress` rather than a wildcard address (`BooblikServer.kt:58`). As documented in `ServerFixture.kt:40-46`, binding to a specific address like `127.0.0.1` prevents \"silent connection theft\" on BSD-derived systems where `SO_REUSEADDR` might allow another process to intercept connections intended for the broker if a wildcard bind is used."},"3642":{"id":"/wiki/booblik-net/booblikserver-35","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"The server applies specific socket options to optimize the transport layer (`BooblikServer.kt:227-233`):"},"3643":{"id":"/wiki/booblik-net/booblikserver-36","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"Option"},"3644":{"id":"/wiki/booblik-net/booblikserver-37","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"Purpose"},"3645":{"id":"/wiki/booblik-net/booblikserver-38","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"`TCP_NODELAY`"},"3646":{"id":"/wiki/booblik-net/booblikserver-39","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"Disables Nagle's algorithm to reduce latency for small batches (`BooblikServer.kt:228`)"},"3647":{"id":"/wiki/booblik-net/booblikserver-40","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"`SO_KEEPALIVE`"},"3648":{"id":"/wiki/booblik-net/booblikserver-41","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#server-configuration-and-tcp-options","content":"Enabled to ensure that connections held open for long periods (e.g., during a `FETCH`) are detected as failed by the OS rather than remaining silent (`BooblikServer.kt:232`)"},"3649":{"id":"/wiki/booblik-net/booblikserver-42","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"File"},"3650":{"id":"/wiki/booblik-net/booblikserver-43","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"Lines"},"3651":{"id":"/wiki/booblik-net/booblikserver-44","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"What is there"},"3652":{"id":"/wiki/booblik-net/booblikserver-45","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`…/net/BooblikServer.kt`"},"3653":{"id":"/wiki/booblik-net/booblikserver-46","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`25-64`"},"3654":{"id":"/wiki/booblik-net/booblikserver-47","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`ServerConfig` and `Transport`/`FetchMode` enums"},"3655":{"id":"/wiki/booblik-net/booblikserver-48","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`…/net/BooblikServer.kt`"},"3656":{"id":"/wiki/booblik-net/booblikserver-49","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`117-147`"},"3657":{"id":"/wiki/booblik-net/booblikserver-50","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`BooblikServer` class and `start()` method"},"3658":{"id":"/wiki/booblik-net/booblikserver-51","page_id":"/wiki/booblik-net/booblikserver","tags":[],"type":"text","url":"/wiki/booblik-net/booblikserver#key-files","content":"`…/ne