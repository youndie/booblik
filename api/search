-95","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`SelectorLoop.kt:31`"},"4663":{"id":"/wiki/booblik-net-96","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"The engine that manages NIO readiness."},"4664":{"id":"/wiki/booblik-net-97","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`BrokerConfig`"},"4665":{"id":"/wiki/booblik-net-98","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`Broker.kt:19`"},"4666":{"id":"/wiki/booblik-net-99","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"Configuration for segmenting and retention in the broker."},"4667":{"id":"/wiki/booblik-net-100","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`Broker`"},"4668":{"id":"/wiki/booblik-net-101","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`Broker.kt:49`"},"4669":{"id":"/wiki/booblik-net-102","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"The high-level broker managing partitions and retention."},"4670":{"id":"/wiki/booblik-net-103","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`Metrics`"},"4671":{"id":"/wiki/booblik-net-104","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"`Metrics.kt:29`"},"4672":{"id":"/wiki/booblik-net-105","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#public-api","content":"Provides telemetry and snapshots of broker activity."},"4673":{"id":"/wiki/booblik-net-106","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#behaviour-that-surprises","content":"`SelectorLoop` uses a `ConcurrentLinkedQueue` to post interest changes because modifying `SelectionKey.interestOps` from a thread other than the selector thread can be ineffective or block (`SelectorLoop.kt:26-28`)."},"4674":{"id":"/wiki/booblik-net-107","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#behaviour-that-surprises","content":"`BlockingConnection`'s `transferFrom` method may enter a tight loop if `segment.transferTo` returns zero, as it treats zero as \"try again immediately\" rather than waiting (`Connection.kt:134`)."},"4675":{"id":"/wiki/booblik-net-108","page_id":"/wiki/booblik-net","tags":[],"type":"text","url":"/wiki/booblik-net#behaviour-that-surprises","content":"`BooblikServer` uses a `SupervisorJob` for its scope so that a failure in a single client session does not crash the entire server (`BooblikServer.kt:185-186`)."},"4676":{"id":"/wiki/booblik-net/transport","page_id":"/wiki/booblik-net/transport","type":"page","content":"Transport","breadcrumbs":["Docs","Wiki","booblik-net"],"tags":[],"url":"/wiki/booblik-net/transport"},"4677":{"id":"/wiki/booblik-net/transport-0","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#diagram","content":"Diagram"},"4678":{"id":"/wiki/booblik-net/transport-1","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#transport-modes","content":"Transport modes"},"4679":{"id":"/wiki/booblik-net/transport-2","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#selectorloop-mechanics","content":"SelectorLoop mechanics"},"4680":{"id":"/wiki/booblik-net/transport-3","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#selectorconnection-and-suspension","content":"SelectorConnection and suspension"},"4681":{"id":"/wiki/booblik-net/transport-4","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#blockingconnection-and-virtual-threads","content":"BlockingConnection and virtual threads"},"4682":{"id":"/wiki/booblik-net/transport-5","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#partialframe-assembly","content":"PartialFrame assembly"},"4683":{"id":"/wiki/booblik-net/transport-6","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#connection-failure-and-frame-corruption","content":"Connection failure and frame corruption"},"4684":{"id":"/wiki/booblik-net/transport-7","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#key-files","content":"Key files"},"4685":{"id":"/wiki/booblik-net/transport-8","page_id":"/wiki/booblik-net/transport","type":"heading","tags":[],"url":"/wiki/booblik-net/transport#behaviour-that-surprises","content":"Behaviour that surprises"},"4686":{"id":"/wiki/booblik-net/transport-9","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"4687":{"id":"/wiki/booblik-net/transport-10","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"The server supports two distinct transport mechanisms, which are configured via `ServerConfig` in `BooblikServer.kt:45-64`."},"4688":{"id":"/wiki/booblik-net/transport-11","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"Mode"},"4689":{"id":"/wiki/booblik-net/transport-12","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"Mechanism"},"4690":{"id":"/wiki/booblik-net/transport-13","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"Implementation"},"4691":{"id":"/wiki/booblik-net/transport-14","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"`SELECTOR`"},"4692":{"id":"/wiki/booblik-net/transport-15","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"Non-blocking NIO with a dedicated selector thread and coroutine suspension."},"4693":{"id":"/wiki/booblik-net/transport-16","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"`SelectorConnection`"},"4694":{"id":"/wiki/booblik-net/transport-17","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"`VIRTUAL_THREADS`"},"4695":{"id":"/wiki/booblik-net/transport-18","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"Blocking sockets where each session runs on a virtual thread."},"4696":{"id":"/wiki/booblik-net/transport-19","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#transport-modes","content":"`BlockingConnection`"},"4697":{"id":"/wiki/booblik-net/transport-20","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#selectorloop-mechanics","content":"The `SelectorLoop` is the engine that turns NIO readiness into coroutine suspension. It operates on a dedicated thread to avoid deadlocks during `SelectionKey.register` calls on certain JDK implementations (`SelectorLoop.kt:48-55`)."},"4698":{"id":"/wiki/booblik-net/transport-21","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#selectorloop-mechanics","content":"To ensure thread safety, interest changes are not applied directly from other threads. Instead, they are posted to a `ConcurrentLinkedQueue` and applied by the loop thread itself (`SelectorLoop.kt:94-96`). Every change triggers a `selector.wakeup()` to ensure the loop processes the pending actions immediately (`SelectorLoop.kt:95-96`)."},"4699":{"id":"/wiki/booblik-net/transport-22","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#selectorconnection-and-suspension","content":"`SelectorConnection` implements the `Connection` interface by using the `SelectorLoop` to suspend coroutines when I/O is not ready. When `readFully` or `writeFully` encounters a zero-byte operation, it calls `loop.awaitReadable(key)` or `loop.awaitWritable(key)` (`Connection.kt:65-75`). This suspends the session coroutine, freeing up the thread until the `SelectorLoop` detects readiness and resumes the `CancellableContinuation` (`SelectorLoop.kt:80-81`)."},"4700":{"id":"/wiki/booblik-net/transport-23","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#blockingconnection-and-virtual-threads","content":"`BlockingConnection` serves as the baseline for performance measurements (`Connection.kt:100-102`). While virtual threads make blocking code efficient, they do not virtualize disk I/O. Consequently, a `transferTo` call that triggers a page fault can pin the carrier thread to the disk, potentially stalling the executor (`Connection.kt:104-106`)."},"4701":{"id":"/wiki/booblik-net/transport-24","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#partialframe-assembly","content":"The protocol requires full frames to be assembled from the stream. The `PartialFrameTest` verifies that the selector correctly handles frames split across multiple packets (`PartialFrameTest.kt:40-56`) and even frames delivered one byte at a time (`PartialFrameTest.kt:66-76`). This ensures the `SelectorConnection` correctly waits for more data via `loop.awaitReadable` when a `read` returns zero (`Connection.kt:66`)."},"4702":{"id":"/wiki/booblik-net/transport-25","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#connection-failure-and-frame-corruption","content":"The server is designed to be resilient to malformed data. If a client sends an unserviceable request (e.g., an unsupported version), the broker responds with an `ErrorCode` but keeps the connection alive (`PartialFrameTest.kt:80-109`). However, an \"absurd\" frame length—such as a request claiming a massive size—is treated as a fatal error that drops the connection to protect the broker's memory (`PartialFrameTest.kt:112-129`)."},"4703":{"id":"/wiki/booblik-net/transport-26","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"File"},"4704":{"id":"/wiki/booblik-net/transport-27","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"Lines"},"4705":{"id":"/wiki/booblik-net/transport-28","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"What is there"},"4706":{"id":"/wiki/booblik-net/transport-29","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`…/net/BooblikServer.kt`"},"4707":{"id":"/wiki/booblik-net/transport-30","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`25-34`"},"4708":{"id":"/wiki/booblik-net/transport-31","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`Transport` enum defining the two execution models."},"4709":{"id":"/wiki/booblik-net/transport-32","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`…/nio/Connection.kt`"},"4710":{"id":"/wiki/booblik-net/transport-33","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`55-142`"},"4711":{"id":"/wiki/booblik-net/transport-34","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`Connection` interface and its two implementations."},"4712":{"id":"/wiki/booblik-net/transport-35","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`…/nio/SelectorLoop.kt`"},"4713":{"id":"/wiki/booblik-net/transport-36","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`31-41`"},"4714":{"id":"/wiki/booblik-net/transport-37","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"The dedicated thread and management of the `Selector`."},"4715":{"id":"/wiki/booblik-net/transport-38","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`…/net/PartialFrameTest.kt`"},"4716":{"id":"/wiki/booblik-net/transport-39","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"`29-175`"},"4717":{"id":"/wiki/booblik-net/transport-40","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#key-files","content":"Tests for split packets and frame assembly."},"4718":{"id":"/wiki/booblik-net/transport-41","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#behaviour-that-surprises","content":"**Interest changes are asynchronous:** Because `SelectionKey.interestOps` can block or be ineffective during a `select()` call, `SelectorLoop` must queue changes and use `selector.wakeup()` to apply them safely (`SelectorLoop.kt:26-28`)."},"4719":{"id":"/wiki/booblik-net/transport-42","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#behaviour-that-surprises","content":"**Disk I/O pins carrier threads:** Even when using virtual threads, `BlockingConnection` can cause a carrier thread to stall if `transferTo` encounters a page fault during disk I/O (`Connection.kt:104-106`)."},"4720":{"id":"/wiki/booblik-net/transport-43","page_id":"/wiki/booblik-net/transport","tags":[],"type":"text","url":"/wiki/booblik-net/transport#behaviour-that-surprises","content":"**Zero-copy requires the raw channel:** Wrapping a `SocketChannel` in a decorator can silently turn a `sendfile` path into a copy loop, making `transferTarget` a critical property for performance (`Connection.kt:28-30`)."},"4721":{"id":"/wiki/booblik-native/booblikconnection","page_id":"/wiki/booblik-native/booblikconnection","type":"page","content":"BooblikConnection","breadcrumbs":["Docs","Wiki","booblik-native"],"tags":[],"url":"/wiki/booblik-native/booblikconnection"},"4722":{"id":"/wiki/booblik-native/booblikconnection-0","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#diagram","content":"Diagram"},"4723":{"id":"/wiki/booblik-native/booblikconnection-1","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#booblikconnection","content":"BooblikConnection"},"4724":{"id":"/wiki/booblik-native/booblikconnection-2","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#the-correlationid-matching-mechanism","content":"The correlationId matching mechanism"},"4725":{"id":"/wiki/booblik-native/booblikconnection-3","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#ackpolicynone-behavior","content":"AckPolicy.NONE behavior"},"4726":{"id":"/wiki/booblik-native/booblikconnection-4","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Topic and Partition routing"},"4727":{"id":"/wiki/booblik-native/booblikconnection-5","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#frame-assembly-and-partial-reads","content":"Frame assembly and partial reads"},"4728":{"id":"/wiki/booblik-native/booblikconnection-6","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#connection-failure-and-error-handling","content":"Connection failure and error handling"},"4729":{"id":"/wiki/booblik-native/booblikconnection-7","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#key-files","content":"Key files"},"4730":{"id":"/wiki/booblik-native/booblikconnection-8","page_id":"/wiki/booblik-native/booblikconnection","type":"heading","tags":[],"url":"/wiki/booblik-native/booblikconnection#behaviour-that-inspires","content":"Behaviour that inspires"},"4731":{"id":"/wiki/booblik-native/booblikconnection-9","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4732":{"id":"/wiki/booblik-native/booblikconnection-10","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#booblikconnection","content":"The `BooblikConnection` class provides a blocking, synchronous connection to a single broker using POSIX sockets via `Socket.kt:33`. It is designed to be non-thread-safe because requests and responses are matched by a correlation ID in the order they were sent, meaning two callers sharing a connection would read each other's answers (`Connection.kt:23-24`)."},"4733":{"id":"/wiki/booblik-native/booblikconnection-11","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#the-correlationid-matching-mechanism","content":"To ensure data integrity in a pipelined environment, the connection uses a `correlationId` that is incremented for every request (`BooblikConnection.kt:108`). Because the broker is guaranteed to answer in strict FIFO order, the client uses a `ConcurrentLinkedQueue` of `Pending` objects to match responses to their original callers (`BooblikConnection.kt:60`). If a response arrives with a correlation ID that does not match the head of the queue, the client fails loudly to prevent delivering the wrong data to a caller (`BooblikConnection.kt:35-37`)."},"4734":{"id":"/wiki/booblik-native/booblikconnection-12","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#ackpolicynone-behavior","content":"When using `AckPolicy.NONE`, the `produce` function returns `null` immediately (`Connection.kt:59`). This is because no response is expected from the broker, and since no offset exists until the writer actually reaches the batch on the broker side, there is no answer to wait for (`Connection.kt:44-45`). In this mode, the request is enqueued to the outbound channel but no `Pending` object is registered to wait for a result (`BooblikConnection.kt:111`)."},"4735":{"id":"/wiki/booblik-native/booblikconnection-13","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Routing is handled through the `Topic` class, which resolves partitions using metadata fetched from the broker (`Connection.kt:145`). Partition selection follows these rules:"},"4736":{"id":"/wiki/booblik-native/booblikconnection-14","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Key Type"},"4737":{"id":"/wiki/booblik-native/booblikconnection-15","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Logic"},"4738":{"id":"/wiki/booblik-native/booblikconnection-16","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"`null`"},"4739":{"id":"/wiki/booblik-native/booblikconnection-17","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Round-robin selection where the counter advances on every call (`Connection.kt:192-193`)"},"4740":{"id":"/wiki/booblik-native/booblikconnection-18","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"`ByteArray`"},"4741":{"id":"/wiki/booblik-native/booblikconnection-19","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#topic-and-partition-routing","content":"Deterministic selection via `Partitioner.Fnv1a` (`Connection.kt:196`)"},"4742":{"id":"/wiki/booblik-native/booblikconnection-20","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#frame-assembly-and-partial-reads","content":"The client is designed to handle fragmented network traffic where a single frame might arrive across multiple packets. The `readFrame` function in `Socket.kt:123` first reads a length prefix and then continues to call `recv` until the exact number of bytes requested is received (`Socket.kt:137-140`). Tests in `PartialFrameTest.kt:40-60` verify that frames split across two packets or even delivered one byte at a time are correctly assembled into a single request."},"4743":{"id":"/wiki/booblik-native/booblikconnection-21","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#connection-failure-and-error-handling","content":"The connection lifecycle includes several error states:"},"4744":{"id":"/wiki/booblik-native/booblikconnection-22","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#connection-failure-and-error-handling","content":"**Absurd Frame Lengths**: If a broker sends a frame length exceeding `Protocol.MAX_FRAME_BYTES`, a `ConnectionException` is thrown to prevent massive memory allocations (`Connection.kt:168-170`)."},"4745":{"id":"/wiki/booblik-native/booblikconnection-23","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#connection-failure-and-error-handling","content":"**Unknown API Keys**: If a header is valid but the API key is unknown, the broker responds with `UNSUPPORTED_VERSION` while still echoing the `correlationId` (`ErrorCodeTest.kt:37-39`)."},"4746":{"id":"/wiki/booblik-native/booblikconnection-24","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#connection-failure-and-error-handling","content":"**Socket Closures**: If the socket closes mid-frame, the client throws a `ConnectionException` indicating how many bytes were still expected (`Socket.kt:137-138`)."},"4747":{"id":"/wiki/booblik-native/booblikconnection-25","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"File"},"4748":{"id":"/wiki/booblik-native/booblikconnection-26","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"Lines"},"4749":{"id":"/wiki/booblik-native/booblikconnection-27","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"What is there"},"4750":{"id":"/wiki/booblik-native/booblikconnection-28","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`…/native/Connection.kt`"},"4751":{"id":"/wiki/booblik-native/booblikconnection-29","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`30-156`"},"4752":{"id":"/wiki/booblik-native/booblikconnection-30","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"The `BooblikConnection` class implementing the synchronous protocol."},"4753":{"id":"/wiki/booblik-native/booblikconnection-31","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`…/client/BooblikConnection.kt`"},"4754":{"id":"/wiki/booblik-native/booblikconnection-32","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`50-241`"},"4755":{"id":"/wiki/booblik-native/booblikconnection-33","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"The pipelined, coroutine-based `BooblikConnection` implementation."},"4756":{"id":"/wiki/booblik-native/booblikconnection-34","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`…/native/Socket.kt`"},"4757":{"id":"/wiki/booblik-native/booblikconnection-35","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"`42-148`"},"4758":{"id":"/wiki/booblik-native/booblikconnection-36","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#key-files","content":"The POSIX `Socket` wrapper for low-level `send` and `recv` operations."},"4759":{"id":"/wiki/booblik-native/booblikconnection-37","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#behaviour-that-inspires","content":"`Topic.partitionFor(null)`: Calling this with a null key advances the internal `roundRobin` counter, meaning that even just \"asking\" for a partition can change the result of the next call (`Connection.kt:192-193`)."},"4760":{"id":"/wiki/booblik-native/booblikconnection-38","page_id":"/wiki/booblik-native/booblikconnection","tags":[],"type":"text","url":"/wiki/booblik-native/booblikconnection#behaviour-that-inspires","content":"`BooblikConnection.produce`: When `ackPolicy` is `AckPolicy.NONE`, the function returns `null` instead of an empty result, because no offset exists until the batch is written (`Connection.kt:59`)."},"4761":{"id":"/wiki/booblik-native","page_id":"/wiki/booblik-native","type":"page","content":"booblik-native","breadcrumbs":["Docs","Wiki","booblik-native"],"tags":[],"url":"/wiki/booblik-native"},"4762":{"id":"/wiki/booblik-native-0","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#diagram","content":"Diagram"},"4763":{"id":"/wiki/booblik-native-1","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#booblikconnection","content":"BooblikConnection"},"4764":{"id":"/wiki/booblik-native-2","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#socket","content":"Socket"},"4765":{"id":"/wiki/booblik-native-3","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#producer","content":"Producer"},"4766":{"id":"/wiki/booblik-native-4","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#consumer","content":"Consumer"},"4767":{"id":"/wiki/booblik-native-5","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#topic","content":"Topic"},"4768":{"id":"/wiki/booblik-native-6","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#key-files","content":"Key files"},"4769":{"id":"/wiki/booblik-native-7","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#public-api","content":"Public API"},"4770":{"id":"/wiki/booblik-native-8","page_id":"/wiki/booblik-native","type":"heading","tags":[],"url":"/wiki/booblik-native#behaviour-that-surprises","content":"Behaviour that surprises"},"4771":{"id":"/wiki/booblik-native-9","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 5. Edit the code or the hand-written documentation instead."},"4772":{"id":"/wiki/booblik-native-10","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#booblikconnection","content":"The core connection to a broker over a blocking POSIX socket, managing correlation IDs and frame decoding (`booblik-native/src/nativeMain/kotlin/ru/workinprogress/booblik/native/Connection.kt:30-35, 158-172`). It ensures that responses are matched to the correct requests via correlation IDs (`Connection.kt:34-35`) and handles the decoding of protocol frames (`Connection.kt:158-172`)."},"4773":{"id":"/wiki/booblik-native-11","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#booblikconnection","content":"More: BooblikConnection"},"4774":{"id":"/wiki/booblik-native-12","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#socket","content":"Low-level POSIX socket implementation providing blocking read and write operations (`booblik-native/src/nativeMain/kotlin/ru/workinprogress/booblik/native/Socket.kt:105-143, 146-147`). It uses `getaddrinfo` to resolve hostnames and handles the raw byte transfer via `send` and `recv` (`Socket.kt:60-70`)."},"4775":{"id":"/wiki/booblik-native-13","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#socket","content":"More: Socket"},"4776":{"id":"/wiki/booblik-native-14","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#producer","content":"An accumulator that batches records by partition and uses a single-threaded dispatcher to manage asynchronous sending (`Producer.kt:80-177`). It uses a `mailbox` to receive commands and a `runLoop` to manage the timing of batch flushes (`Producer.kt:81-177`)."},"4777":{"id":"/wiki/booblik-native-15","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#producer","content":"More: Producer"},"4778":{"id":"/wiki/booblik-native-16","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#consumer","content":"A blocking reader for a specific topic and partition, managing position and high watermark tracking (`Consumer.kt:56-143`). It provides a `Sequence` of records by repeatedly calling `poll` (`Consumer.kt:135-140`)."},"4779":{"id":"/wiki/booblik-native-17","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#topic","content":"A high-level handle for a topic that provides partition selection via round-robin or key-based partitioning (`Connection.kt:176-197`). It allows users to find the correct partition for a given key using a partitioner (`Connection.kt:190-197`)."},"4780":{"id":"/wiki/booblik-native-18","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"File"},"4781":{"id":"/wiki/booblik-native-19","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"Lines"},"4782":{"id":"/wiki/booblik-native-20","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"What is there"},"4783":{"id":"/wiki/booblik-native-21","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`…/native/Socket.kt`"},"4784":{"id":"/wiki/booblik-native-22","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`42-83`"},"4785":{"id":"/wiki/booblik-native-23","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"The `Socket` companion object containing the `connect` logic."},"4786":{"id":"/wiki/booblik-native-24","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`…/native/Consumer.kt`"},"4787":{"id":"/wiki/booblik-native-25","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`56-143`"},"4788":{"id":"/wiki/booblik-native-26","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"The `Consumer` class implementation."},"4789":{"id":"/wiki/booblik-native-27","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`…/native/Producer.kt`"},"4790":{"id":"/wiki/booblik-native-28","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`75-275`"},"4791":{"id":"/wiki/booblik-native-29","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"The `Producer` class and its internal `Command` and `Batch` structures."},"4792":{"id":"/wiki/booblik-native-30","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`…/native/Connection.kt`"},"4793":{"id":"/wiki/booblik-native-31","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"`30-207`"},"4794":{"id":"/wiki/booblik-native-32","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#key-files","content":"The `BooblikConnection` and `Topic` classes."},"4795":{"id":"/wiki/booblik-native-33","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"What"},"4796":{"id":"/wiki/booblik-native-34","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"Where"},"4797":{"id":"/wiki/booblik-native-35","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"Why"},"4798":{"id":"/wiki/booblik-native-36","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Consumer`"},"4799":{"id":"/wiki/booblik-native-37","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Consumer.kt:56`"},"4800":{"id":"/wiki/booblik-native-38","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"To read records from a specific topic and partition."},"4801":{"id":"/wiki/booblik-native-39","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Producer`"},"4802":{"id":"/wiki/booblik-native-40","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Producer.kt:75`"},"4803":{"id":"/wiki/booblik-native-41","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"To accumulate and send records in batches."},"4804":{"id":"/wiki/booblik-native-42","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`BooblikConnection`"},"4805":{"id":"/wiki/booblik-native-43","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Connection.kt:30`"},"4806":{"id":"/wiki/booblik-native-44","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"To manage the underlying socket and protocol communication."},"4807":{"id":"/wiki/booblik-native-45","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Topic`"},"4808":{"id":"/wiki/booblik-native-46","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"`Connection.kt:176`"},"4809":{"id":"/wiki/booblik-native-47","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#public-api","content":"To interact with a specific topic and its partitions."},"4810":{"id":"/wiki/booblik-native-48","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#behaviour-that-surprises","content":"The `Producer` uses a `newSingleThreadContext` because `Dispatchers.IO` is `internal` on Kotlin/Native, meaning the producer must own its own thread to avoid blocking core-limited dispatchers (`Producer.kt:80`)."},"4811":{"id":"/wiki/booblik-native-49","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#behaviour-that-surprises","content":"The `Consumer.poll` function advances the `position` only after whole records are fetched; if a response is truncated due to `maxBytes`, the partial tail is dropped and the next poll starts from the beginning of that record (`Consumer.kt:105-108`)."},"4812":{"id":"/wiki/booblik-native-50","page_id":"/wiki/booblik-native","tags":[],"type":"text","url":"/wiki/booblik-native#behaviour-that-surprises","content":"`BooblikConnection.produce` returns `null` when `AckPolicy.NONE` is used, as no offset is available to report (`Connection.kt:59`)."},"4813":{"id":"/wiki/booblik-native/producer","page_id":"/wiki/booblik-native/producer","type":"page","content":"Producer","breadcrumbs":["Docs","Wiki","booblik-native"],"tags":[],"url":"/wiki/booblik-native/producer"},"4814":{"id":"/wiki/booblik-native/producer-0","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#what-this-module-is-responsible-for","content":"What this module is responsible for"},"4815":{"id":"/wiki/booblik-native/producer-1","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#diagram","content":"Diagram"},"4816":{"id":"/wiki/booblik-native/producer-2","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#the-accumulator-and-lingermillis","content":"The Accumulator and `lingerMillis`"},"4817":{"id":"/wiki/booblik-native/producer-3","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#the-runloop-and-select-mechanism","content":"The `runLoop` and `select` mechanism"},"4818":{"id":"/wiki/booblik-native/producer-4","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#the-batch-function-and-contiguous-offsets","content":"The `batch` function and contiguous offsets"},"4819":{"id":"/wiki/booblik-native/producer-5","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#lifecycle-and-drainpending","content":"Lifecycle and `drainPending`"},"4820":{"id":"/wiki/booblik-native/producer-6","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#failure-modes-and-producefailedexception","content":"Failure modes and `ProduceFailedException`"},"4821":{"id":"/wiki/booblik-native/producer-7","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Performance modes: `DIRECT`, `BATCHED`, and `BATCHED_NOT_AWAITED`"},"4822":{"id":"/wiki/booblik-native/producer-8","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#testing-for-record-loss-in-the-accumulator","content":"Testing for record loss in the accumulator"},"4823":{"id":"/wiki/booblik-native/producer-9","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#key-files","content":"Key files"},"4824":{"id":"/wiki/booblik-native/producer-10","page_id":"/wiki/booblik-native/producer","type":"heading","tags":[],"url":"/wiki/booblik-native/producer#behaviour-that-surprising","content":"Behaviour that surprising"},"4825":{"id":"/wiki/booblik-native/producer-11","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4826":{"id":"/wiki/booblik-native/producer-12","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#what-this-module-is-responsible-for","content":"The `Producer` is responsible for accumulating individual records into batches organized by partition to maximize throughput. Instead of sending every record as a separate network request, it uses an internal accumulator to group records, significantly reducing the overhead of the broker's write path `Producer.kt:39-42`."},"4827":{"id":"/wiki/booblik-native/producer-13","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#the-accumulator-and-lingermillis","content":"The core of the producer is the accumulation of records into `Batch` objects, grouped by a `Key` consisting of a topic and a partition `Producer.kt:70-71`. The timing logic is designed to prevent indefinite delays: the window for a batch is determined by the arrival of the *first* record in that batch, using `config.lingerMillis` to set a deadline `Producer.kt:139-141`. This ensures that a steady trickle of records cannot postpone a send indefinitely, which would turn a latency bound into a \"latency hope\" `Producer.kt:137-138`."},"4828":{"id":"/wiki/booblik-native/producer-14","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#the-runloop-and-select-mechanism","content":"The `runLoop` is the internal execution loop that processes commands from the `mailbox` channel `Producer.kt:129-131`. To avoid a critical bug where a cancelled receive might swallow a record and leave a caller hanging forever, the loop uses a `select` expression `Producer.kt:154-158`. This ensures that the `select` either takes the element from the channel or takes the timeout, but never both and never neither, preventing the \"lost record\" scenario `Producer.kt:153`."},"4829":{"id":"/wiki/booblik-native/producer-15","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#the-batch-function-and-contiguous-offsets","content":"For use cases requiring strict atomicity and contiguity, the `batch` function allows callers to bypass the accumulator entirely `Publishing.kt:85-90`. This function ensures that the records provided in the block are sent as a single request, guaranteeing that the resulting offsets are contiguous (e.g., `base`, `base + 1`, etc.) `Publishing.kt:98`."},"4830":{"id":"/wiki/booblik-native/producer-16","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#lifecycle-and-drainpending","content":"When `close()` is called, the producer shuts down the `mailbox` and the underlying `dispatcher` `Producer.kt:124-127`. To prevent silent data loss, the `drainPending` function is called in a `finally` block `Producer.kt:88-90`. This function ensures that any records remaining in the `mailbox` or the `pending` map are either sent or completed with an exception `Producer.kt:227-244`."},"4831":{"id":"/wiki/booblik-native/producer-17","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#failure-modes-and-producefailedexception","content":"If the broker returns an error code other than `ErrorCode.NONE`, the producer propagates this failure to all callers in the batch `Producer.kt:219-222`. This is handled by completing the `CompletableDeferred` handles with a `ProduceFailedException` `Producer.kt:209-211`."},"4832":{"id":"/wiki/booblik-native/producer-18","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"The impact of the accumulator is measured using three distinct execution patterns `Probe.kt:79-93`:"},"4833":{"id":"/wiki/booblik-native/producer-19","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Mode"},"4834":{"id":"/wiki/booblik-native/producer-20","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Description"},"4835":{"id":"/wiki/booblik-native/producer-21","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"`DIRECT`"},"4836":{"id":"/wiki/booblik-native/producer-22","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Every record is its own request, awaited before the next."},"4837":{"id":"/wiki/booblik-native/producer-23","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"`BATCHED`"},"4838":{"id":"/wiki/booblik-native/producer-24","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Through the accumulator, with records awaited before the next."},"4839":{"id":"/wiki/booblik-native/producer-25","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"`BATCHED_NOT_AWAITED`"},"4840":{"id":"/wiki/booblik-native/producer-26","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#performance-modes-direct-batched-and-batched_not_awaited","content":"Through the accumulator, with all records queued before awaiting the results."},"4841":{"id":"/wiki/booblik-native/producer-27","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#testing-for-record-loss-in-the-accumulator","content":"The producer's reliability is verified by `ProducerLostRecordTest`, which simulates a high-collision environment `ProducerLostRecordTest.kt:41-48`. The test specifically drives two different topics at different rates through a single producer to ensure that the `select` mechanism and the `runLoop` do not drop records when a timeout and a new record arrival collide `ProducerLostRecordTest.kt:52-58`."},"4842":{"id":"/wiki/booblik-native/producer-28","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"File"},"4843":{"id":"/wiki/booblik-native/producer-29","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"Lines"},"4844":{"id":"/wiki/booblik-native/producer-30","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"What is there"},"4845":{"id":"/wiki/booblik-native/producer-31","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`…/native/Producer.kt`"},"4846":{"id":"/wiki/booblik-native/producer-32","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`25-36`"},"4847":{"id":"/wiki/booblik-native/producer-33","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`ProducerConfig` definition"},"4848":{"id":"/wiki/booblik-native/producer-34","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`…/client/Producer.kt`"},"4849":{"id":"/wiki/booblik-native/producer-35","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`54-58`"},"4850":{"id":"/wiki/booblik-native/producer-36","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`Producer` class declaration"},"4851":{"id":"/wiki/booblik-native/producer-37","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`…/client/Publishing.kt`"},"4852":{"id":"/wiki/booblik-native/producer-38","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`85-90`"},"4853":{"id":"/wiki/booblik-native/producer-39","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`batch` extension function"},"4854":{"id":"/wiki/booblik-native/producer-40","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`…/conformance/Probe.kt`"},"4855":{"id":"/wiki/booblik-native/producer-41","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`79-93`"},"4856":{"id":"/wiki/booblik-native/producer-42","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#key-files","content":"`Mode` enum definition"},"4857":{"id":"/wiki/booblik-native/producer-43","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#behaviour-that-surprising","content":"The `lingerMillis` timer is reset only at the start of a batch, not on every new record arrival `Producer.kt:137-138`."},"4858":{"id":"/wiki/booblik-native/producer-44","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#behaviour-that-surprising","content":"`newSingleThreadContext` is considered a \"delicate API\" because the thread it creates must be manually closed via `close()` to avoid leaking the thread `Producer.kt:49-51`."},"4859":{"id":"/wiki/booblik-native/producer-45","page_id":"/wiki/booblik-native/producer","tags":[],"type":"text","url":"/wiki/booblik-native/producer#behaviour-that-surprising","content":"In `Producer.kt:205`, `AckPolicy.NONE` results in an `Offset.ZERO` being returned to the caller to represent that the batch was sent."},"4860":{"id":"/wiki/booblik-native/socket","page_id":"/wiki/booblik-native/socket","type":"page","content":"Socket","breadcrumbs":["Docs","Wiki","booblik-native"],"tags":[],"url":"/wiki/booblik-native/socket"},"4861":{"id":"/wiki/booblik-native/socket-0","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#what-this-module-is-responsible-for","content":"What this module is responsible for"},"4862":{"id":"/wiki/booblik-native/socket-1","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#diagram","content":"Diagram"},"4863":{"id":"/wiki/booblik-native/socket-2","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#socket-lifecycle-and-connection-establishment","content":"Socket lifecycle and connection establishment"},"4864":{"id":"/wiki/booblik-native/socket-3","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#tcp_nodelay-and-nagles-algorithm","content":"TCP_NODELAY and Nagle's algorithm"},"4865":{"id":"/wiki/booblik-native/socket-4","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#writefully-and-send-mechanics","content":"writeFully and send mechanics"},"4866":{"id":"/wiki/booblik-native/socket-5","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#readfully-and-connection-termination","content":"readFully and connection termination"},"4867":{"id":"/wiki/booblik-native/socket-6","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#socket-close","content":"Socket close"},"4868":{"id":"/wiki/booblik-native/socket-7","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#key-files","content":"Key files"},"4869":{"id":"/wiki/booblik-native/socket-8","page_id":"/wiki/booblik-native/socket","type":"heading","tags":[],"url":"/wiki/booblik-native/socket#behaviour-that-surprise","content":"Behaviour that surprise"},"4870":{"id":"/wiki/booblik-native/socket-9","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4871":{"id":"/wiki/booblik-native/socket-10","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#what-this-module-is-responsible-for","content":"The `Socket` class in the `booblik-native` module provides a low-level, blocking TCP implementation using POSIX primitives. It serves as the foundation for native clients, handling the raw mechanics of host resolution, connection establishment, and reliable byte transmission."},"4872":{"id":"/wiki/booblik-native/socket-11","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#socket-lifecycle-and-connection-establishment","content":"The connection process begins with the `connect` factory method, which parses the input string to separate the host from the port (`Socket.kt:46-50`). To ensure cross-platform compatibility between Linux and macOS, the implementation uses `getaddrinfo` to resolve addresses, which allows it to handle both host names and dotted quads while abstracting away differences in `sockaddr` layouts (`Socket.kt:36-39`). The instantiation process involves iterating through the linked list of `addrinfo` candidates provided by `getaddrinfo`, attempting to create a socket and connect until a successful descriptor is obtained (`Socket.kt:65-72`)."},"4873":{"id":"/wiki/booblik-native/socket-12","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#tcp_nodelay-and-nagles-algorithm","content":"To optimize performance for the specific traffic pattern of the protocol, the `enableNoDelay` method is called immediately after a successful connection (`Socket.kt:71`). This method uses `setsockopt` with the `TCP_NODELAY` flag to disable Nagle's algorithm (`Socket.kt:94-98`). This is critical because the requests are small and involve round trips; failing to set this would cause Nagle's algorithm to add unnecessary delays to each request-response cycle (`Socket.kt:86-88`)."},"4874":{"id":"/wiki/booblik-native/socket-13","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#writefully-and-send-mechanics","content":"The `writeFully` method ensures that a `ByteArray` is completely transmitted over the wire by using a loop that tracks the number of bytes written (`Socket.kt:107-108`). Inside this loop, the `send` function is called repeatedly with the remaining buffer length until the entire payload is sent (`Socket.kt:110-113`). If `send` returns a value less than or equal to zero, a `ConnectionException` is thrown, indicating the connection was closed during the transmission (`Socket.kt:116`)."},"4875":{"id":"/wiki/booblik-native/socket-14","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#readfully-and-connection-termination","content":"The `readFully` method implements a loop to fill a `ByteArray` of a specific size using the `recv` function (`Socket.kt:126-127`). A critical edge case occurs when `recv` returns zero, which signifies that the broker has performed an orderly close of the connection (`Socket.kt:134-135`). In such cases, if the requested number of bytes has not been fully received, a `ConnectionException` is thrown because the caller did not receive the full frame it expected (`Socket.kt:136-137`)."},"4876":{"id":"/wiki/booblik-native/socket-15","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#socket-close","content":"The `close` method is responsible for the final stage of the socket lifecycle by releasing the underlying system resource (`Socket.kt:145-146`). It calls the POSIX `close` function on the stored file descriptor to ensure the socket is properly released back to the operating system (`Socket.kt:146`)."},"4877":{"id":"/wiki/booblik-native/socket-16","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"File"},"4878":{"id":"/wiki/booblik-native/socket-17","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"Lines"},"4879":{"id":"/wiki/booblik-native/socket-18","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"What is there"},"4880":{"id":"/wiki/booblik-native/socket-19","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`…/native/Socket.kt`"},"4881":{"id":"/wiki/booblik-native/socket-20","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`42-44`"},"4882":{"id":"/wiki/booblik-native/socket-21","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"The `Socket` class declaration and its private constructor."},"4883":{"id":"/wiki/booblik-native/socket-22","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`…/native/Socket.kt`"},"4884":{"id":"/wiki/booblik-native/socket-23","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`46-83`"},"4885":{"id":"/wiki/booblik-native/socket-24","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"The `connect` companion object method and its logic."},"4886":{"id":"/wiki/booblik-native/socket-25","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`…/native/Socket.kt`"},"4887":{"id":"/wiki/booblik-native/socket-26","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`105-120`"},"4888":{"id":"/wiki/booblik-native/socket-27","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"The `writeFully` implementation for sending bytes."},"4889":{"id":"/wiki/booblik-native/socket-28","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`…/native/Socket.kt`"},"4890":{"id":"/wiki/booblik-native/socket-29","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"`122-143`"},"4891":{"id":"/wiki/booblik-native/socket-30","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#key-files","content":"The `readFully` implementation for receiving bytes."},"4892":{"id":"/wiki/booblik-native/socket-31","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#behaviour-that-surprise","content":"The `connect` method in `Socket` will throw a `ConnectionException` if it exhausts all `addrinfo` candidates without successfully establishing a connection (`Socket.kt:81`)."},"4893":{"id":"/wiki/booblik-native/socket-32","page_id":"/wiki/booblik-native/socket","tags":[],"type":"text","url":"/wiki/booblik-native/socket#behaviour-that-surprise","content":"In `readFully`, a return value of zero from `recv` is treated as a failure if the requested byte count has not been met, rather than being treated as a successful end-of-stream (`Socket.kt:136-137`)."},"4894":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"page","content":"Conformance Verbs","breadcrumbs":["Docs","Wiki","clients/dotnet/Booblik.Conformance"],"tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs"},"4895":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-0","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#diagram","content":"Diagram"},"4896":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-1","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-capabilities-verb","content":"The `capabilities` verb"},"4897":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-2","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-metadata-verb","content":"The `metadata` verb"},"4898":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-3","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"The `produce` verb and `AckPolicy`"},"4899":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-4","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-keyed-verb-and-partitioner-logic","content":"The `produce-keyed` verb and partitioner logic"},"4900":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-5","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-fetch-verb-and-record-truncation","content":"The `fetch` verb and record truncation"},"4901":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-6","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#broker-refusal-as-a-result","content":"Broker refusal as a result"},"4902":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-7","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"Key files"},"4903":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-8","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#behaviour-that-surprises","content":"Behaviour that surprises"},"4904":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-9","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"4905":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-10","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-capabilities-verb","content":"The initial handshake where the client declares its roles and name. The harness uses this to determine which verbs the client is allowed to execute, as seen in `client.py:100-108`. The client must respond with `roles` (a comma-separated list) and a `name` identifier, as implemented in `Program.cs:21-22`."},"4906":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-11","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-metadata-verb","content":"Retrieving partition information including log start offsets and high watermarks. The client requests metadata for a specific topic and iterates through the returned partition information to print the partition ID, the log start offset, and the high watermark, as demonstrated in `Program.cs:105-108`."},"4907":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-12","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Mechanics of record submission, the behavior of `AckPolicy.None` (returning immediately), and the handling of zero-length records. The `ack` parameter maps to specific policies:"},"4908":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-13","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Policy"},"4909":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-14","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Value"},"4910":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-15","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Behavior"},"4911":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-16","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`none`"},"4912":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-17","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`AckPolicy.None`"},"4913":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-18","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Client returns immediately; no response is expected from the broker (`Program.cs:121`)"},"4914":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-19","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`written`"},"4915":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-20","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`AckPolicy.Written`"},"4916":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-21","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Client awaits confirmation of the write (`Program.cs:122`)"},"4917":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-22","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`forced`"},"4918":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-23","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"`AckPolicy.Forced`"},"4919":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-24","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"Client awaits a stronger durability guarantee (`Program.cs:123`)"},"4920":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-25","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-verb-and-ackpolicy","content":"The harness specifically checks that `produce` with `none` does not wait for a response, as an empty field is treated as a zero-length record which the broker may refuse (`Program.cs:127-128`)."},"4921":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-26","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-produce-keyed-verb-and-partitioner-logic","content":"How the client-side partitioner selects a partition based on a key before the broker sees it, and validation against golden vectors. In this mode, the client performs the partitioning logic locally using the key, as seen in `Program.cs:152`. The correctness of this logic is validated by comparing the client's choice against \"golden vectors\" in `partition_test.go:18-36`."},"4922":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-27","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#the-fetch-verb-and-record-truncation","content":"Edge cases in fetching: handling truncated records when `maxBytes` is exceeded and empty responses at the high watermark. The client must handle cases where a record is larger than the requested `maxBytes`, resulting in a truncated response where `answer.Truncated` is true (`Program.cs:85-87`). It also handles empty responses when the fetch offset is at the high watermark (`Program.cs:85`)."},"4923":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-28","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#broker-refusal-as-a-result","content":"The distinction between program failure and a valid broker refusal (e.g., `error=CODE`), and how exit codes are used to signal success. A broker refusal is considered a valid result of a command, not a failure of the client program; in such cases, the client prints `error=CODE` and exits with code 0 (`Program.cs:61-65`). A non-zero exit code is reserved for actual program failures, such as unknown verbs or missing environment variables (`Program.cs:57-58`)."},"4924":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-29","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"File"},"4925":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-30","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"Lines"},"4926":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-31","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"What is there"},"4927":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-32","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`…/Booblik.Conformance/Program.cs`"},"4928":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-33","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`111-139`"},"4929":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-34","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"Implementation of the `Produce` verb and `AckPolicy` handling"},"4930":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-35","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`…/go/partition_test.go`"},"4931":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-36","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`17-46`"},"4932":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-37","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"Test verifying the partitioner against golden vectors"},"4933":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-38","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`…/harness/client.py`"},"4934":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-39","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"`100-108`"},"4935":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-40","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#key-files","content":"Logic for loading and validating client capabilities"},"4936":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-41","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#behaviour-that-surprises","content":"**Immediate Return**: When using `AckPolicy.None`, the client must not wait for a response from the broker; doing so causes a timeout in the harness (`Program.cs:133`)."},"4937":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-42","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#behaviour-that-surprises","content":"**Refusal vs. Failure**: A `BrokerException` is not a program error; the client must exit with `0` if the broker refuses a request, reporting the error via `stdout` instead (`Program.cs:63-64`)."},"4938":{"id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs-43","page_id":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/conformance-verbs#behaviour-that-surprises","content":"**Client-Side Partitioning**: In `produce-keyed`, the partition is chosen by the client using the key, meaning the broker never sees the key itself (`Program.cs:141-142`)."},"4939":{"id":"/wiki/clients-dotnet-Booblik.Conformance","page_id":"/wiki/clients-dotnet-Booblik.Conformance","type":"page","content":"clients/dotnet/Booblik.Conformance","breadcrumbs":["Docs","Wiki","clients/dotnet/Booblik.Conformance"],"tags":[],"url":"/wiki/clients-dotnet-Booblik.Conformance"},"4940":{"id":"/wiki/clients-dotnet-Booblik.