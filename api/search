hmarking-614","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"20 001 против 20 001, p99 109 против 140 мс"},"773":{"id":"/docs/benchmarking-615","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**100 000** против 84 415, p50 0,19 против 1 445 мс"},"774":{"id":"/docs/benchmarking-616","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Конвейер: глубина 1 → 4"},"775":{"id":"/docs/benchmarking-617","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"17 977 → 20 001"},"776":{"id":"/docs/benchmarking-618","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**60 380 → 100 001**"},"777":{"id":"/docs/benchmarking-619","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Выводы M3 и M4 подтвердились на обеих машинах и на Linux стали резче: селектор обгоняет\nвиртуальные потоки, конвейер глубины 4 забирает всё, что даёт конвейеризация."},"778":{"id":"/docs/benchmarking-620","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"Одна деталь видна только на маке: глубина 1024 даёт **p50 232 мс** против 2,0 мс у глубины 4 при\nтой же принятой нагрузке. Глубокая очередь не ускоряет, а копит — ещё один довод за «конвейер\nнужен неглубокий»."},"779":{"id":"/docs/benchmarking-621","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#104-сквозной-путь","content":"**M-35 на Linux:** до 4 ГиБ/с обе реализации принимают 100 % нагрузки; `ZERO_COPY` выигрывает\nхвостом (p99 16,4 против 27,2 мс). Насыщения не достигли — картина та же, что на маке, только\nграница дальше."},"780":{"id":"/docs/benchmarking-622","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Замер 1 отвечал на этот вопрос на маке и на слое хранения: там профиль оказался бесплатным.\nПовтор на Linux и на **сквозном пути**, где живёт вся аллокация сетевого слоя:"},"781":{"id":"/docs/benchmarking-623","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Нагрузка"},"782":{"id":"/docs/benchmarking-624","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Профиль"},"783":{"id":"/docs/benchmarking-625","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"Достигнуто"},"784":{"id":"/docs/benchmarking-626","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"p50"},"785":{"id":"/docs/benchmarking-627","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"p99"},"786":{"id":"/docs/benchmarking-628","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"GC"},"787":{"id":"/docs/benchmarking-629","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"100 000 зап/с"},"788":{"id":"/docs/benchmarking-630","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"64 МиБ, SerialGC"},"789":{"id":"/docs/benchmarking-631","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#105-во-что-обходится-профиль-на-20-ядрах","content":"100 000 (100 %)"},"790":{"id":"/docs/benchmarking-632","page_id":"/docs/benchmarking","tags":[],"type":"text","