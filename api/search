gs":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"30 000 зап/с"},"634":{"id":"/docs/benchmarking-476","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"1"},"635":{"id":"/docs/benchmarking-477","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"13 227 (44 %)"},"636":{"id":"/docs/benchmarking-478","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"4 238 мс"},"637":{"id":"/docs/benchmarking-479","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"8 309 мс"},"638":{"id":"/docs/benchmarking-480","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"4"},"639":{"id":"/docs/benchmarking-481","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"16 879 (56 %)"},"640":{"id":"/docs/benchmarking-482","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"3 607 мс"},"641":{"id":"/docs/benchmarking-483","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"6 501 мс"},"642":{"id":"/docs/benchmarking-484","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"16"},"643":{"id":"/docs/benchmarking-485","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"16 527 (55 %)"},"644":{"id":"/docs/benchmarking-486","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"3 372 мс"},"645":{"id":"/docs/benchmarking-487","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"6 686 мс"},"646":{"id":"/docs/benchmarking-488","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"1024"},"647":{"id":"/docs/benchmarking-489","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"**17 376** (58 %)"},"648":{"id":"/docs/benchmarking-490","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"3 563 мс"},"649":{"id":"/docs/benchmarking-491","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"6 707 мс"},"650":{"id":"/docs/benchmarking-492","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"Три разных ответа на трёх участках, и ни один из них не «конвейеризация ускоряет»:"},"651":{"id":"/docs/benchmarking-493","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"**На низкой нагрузке она не нужна и слегка вредит.** 0,70 против 0,93 мс: без очереди запрос\nпроходит напрямую, а конвейер добавляет собственный путь через канал."},"652":{"id":"/docs/benchmarking-494","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"**На средней нагрузке она покупает хвост, а не пропускную способность.** Обе глубины держат\n10 тысяч запросов в секунду, но p99 у «запрос-ответ» — 95 мс против 9,4 мс. У клиента без\nзапаса любая заминка брокера немедленно сдвигает следующий запрос: пропустить такт нечем."},"653":{"id":"/docs/benchmarking-495","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"**У насыщения она покупает пропускную способность — около 25–30 %.** И почти всё это даёт\n**глубина 4**: 16 879 против 17 376 у глубины 1024. Дальше — плоско."},"654":{"id":"/docs/benchmarking-496","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-9-m-44-чего-стоит-конвейеризация","content":"Вывод для клиента: конвейер нужен, но неглубокий. Держать тысячу запросов в полёте незачем —\nвыигрыш кончается на единицах, а память и время ответа на отмену растут."},"655":{"id":"/docs/benchmarking-497","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#контрольный-прогон-который-важнее-самой-таблицы","content":"Та же конфигурация, что в замере 8 (30 000 зап/с, `SELECTOR`, сегмент 128 МиБ, без ограничения\nглубины), в замере 8 дала **26 381** запрос в секунду, а здесь — **16 665**. Разница 37 %,\nи она не объясняется ни семафором, ни размером сегмента: контроль ставился именно чтобы это\nисключить."},"656":{"id":"/docs/benchmarking-498","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#контрольный-прогон-который-важнее-самой-таблицы","content":"Значит, состояние машины между сессиями изменилось — диск, заполненный на 94 % и принявший за\nэти прогоны десятки гигабайт, тепловой режим, page cache. Отсюда правило, которое до сих пор\nбыло предположением, а теперь показано:"},"657":{"id":"/docs/benchmarking-499","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#контрольный-прогон-который-важнее-самой-таблицы","content":"> **Сравнивать можно только прогоны одной сессии, идущие подряд.** Числа внутри одной таблицы\n> сопоставимы между собой; числа из разных замеров этого документа — нет, даже на одном хосте."},"658":{"id":"/docs/benchmarking-500","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#контрольный-прогон-который-важнее-самой-таблицы","content":"Поэтому таблица выше построена из прогонов, шедших один за другим, и выводы сделаны только по\nих относительным различиям. Потолок в 267 тысяч записей в секунду из замера 6 остаётся верным\nдля **того** прогона и не является характеристикой брокера навсегда."},"659":{"id":"/docs/benchmarking-501","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Весь набор прогнан заново подряд, на двух машинах, одной ревизией кода."},"660":{"id":"/docs/benchmarking-502","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"**mac**"},"661":{"id":"/docs/benchmarking-503","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"**linux**"},"662":{"id":"/docs/benchmarking-504","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Процессор"},"663":{"id":"/docs/benchmarking-505","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Apple M1, 8 ядер"},"664":{"id":"/docs/benchmarking-506","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"x86\\_64, 20 ядер"},"665":{"id":"/docs/benchmarking-507","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Память"},"666":{"id":"/docs/benchmarking-508","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"16 ГиБ"},"667":{"id":"/docs/benchmarking-509","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"23 ГиБ"},"668":{"id":"/docs/benchmarking-510","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"ФС"},"669":{"id":"/docs/benchmarking-511","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"APFS, диск занят на &#x2A;*94 %**"},"670":{"id":"/docs/benchmarking-512","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"ext4, занят на &#x2A;*4 %**"},"671":{"id":"/docs/benchmarking-513","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Прочее"},"672":{"id":"/docs/benchmarking-514","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"ноутбук, load average ≈ 2,5"},"673":{"id":"/docs/benchmarking-515","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"WSL2, простаивает"},"674":{"id":"/docs/benchmarking-516","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"JDK"},"675":{"id":"/docs/benchmarking-517","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"25.0.2"},"676":{"id":"/docs/benchmarking-518","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"25.0.4 (подтянут Gradle сам)"},"677":{"id":"/docs/benchmarking-519","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"Профиль рантайма одинаковый. Запуск на Linux — `ci/wsl-run.sh`; он сам находит\nлинуксовый `$HOME`, потому что сессия WSL стартует в `/mnt/c/...`, и первый прогон **уехал именно\nтуда** — на 9p поверх NTFS. Для проекта, который меряет диск, это не «немного медленнее», а другой\nпредмет измерения, поэтому скрипт теперь такой путь отвергает."},"678":{"id":"/docs/benchmarking-520","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-10-2026-08-10-перепрогон-на-двух-хостах-что-оказалось-свойством-macos","content":"> **Ни один из двух хостов не является чистым стендом, и это надо держать в голове при чтении\n> всего ниже.**\n>\n> Мак — рабочий ноутбук с диском, занятым на 94 %, и load average около 2,5; во время прогона\n> `probeSustainedWrite` он вообще перестал отвечать.\n>\n> «Linux» — это **WSL2**: ext4 на виртуальном диске поверх NTFS, ядро Microsoft, планировщик\n> ввода-вывода отключён, память отдаётся хостом динамически (ресёрч §1.12). Абсолютные числа\n> оттуда — числа WSL2. Про долговечность он не свидетельствует вовсе: дойдёт ли `fsync` до\n> носителя, решает Hyper-V.\n>\n> **Что отсюда всё-таки следует:** относительные сравнения внутри одного прогона — два пути\n> записи, два транспорта, две глубины конвейера — идут через один и тот же стек с обеих сторон\n> и потому осмысленны. Именно на них построены выводы. Настоящий стенд — bare-metal Linux\n> с NVMe, задача **M-46**."},"679":{"id":"/docs/benchmarking-521","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"**M-24: `msync` равносилен `fsync` на Linux и слабее на macOS — и это свойство API, а не ФС.**"},"680":{"id":"/docs/benchmarking-522","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Единственный вывод перепрогона, который **не зависит** от чистоты стенда: он подтверждён\nисходниками с обеих сторон (ресёрч §1.9). На Linux `msync(MS_SYNC)` вызывает `vfs_fsync_range` —\nту же функцию, что и `fsync` (`msync.c:96`). На macOS `fsync` до пластин не доводит вовсе,\nдля этого нужен `F_FULLFSYNC` — и JDK зовёт именно его\n(`FileDispatcherImpl.c:51`), а `msync` не зовёт."},"681":{"id":"/docs/benchmarking-523","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Хост"},"682":{"id":"/docs/benchmarking-524","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"`fsync`"},"683":{"id":"/docs/benchmarking-525","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"`msync`"},"684":{"id":"/docs/benchmarking-526","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"хвостовой `fsync` после `msync`"},"685":{"id":"/docs/benchmarking-527","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"вывод"},"686":{"id":"/docs/benchmarking-528","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"mac (APFS)"},"687":{"id":"/docs/benchmarking-529","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"8,81 мс"},"688":{"id":"/docs/benchmarking-530","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"13,96 мс"},"689":{"id":"/docs/benchmarking-531","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"**6,95 мс = 79 %**"},"690":{"id":"/docs/benchmarking-532","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"`msync` барьером не является"},"691":{"id":"/docs/benchmarking-533","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"linux (ext4)"},"692":{"id":"/docs/benchmarking-534","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"11,01 мс"},"693":{"id":"/docs/benchmarking-535","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"17,14 мс"},"694":{"id":"/docs/benchmarking-536","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"**0,21 мс = 2 %**"},"695":{"id":"/docs/benchmarking-537","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"`msync` уже сделал работу"},"696":{"id":"/docs/benchmarking-538","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Это ровно риск 4 ресёрча, сбывшийся буквально: «вывод переносится, проценты — нет» оказалось\nслишком мягкой формулировкой. Переносится **не** вывод, а метод. Решение кода при этом\nподтвердилось с двух сторон: `MappedSegmentWriter.force()` зовёт оба вызова, и это обязательно\nна APFS и почти бесплатно (0,21 мс) на ext4 — то есть портируемо."},"697":{"id":"/docs/benchmarking-539","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"**M-26: качели маппинга в WSL2 не воспроизвелись — но это не то же самое, что «их нет».**"},"698":{"id":"/docs/benchmarking-540","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Хост"},"699":{"id":"/docs/benchmarking-541","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Режим"},"700":{"id":"/docs/benchmarking-542","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Среднее"},"701":{"id":"/docs/benchmarking-543","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Худшая секунда"},"702":{"id":"/docs/benchmarking-544","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#101-два-вывода-проекта-оказались-свойствами-файловой-системы","content":"Лучшая/худшая"},"703":{"id":"/docs/benchmarking-545","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/ben