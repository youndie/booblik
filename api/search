chmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"268 129"},"501":{"id":"/docs/benchmarking-343","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"2 743 мс"},"502":{"id":"/docs/benchmarking-344","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"5 197 мс"},"503":{"id":"/docs/benchmarking-345","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"5 260 мс"},"504":{"id":"/docs/benchmarking-346","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"**Потолок — около 267 тысяч записей в секунду**, и это ровно потолок хранилища: JMH мерил\n`FILE_CHANNEL` в 213 тысяч записей в секунду на одиночных `append` (замер 2.1). Числа сходятся\nв пределах разницы методик. **Сетевой слой практически ничего не отнимает** — брокер упирается\nв лог, а не в сокет."},"505":{"id":"/docs/benchmarking-347","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-6-m-34-сквозной-путь-по-сокету","content":"Колено между 20 и 30 тысячами запросов в секунду: до него p50 держится в десятых долях\nмиллисекунды, после — уходит в секунды и предложенная нагрузка перестаёт приниматься. Ровно то,\nради чего замер открытый: закрытый цикл на 40 тысячах просто «достиг бы» 27 тысяч и показал бы\nприличную задержку, потому что сам перестал бы просить."},"506":{"id":"/docs/benchmarking-348","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"FETCH по 64 КиБ, `SELECTOR`, 8 соединений, 15 с. Тот же путь, отличается только тем, как тело\nответа попадает в сокет."},"507":{"id":"/docs/benchmarking-349","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"Нагрузка"},"508":{"id":"/docs/benchmarking-350","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"Режим"},"509":{"id":"/docs/benchmarking-351","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"Достигнуто"},"510":{"id":"/docs/benchmarking-352","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"p50"},"511":{"id":"/docs/benchmarking-353","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"p99"},"512":{"id":"/docs/benchmarking-354","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"2 000 зап/с (125 МиБ/с)"},"513":{"id":"/docs/benchmarking-355","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"`ZERO_COPY`"},"514":{"id":"/docs/benchmarking-356","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"100 %"},"515":{"id":"/docs/benchmarking-357","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"1,04 мс"},"516":{"id":"/docs/benchmarking-358","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"2,9 мс"},"517":{"id":"/docs/benchmarking-359","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#замер-7-m-35-стоит-ли-zero-copy-своих-денег","content":"`HEAP`"},"518":{"id":"/docs/benchmarking-360","page_id":"/docs/benchmarking","tags":[],"type":"te