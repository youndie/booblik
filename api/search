/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`MAPPED`"},"347":{"id":"/docs/benchmarking-189","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"1 КиБ"},"348":{"id":"/docs/benchmarking-190","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"**8 884 828 ± 1 203 190**"},"349":{"id":"/docs/benchmarking-191","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"1 854 553 ⚠️"},"350":{"id":"/docs/benchmarking-192","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"на запись"},"351":{"id":"/docs/benchmarking-193","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`FILE_CHANNEL`"},"352":{"id":"/docs/benchmarking-194","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"64 Б"},"353":{"id":"/docs/benchmarking-195","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"254 ± 11"},"354":{"id":"/docs/benchmarking-196","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"257"},"355":{"id":"/docs/benchmarking-197","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"на запись"},"356":{"id":"/docs/benchmarking-198","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`FILE_CHANNEL`"},"357":{"id":"/docs/benchmarking-199","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"1 КиБ"},"358":{"id":"/docs/benchmarking-200","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"252 ± 6"},"359":{"id":"/docs/benchmarking-201","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"245"},"360":{"id":"/docs/benchmarking-202","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"на запись"},"361":{"id":"/docs/benchmarking-203","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`MAPPED`"},"362":{"id":"/docs/benchmarking-204","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"64 Б"},"363":{"id":"/docs/benchmarking-205","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"**251 ± 6**"},"364":{"id":"/docs/benchmarking-206","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"16 123"},"365":{"id":"/docs/benchmarking-207","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"на запись"},"366":{"id":"/docs/benchmarking-208","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`MAPPED`"},"367":{"id":"/docs/benchmarking-209","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"1 КиБ"},"368":{"id":"/docs/benchmarking-210","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"**252 ± 6**"},"369":{"id":"/docs/benchmarking-211","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"4 135"},"370":{"id":"/docs/benchmarking-212","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"**Главная строка здесь — предпоследняя.** Долговечная запись через маппинг стоила 16 123 в\nсекунду и стоит 251. Ничего не замедлилось: раньше там вызывался `msync`, который, как показал\nM-24, возвращает управление до того, как работа сделана. Преимущество mapped-пути в долговечном\nрежиме было целиком артефактом более слабой операции — **под честным барьером два пути записи\nнеразличимы** (251 против 254)."},"371":{"id":"/docs/benchmarking-213","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`MAPPED`/1 КиБ без сброса вырос в 4,8 раза — это M-27: строка наконец меряет `append`,\nа не переоткрытие сегмента. Переработок сегмента в этой строке было 512, и они больше ничего\nне стоят."},"372":{"id":"/docs/benchmarking-214","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#21-запись-в-сегмент-напрямую--верхняя-граница-всего-остального","content":"`FILE_CHANNEL` без сброса просел на треть против замера 1 — накладные расходы разреженного\nиндекса и восстановления, добавленные в M2. На фоне разрыва с mapped-путём это шум, но строку\nстоит держать в поле зрения."},"373":{"id":"/docs/benchmarking-215","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Записей в секунду через актор, батчами по 1 / 10 / 100:"},"374":{"id":"/docs/benchmarking-216","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Политика"},"375":{"id":"/docs/benchmarking-217","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Режим"},"376":{"id":"/docs/benchmarking-218","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Батч 1"},"377":{"id":"/docs/benchmarking-219","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Батч 10"},"378":{"id":"/docs/benchmarking-220","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"Батч 100"},"379":{"id":"/docs/benchmarking-221","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"`WRITTEN`"},"380":{"id":"/docs/benchmarking-222","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-запись","content":"`FILE_CHANNEL`"},"381":{"id":"/docs/benchmarking-223","page_id":"/docs/benchmarking","tags":[],"type":"text","url":"/docs/benchmarking#22-m-14-чего-стоит-подтверждение-на-каждую-