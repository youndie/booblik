page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#112-wsl2--не-bare-metal-linux-и-для-этого-проекта-разница-существенна","content":"1.12 WSL2 — не bare-metal Linux, и для этого проекта разница существенна"},"1823":{"id":"/docs/research/research-architecture-13","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#113-transferto-становится-sendfile-не-всегда-и-разницы-не-видно-по-результату-m-63","content":"1.13 `transferTo` становится `sendfile&#x60; не всегда, и разницы не видно по результату &#x2A;(M-63)*"},"1824":{"id":"/docs/research/research-architecture-14","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#114-версии-инструментов","content":"1.14 Версии инструментов"},"1825":{"id":"/docs/research/research-architecture-15","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#115-арендованный-стенд-m-46-честный-fsync-но-не-bare-metal--и-tmp-в-памяти","content":"1.15 Арендованный стенд M-46: честный `fsync`, но не bare-metal — и `/tmp` в памяти"},"1826":{"id":"/docs/research/research-architecture-16","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#116-wildcard-привязка-тихо-уступает-порт-чужому-процессу-m-64","content":"1.16 Wildcard-привязка тихо уступает порт чужому процессу &#x2A;(M-64)*"},"1827":{"id":"/docs/research/research-architecture-17","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#117-клиент-на-kmp-браузер-невозможен-а-на-native-нет-tls","content":"1.17 Клиент на KMP: браузер невозможен, а на native нет TLS"},"1828":{"id":"/docs/research/research-architecture-18","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#118-docker-профиль-уже-зашит-sparse-файлы-выживают-а-базовый-образ--вопрос-замера","content":"1.18 Docker: профиль уже зашит, sparse-файлы выживают, а базовый образ — вопрос замера"},"1829":{"id":"/docs/research/research-architecture-19","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#119-базовый-образ-musl-меньше-но-он-меняет-рантайм-под-всеми-числами","content":"1.19 Базовый образ: musl меньше, но он меняет рантайм под всеми числами"},"1830":{"id":"/docs/research/research-architecture-20","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#120-как-это-делают-у-kafka-и-confluent--проверено-по-их-dockerfile","content":"1.20 Как это делают у Kafka и Confluent — проверено по их `Dockerfile`"},"1831":{"id":"/docs/research/research-architecture-21","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#2-решения","content":"2\\. Решения"},"1832":{"id":"/docs/research/research-architecture-22","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р1-оба-пути-записи-реализованы-выбор-делает-бенчмарк-отклонение-от-драфта","content":"Р1. Оба пути записи реализованы, выбор делает бенчмарк &#x2A;(отклонение от драфта)*"},"1833":{"id":"/docs/research/research-architecture-23","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р2-индекс--разреженный-в-longarray-а-не-concurrentskiplistmap-отклонение-от-драфта","content":"Р2. Индекс — разреженный, в `LongArray`, а не `ConcurrentSkipListMap&#x60; &#x2A;(отклонение от драфта)*"},"1834":{"id":"/docs/research/research-architecture-24","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р3-сетевой-слой-свой-на-serversocketchannel-а-не-ktor-network-отклонение-от-драфта","content":"Р3. Сетевой слой свой, на `ServerSocketChannel&#x60;, а не Ktor Network &#x2A;(отклонение от драфта)*"},"1835":{"id":"/docs/research/research-architecture-25","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р4-долговечность--явная-политика-а-не-побочный-эффект","content":"Р4. Долговечность — явная политика, а не побочный эффект"},"1836":{"id":"/docs/research/research-architecture-26","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р5-гейт--одна-команда-и-бенчмарки-в-него-не-входят","content":"Р5. Гейт — одна команда, и бенчмарки в него не входят"},"1837":{"id":"/docs/research/research-architecture-27","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р6-профиль-рантайма--ограничение-а-не-настройка","content":"Р6. Профиль рантайма — ограничение, а не настройка"},"1838":{"id":"/docs/research/research-architecture-28","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р7-код-по-английски-документация-по-русски","content":"Р7. Код по-английски, документация по-русски"},"1839":{"id":"/docs/research/research-architecture-29","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р8-клиент-остаётся-kotlinjvm-но-выносится-в-свой-модуль","content":"Р8. Клиент остаётся Kotlin/JVM, но выносится в свой модуль"},"1840":{"id":"/docs/research/research-architecture-30","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р9-базовый-образ-bellsoftliberica-openjre-alpine25","content":"Р9. Базовый образ: `bellsoft/liberica-openjre-alpine:25`"},"1841":{"id":"/docs/research/research-architecture-31","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#р10-образ-собирает-готовый-дистрибутив-а-не-компилирует-его","content":"Р10. Образ собирает готовый дистрибутив, а не компилирует его"},"1842":{"id":"/docs/research/research-architecture-32","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#3-риски-и-открытые-вопросы","content":"3\\. Риски и открытые вопросы"},"1843":{"id":"/docs/research/research-architecture-33","page_id":"/docs/research/research-architecture","type":"heading","tags":[],"url":"/docs/research/research-architecture#4-что-делать-дальше","content":"4\\. Что делать дальше"},"1844":{"id":"/docs/research/research-architecture-34","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture","content":"`booblik` — брокер сообщений на Kotlin/JVM с хранением в append-only логе: топик режется на\nпартиции, партиция — на сегменты, потребитель читает по числовому оффсету и сам помнит, где\nостановился. Ниша ровно одна и она не «замена Kafka»: это брокер, который целиком помещается\nв голову одного человека и в один процесс без ZooKeeper, KRaft-кворума и координатора групп.\nВсё, что делает Kafka эксплуатируемой в кластере, здесь сознательно отсутствует — а всё, что\nделает лог быстрым, воспроизводится и **замеряется**."},"1845":{"id":"/docs/research/research-architecture-35","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture","content":"Документ фиксирует **проверенные факты** (прочитанное в исходниках и артефактах или полученное\nпрогоном), **принятые решения** и **риски**. Непроверенное названо гипотезой."},"1846":{"id":"/docs/research/research-architecture-36","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture","content":"Исходный замысел — source-draft. Он не совпадает с тем, что здесь: две его\nцентральные посылки при проверке оказались перевёрнутыми (§1.1, §1.3), и это разобрано в разделе 2."},"1847":{"id":"/docs/research/research-architecture-37","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Драфт говорит: «вдохновлено архитектурой Kafka» и тут же — «Write Path: `MappedByteBuffer`».\nПроверено по исходникам Kafka (ветка `trunk`, чтение кода):"},"1848":{"id":"/docs/research/research-architecture-38","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Факт"},"1849":{"id":"/docs/research/research-architecture-39","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Где проверено"},"1850":{"id":"/docs/research/research-architecture-40","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Лог-сегмент пишется через `FileChannel`, `MappedByteBuffer` в файле не встречается ни разу"},"1851":{"id":"/docs/research/research-architecture-41","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"`clients/src/main/java/org/apache/kafka/common/record/internal/FileRecords.java` — `private final FileChannel channel;`, `append(MemoryRecords)`, `channel.force(true)`"},"1852":{"id":"/docs/research/research-architecture-42","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Индексный файл — наоборот, целиком мапится"},"1853":{"id":"/docs/research/research-architecture-43","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"`storage/src/main/java/org/apache/kafka/storage/internals/log/AbstractIndex.java` — `private volatile MappedByteBuffer mmap;`, `raf.getChannel().map(READ_WRITE, 0, length)`"},"1854":{"id":"/docs/research/research-architecture-44","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"Kafka **вручную** снимает маппинг индекса через `Unsafe`, не дожидаясь GC"},"1855":{"id":"/docs/research/research-architecture-45","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"там же — `ByteBufferUnmapper.unmap(file.getAbsolutePath(), mmap)` в `forceUnmap()`, затем `mmap = null`"},"1856":{"id":"/docs/research/research-architecture-46","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"**Следствие 1.** Формулировка «как в Kafka, поэтому mmap» неверна в обе стороны: у Kafka mmap\nстоит там, где доступ случайный и объём мал (индекс), и не стоит там, где доступ строго\nпоследовательный и объём велик (лог). Это ровно противоположно драфту."},"1857":{"id":"/docs/research/research-architecture-47","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"**Следствие 2.** «mmap быстрее» перестаёт быть посылкой и становится вопросом, у которого есть\nцифра. Отсюда решение Р1: реализованы **обе** записи за одним интерфейсом, и выбор делает бенчмарк."},"1858":{"id":"/docs/research/research-architecture-48","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#11-kafka-пишет-лог-не-через-mmap-через-mmap-у-неё-только-индекс","content":"**Следствие 3.** Ручной `unmap` в Kafka — не микрооптимизация, а обход отсутствующего в JDK API\n(§1.5). У нас на JDK 25 он не нужен, и это единственная причина, по которой маппинг здесь сделан\nне через `MappedByteBuffer`."},"1859":{"id":"/docs/research/research-architecture-49","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"Факт"},"1860":{"id":"/docs/research/research-architecture-50","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"Где проверено"},"1861":{"id":"/docs/research/research-architecture-51","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"Хранилище само по себе `transferTo` не зовёт — оно отдаёт байты абстракции канала"},"1862":{"id":"/docs/research/research-architecture-52","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"`FileRecords.writeTo(TransferableChannel, int, int)` → `destChannel.transferFrom(channel, position, count)`"},"1863":{"id":"/docs/research/research-architecture-53","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"На нешифрованном соединении это ровно `sendfile`"},"1864":{"id":"/docs/research/research-architecture-54","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"`PlaintextTransportLayer.java:213` — `return fileChannel.transferTo(position, count, socketChannel);`"},"1865":{"id":"/docs/research/research-architecture-55","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"На TLS-соединении zero-copy **нет**: байты читаются в буфер и шифруются"},"1866":{"id":"/docs/research/research-architecture-56","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"`SslTransportLayer.java:1003` — цикл вокруг `fileChannel.read(fileChannelBuffer)`"},"1867":{"id":"/docs/research/research-architecture-57","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#12-zero-copy-живёт-в-транспортном-слое-и-tls-его-отменяет-целиком","content":"**Следствие.** Zero-copy и шифрование канала взаимоисключающи — не «медленнее», а физически\nнесовместимы: шифровать можно только то, к чему прикоснулся процессор. Если TLS когда-нибудь\nпонадобится, это отдельный путь чтения, а не флаг. Пока TLS вне скоупа (см. фичу\nfeature-append-and-fetch, раздел 6)."},"1868":{"id":"/docs/research/research-architecture-58","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"Драфт закрывает этот вопрос скобкой: «для прямого доступа к NIO-каналу потребуется извлечь\nunderlying channel». Проверено по API-дампу и исходникам Ktor `3.5.2`:"},"1869":{"id":"/docs/research/research-architecture-59","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"Факт"},"1870":{"id":"/docs/research/research-architecture-60","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"Где проверено"},"1871":{"id":"/docs/research/research-architecture-61","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"`io.ktor.network.sockets.Socket` — это `ABoundSocket + AConnectedSocket + ReadWriteSocket + CoroutineScope`; из методов только `attachForReading(ByteChannel)` / `attachForWriting(ByteChannel)`"},"1872":{"id":"/docs/research/research-architecture-62","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"`ktor-network/api/ktor-network.api`"},"1873":{"id":"/docs/research/research-architecture-63","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"Реализация, у которой есть канал, — `internal`"},"1874":{"id":"/docs/research/research-architecture-64","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"`ktor-network/jvm/src/io/ktor/network/sockets/SocketImpl.kt` — `internal class SocketImpl<out S : SocketChannel>(override val channel: S, …)`; `NIOSocketImpl` тоже `internal`"},"1875":{"id":"/docs/research/research-architecture-65","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"Лазейка всё же есть: `io.ktor.network.selector.Selectable` — **публичный** интерфейс с `getChannel(): SelectableChannel`"},"1876":{"id":"/docs/research/research-architecture-66","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"`ktor-network/api/ktor-network.api`"},"1877":{"id":"/docs/research/research-architecture-67","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"И JVM-сокет Ktor действительно им является"},"1878":{"id":"/docs/research/research-architecture-68","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"`ktor-network/common/src/io/ktor/network/sockets/SocketBase.kt` — `internal abstract class SocketBase(…) : ReadWriteSocket, SelectableBase()`, а `SelectableBase : Selectable`"},"1879":{"id":"/docs/research/research-architecture-69","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"**Следствие 1.** Написать `(socket as Selectable).channel as SocketChannel` можно: код\nкомпилируется против публичного интерфейса и на JVM работает. Но держится он на том, что\n`SocketBase` наследует `SelectableBase` — на детали реализации `internal`-класса, которую никто\nне обещал сохранять. Первый же рефакторинг сокетов в Ktor ломает это **в рантайме**, а не при\nкомпиляции."},"1880":{"id":"/docs/research/research-architecture-70","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#13-публичный-api-ktor-network-не-отдаёт-socketchannel","content":"**Следствие 2.** Взять Ktor «ради удобных корутин-сессий» и одновременно zero-copy — нельзя без\nэтой ставки. Отсюда решение Р3: сетевой слой свой, на `ServerSocketChannel`."},"1881":{"id":"/docs/research/research-architecture-71","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"Факт"},"1882":{"id":"/docs/research/research-architecture-72","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"Где проверено"},"1883":{"id":"/docs/research/research-architecture-73","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"Метод «may or may not transfer all of the requested bytes»"},"1884":{"id":"/docs/research/research-architecture-74","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"javadoc `java.nio.channels.FileChannel.transferTo`"},"1885":{"id":"/docs/research/research-architecture-75","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"Один вызов ограничен `Integer.MAX_VALUE` в самом JDK"},"1886":{"id":"/docs/research/research-architecture-76","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"`sun.nio.ch.FileChannelImpl` (clamp), JDK-8271308"},"1887":{"id":"/docs/research/research-architecture-77","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"`sendfile` в Linux ограничен `2^31-1` независимо от разрядности"},"1888":{"id":"/docs/research/research-architecture-78","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"JDK-4770025 и обсуждение в LKML"},"1889":{"id":"/docs/research/research-architecture-79","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"На неблокирующем сокете с полным буфером отправки вызов вернёт 0"},"1890":{"id":"/docs/research/research-architecture-80","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"javadoc + практика NIO"},"1891":{"id":"/docs/research/research-architecture-81","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"Дисковый ввод-вывод внутри `sendfile` блокирует, даже если сокет неблокирующий"},"1892":{"id":"/docs/research/research-architecture-82","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"обсуждение «sendfile to nonblocking socket», LKML"},"1893":{"id":"/docs/research/research-architecture-83","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"**Следствие 1.** Отправка сегмента — цикл по готовности сокета, а не один вызов. Возврат нуля —\nэто «подожди селектор», а не «конец данных»; спутать их — это busy-loop на 100 % CPU, и выглядит\nон как «брокер быстрый»."},"1894":{"id":"/docs/research/research-architecture-84","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#14-transferto-отдаёт-меньше-чем-просят-и-это-норма","content":"**Следствие 2.** Последний пункт — причина, по которой поток, дергающий `transferTo`, нельзя\nсчитать неблокирующим. Для виртуальных потоков это означает пиннинг несущего потока; для\nкорутин — занятый поток диспетчера. Это учтено в Р3."},"1895":{"id":"/docs/research/research-architecture-85","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"Факт"},"1896":{"id":"/docs/research/research-architecture-86","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"Где проверено"},"1897":{"id":"/docs/research/research-architecture-87","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"Маппинг ограничен 2 ГБ, потому что буфер индексируется `int`"},"1898":{"id":"/docs/research/research-architecture-88","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"JDK-6347833 («Enhance MappedByteBuffer to support sizes >2GB»), открыт"},"1899":{"id":"/docs/research/research-architecture-89","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"Поддерживаемого способа снять маппинг нет — регион уходит, когда GC доберётся до буфера"},"1900":{"id":"/docs/research/research-architecture-90","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"JDK-4724038 («Add unmap method to MappedByteBuffer»)"},"1901":{"id":"/docs/research/research-architecture-91","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"`FileChannel.map(mode, offset, size, Arena)` возвращает `MemorySegment` без потолка 2 ГБ и с детерминированным освобождением по `Arena.close()`"},"1902":{"id":"/docs/research/research-architecture-92","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"javadoc `java.lang.foreign.MemorySegment` / `FileChannel.map` (JDK 21+, FFM финализирован в 22)"},"1903":{"id":"/docs/research/research-architecture-93","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#15-mappedbytebuffer-упирается-в-2-гб-и-не-умеет-освобождаться","content":"**Следствие.** Брокер удаляет отставшие сегменты по расписанию — то есть управляет ровно тем\nвременем жизни, которое `MappedByteBuffer` отдаёт на усмотрение GC. Kafka обходит это `Unsafe`-ом\n(§1.1); на тулчейне JDK 25 обходить нечего. Поэтому маппинг здесь — FFM, а не `MappedByteBuffer`.\nРеализация: `MappedSegmentWriter`."},"1904":{"id":"/docs/research/research-architecture-94","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#16-value-class-в-generic-позиции-боксится--и-именно-там-где-драфт-обещал-ноль-аллокаций","content":"Факт"},"1905":{"id":"/docs/research/research-architecture-95","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#16-value-class-в-generic-позиции-боксится--и-именно-там-где-драфт-обещал-ноль-аллокаций","content":"Где проверено"},"1906":{"id":"/docs/research/research-architecture-96","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#16-value-class-в-generic-позиции-боксится--и-именно-там-где-драфт-обещал-ноль-аллокаций","content":"«If an inline class type is used in a generic position, then its boxed type will be used»"},"1907":{"id":"/docs/research/research-architecture-97","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#16-value-class-в-generic-позиции-боксится--и-именно-там-где-драфт-обещал-ноль-аллокаций","content":"KEEP, proposals/inline-classes.md; то же в документации Kotlin"},"1908":{"id":"/docs/research/research-architecture-98","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#16-value-class-в-generic-позиции-боксится--и-именно-там-где-драфт-обещал-ноль-аллокаций","content":"**Следствие.** Индекс из драфта — `ConcurrentSkipListMap<Offset, Position>` — аллоцирует\n**боксированный ключ и боксированное значение на каждое сообщение**, плюс узел дерева. Раздел 2\nдрафта ради экономии на GC заводит value-классы, а раздел «Milestone 2» отдаёт эту экономию\nобратно с процентами, в самом горячем месте. Отсюда решение Р2."},"1909":{"id":"/docs/research/research-architecture-99","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#17-ffm-проверяет-выравнивание-там-где-mappedbytebuffer-не-проверял-найдено-прогоном","content":"Первый же прогон тестов упал:"},"1910":{"id":"/docs/research/research-architecture-100","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#17-ffm-проверяет-выравнивание-там-где-mappedbytebuffer-не-проверял-найдено-прогоном","content":"`ValueLayout.JAVA_INT` несёт требование выравнивания на 4 байта, и FFM его **применяет**.\nЗаписи переменной длины начинаются где придётся, так что большинство длинных префиксов\nне выровнены. `MappedByteBuffer.putInt(int, int)` этого никогда не проверял — то есть при\nдословном переносе кода драфта на FFM ошибка появляется на ровном месте."},"1911":{"id":"/docs/research/research-architecture-101","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#17-ffm-проверяет-выравнивание-там-где-mappedbytebuffer-не-проверял-найдено-прогоном","content":"**Следствие.** На неровных смещениях нужен `JAVA_INT_UNALIGNED`. Зафиксировано в комментарии\nу места записи, потому что через полгода это выглядит как случайно выбранная константа."},"1912":{"id":"/docs/research/research-architecture-102","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#18-бенчмарк-метод-не-может-возвращать-value-class-найдено-прогоном","content":"Kotlin манглит имя функции, возвращающей value class; генератор JMH внутри kotlinx-benchmark\nтакое имя отвергает. Возвращать что-то метод обязан — иначе JMH сочтёт вызов мёртвым кодом\nи выкинет его."},"1913":{"id":"/docs/research/research-architecture-103","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#18-бенчмарк-метод-не-может-возвращать-value-class-найдено-прогоном","content":"**Следствие.** Бенчмарки отдают сырой `Long`, а не `Offset`. Мелочь, но она стоит одного\nнепонятного падения сборки на каждого, кто напишет следующий бенчмарк."},"1914":{"id":"/docs/research/research-architecture-104","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"M0 показал барьер через маппинг в 63 раза дешевле барьера через `FileChannel` и оставил вопрос\n«дешевле за счёт чего» открытым. Ответ получен прямым экспериментом\n(`DurabilityProbe`):\nесли `msync` действительно сделал данные долговечными, то следующий за ним `fsync` не найдёт\nработы и будет почти бесплатным."},"1915":{"id":"/docs/research/research-architecture-105","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"Замер (32 МиБ грязных страниц на раунд, медиана 9 раундов)"},"1916":{"id":"/docs/research/research-architecture-106","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"Время"},"1917":{"id":"/docs/research/research-architecture-107","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`fsync` (путь `FileChannel`)"},"1918":{"id":"/docs/research/research-architecture-108","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"9,33 мс"},"1919":{"id":"/docs/research/research-architecture-109","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`msync` (путь маппинга)"},"1920":{"id":"/docs/research/research-architecture-110","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"16,45 мс"},"1921":{"id":"/docs/research/research-architecture-111","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`msync`, затем `fsync` по тому же файлу"},"1922":{"id":"/docs/research/research-architecture-112","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"31,04 мс"},"1923":{"id":"/docs/research/research-architecture-113","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"— из них хвостовой `fsync`"},"1924":{"id":"/docs/research/research-architecture-114","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"**8,55 мс = 92 % от голого `fsync`**"},"1925":{"id":"/docs/research/research-architecture-115","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"**Поправка (замер 10 + чтение исходников).** Разница между платформами есть, но она **не про\nфайловую систему** — она про то, какие системные вызовы делаются. Разбор по источникам:"},"1926":{"id":"/docs/research/research-architecture-116","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"Факт"},"1927":{"id":"/docs/research/research-architecture-117","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"Где проверено"},"1928":{"id":"/docs/research/research-architecture-118","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"На Linux `msync(MS_SYNC)` вызывает `vfs_fsync_range(file, fstart, fend, 1)` — **ту же** функцию, через которую идёт `fsync`"},"1929":{"id":"/docs/research/research-architecture-119","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"ядро, `msync.c:96`"},"1930":{"id":"/docs/research/research-architecture-120","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"На macOS `fsync` **не** доводит данные до накопителя: «the drive itself may not physically write the data to the platters», для этого нужен `F_FULLFSYNC`"},"1931":{"id":"/docs/research/research-architecture-121","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`man 2 fsync`, Darwin"},"1932":{"id":"/docs/research/research-architecture-122","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"JDK на macOS зовёт именно `F_FULLFSYNC`, откатываясь на `fsync` только для нелокальных ФС"},"1933":{"id":"/docs/research/research-architecture-123","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`FileDispatcherImpl.c:51` — `result = fcntl(fd, F_FULLFSYNC);`"},"1934":{"id":"/docs/research/research-architecture-124","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"На macOS `msync` до `F_FULLFSYNC` не доходит"},"1935":{"id":"/docs/research/research-architecture-125","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"следует из двух предыдущих + замер"},"1936":{"id":"/docs/research/research-architecture-126","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"Хост"},"1937":{"id":"/docs/research/research-architecture-127","page_id":"/docs/research/research-architecture","tags":[],"type":"text","url":"/docs/research/research-architecture#19-msync-слабее-fsync-на-macos-и-равносилен-ему-на-linux--это-про-api-а-не-про-фс-m-24","content":"`fsync` (JDK `force()`)"},"1938":{"id":"/docs/research/research-architecture-128","page_id":"/docs/research/research-architectur