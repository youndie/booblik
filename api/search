t-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadatarequest","content":"A `MetadataRequest` is a specialized request that does not target a specific partition but rather asks the broker for information about one or more topics `Session.kt:94-97`. If the request contains no topics, the broker is expected to return metadata for all available topics `Session.kt:124-126`."},"4988":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-10","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"The broker responds with a hierarchy of metadata structures. A `TopicMetadata` object contains a list of `PartitionMetadata` for each partition in a topic `Session.kt:136-149`."},"4989":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-11","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"The `PartitionMetadata` includes:"},"4990":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-12","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"Field"},"4991":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-13","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"Description"},"4992":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-14","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"`id`"},"4993":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-15","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"The partition identifier"},"4994":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-16","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"`logStartOffset`"},"4995":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-17","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"The first offset currently available in the log after retention `Session.kt:142`"},"4996":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-18","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"`highWatermark`"},"4997":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-19","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#topicmetadata-and-partitionmetadata","content":"The first offset that does not exist yet (the next expected offset) `Session.kt:146`"},"4998":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-20","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#unknown_topic_or_partition-error-handling","content":"The protocol enforces strict topic validation. If a request names a topic that the broker does not possess, the broker must fail the **entire** request with `UNKNOWN_TOPIC_OR_PARTITION` rather than simply omitting the missing topic from the response `Session.kt:115-118`. This distinction ensures that a client can differentiate between a topic that is empty and a topic that does not exist `Session.kt:127-131`."},"4999":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-21","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadataresponse-decoding","content":"The decoding process involves parsing a series of nested structures from the wire format `wire.py:209-232`. The sequence is as follows:"},"5000":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-22","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadataresponse-decoding","content":"**Topic Count**: An integer representing the number of topics `wire.py:211`."},"5001":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-23","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadataresponse-decoding","content":"**Topic Name**: A length-prefixed UTF-8 string `wire.py:216-219`."},"5002":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-24","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadataresponse-decoding","content":"**Partition Count**: An integer representing the number of partitions in the topic `wire.py:221`."},"5003":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-25","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadataresponse-decoding","content":"**Partition Data**: A sequence of `PartitionInfo` containing the partition ID, log start offset, and high watermark `wire.py:226`."},"5004":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-26","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#metadata-conformance-testing","content":"The conformance harness verifies that the client correctly interprets the broker's response by checking the reported offsets `Program.cs:107`. Specifically, it validates that the `partition` ID, `logStartOffset`, and `highWatermark` are correctly extracted and printed to the standard output `Program.cs:107`."},"5005":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-27","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"File"},"5006":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-28","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"Lines"},"5007":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-29","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"What is there"},"5008":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-30","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`…/net/Session.kt`"},"5009":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-31","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`121-152`"},"5010":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-32","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"The logic for handling and responding to `MetadataRequest`"},"5011":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-33","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`…/booblik/wire.py`"},"5012":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-34","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`209-232`"},"5013":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-35","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"The Python implementation of metadata response decoding"},"5014":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-36","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`…/harness/wire.py`"},"5015":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-37","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"`109-132`"},"5016":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-38","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#key-files","content":"The reference implementation of metadata request encoding and decoding"},"5017":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-39","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#behaviour-that-surprises","content":"The `highWatermark` reported in `PartitionMetadata` is read directly from the log's `nextOffset` rather than a published watermark to ensure it reflects what is actually readable `Session.kt:144-146`."},"5018":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-40","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#behaviour-that-surprises","content":"In `MetadataRequest`, if a request names no topics, the broker returns metadata for everything `Session.kt:124-125`."},"5019":{"id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval-41","page_id":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik.Conformance/metadata-retrieval#behaviour-that-surprises","content":"A `MetadataResponse` that is cut short by a broker restart is treated as a `ProtocolError` rather than a successful empty response `wire.py:230-232`."},"5020":{"id":"/wiki/ci","page_id":"/wiki/ci","type":"page","content":"ci","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci"},"5021":{"id":"/wiki/ci-0","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#diagram","content":"Diagram"},"5022":{"id":"/wiki/ci-1","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-gate","content":"The Gate"},"5023":{"id":"/wiki/ci-2","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-gatekeeper","content":"The Gatekeeper"},"5024":{"id":"/wiki/ci-3","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-smoke-test","content":"The Smoke Test"},"5025":{"id":"/wiki/ci-4","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#the-performance-floor","content":"The Performance Floor"},"5026":{"id":"/wiki/ci-5","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#remote-execution","content":"Remote Execution"},"5027":{"id":"/wiki/ci-6","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#key-files","content":"Key files"},"5028":{"id":"/wiki/ci-7","page_id":"/wiki/ci","type":"heading","tags":[],"url":"/wiki/ci#behaviour-that-surprise","content":"Behaviour that surprise"},"5029":{"id":"/wiki/ci-8","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"5030":{"id":"/wiki/ci-9","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gate","content":"The Gate acts as the primary entry point for project verification, orchestrating various checks to ensure the codebase is stable. It is designed to be language-agnostic, allowing different clients to define their own requirements via `gate.sh` (as seen in the loop starting at `gate.sh:109`). A critical distinction is made between a failure and a skip: if a required toolchain is missing, the part is marked as skipped using exit code 77 (`gate.sh:24`), ensuring that a machine without a Go toolchain does not report a broken Go client (`gate.sh:133`)."},"5031":{"id":"/wiki/ci-10","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gate","content":"More: The Gate"},"5032":{"id":"/wiki/ci-11","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gatekeeper","content":"To prevent shipping stale or broken code, the build process follows a strict order: first, the code must pass the gate, and only then is a distribution created and packaged into a Docker image (`docker-build.sh:5-7`). This prevents the common error of building an image from a local `build/install` directory that might contain unverified or old artifacts (`docker-build.sh:6`). The script explicitly tracks whether the image was built from a \"gated\" distribution or from \"unchecked code\" via the `BOOBLIK_SKIP_GATE` environment variable (`docker-build.sh:20`)."},"5033":{"id":"/wiki/ci-12","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-gatekeeper","content":"More: The Gatekeeper"},"5034":{"id":"/wiki/ci-13","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"The smoke test verifies the actual delivery of the software by running the distribution in a container and performing end-to-end socket communication (`smoke.sh:4`). It validates several runtime properties:"},"5035":{"id":"/wiki/ci-14","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"**Connectivity**: The broker must listen on the configured port (`smoke.sh:41`)."},"5036":{"id":"/wiki/ci-15","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"**Configuration**: Environment variables like `BOOBLIK_TOPICS` must be applied to the process (`smoke.sh:65`)."},"5037":{"id":"/wiki/ci-16","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"**JVM Profile**: The process must run with specific flags like `-Xmx64M` and `-XX:+UseSerialGC` to ensure the measured profile matches the intended one (`docker-smoke.sh:76`)."},"5038":{"id":"/wiki/ci-17","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"**Persistence**: Data must land on the volume and maintain sparseness (`docker-smoke.sh:104`)."},"5039":{"id":"/wiki/ci-18","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-smoke-test","content":"More: The Smoke Test"},"5040":{"id":"/wiki/ci-19","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#the-performance-floor","content":"Rather than detecting fine-grained regressions which are unreliable on shared CI runners, this module implements a \"floor\" to catch catastrophic collapses in performance (`benchmark-floor.sh:11`). It compares measured throughput against a threshold that is an order of magnitude below the slowest known hardware (`benchmark-floor.sh:24`). This ensures that if a change makes writes a hundred times slower, it is caught, while ignoring the 37% variance caused by different machines (`benchmark-floor.sh:6`)."},"5041":{"id":"/wiki/ci-20","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#remote-execution","content":"For high-fidelity measurements, tasks can be executed on remote Linux hosts via `remote-run.sh:4`. To ensure the integrity of performance measurements, the script performs a storage probe to verify the filesystem type (`remote-run.sh:48`) and refuses to run if the directory sits on network storage like `nfs` or `cifs` (`remote-run.sh:62`). It also warns the user if the disk is rotational, as such hardware cannot be compared to NVMe runs (`remote-run.sh:68`)."},"5042":{"id":"/wiki/ci-21","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"File"},"5043":{"id":"/wiki/ci-22","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Lines"},"5044":{"id":"/wiki/ci-23","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"What is there"},"5045":{"id":"/wiki/ci-24","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/benchmark-floor.sh`"},"5046":{"id":"/wiki/ci-25","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`24-25`"},"5047":{"id":"/wiki/ci-26","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Threshold constants for `FILE_CHANNEL` and `MAPPED` modes"},"5048":{"id":"/wiki/ci-27","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/docker-build.sh`"},"5049":{"id":"/wiki/ci-28","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`17`"},"5050":{"id":"/wiki/ci-29","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"The `IMAGE` variable for the target Docker tag"},"5051":{"id":"/wiki/ci-30","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/docker-smoke.sh`"},"5052":{"id":"/wiki/ci-31","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`76-77`"},"5053":{"id":"/wiki/ci-32","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"The list of required JVM flags for the runtime profile"},"5054":{"id":"/wiki/ci-33","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/gate.sh`"},"5055":{"id":"/wiki/ci-34","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`24`"},"5056":{"id":"/wiki/ci-35","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"The `SKIPPED_CODE` constant (77)"},"5057":{"id":"/wiki/ci-36","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/remote-run.sh`"},"5058":{"id":"/wiki/ci-37","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`62-66`"},"5059":{"id":"/wiki/ci-38","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Prohibited filesystem types for measurement integrity"},"5060":{"id":"/wiki/ci-39","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`ci/smoke.sh`"},"5061":{"id":"/wiki/ci-40","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"`20-28`"},"5062":{"id":"/wiki/ci-41","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#key-files","content":"Configuration properties for the smoke test broker"},"5063":{"id":"/wiki/ci-42","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"The `part` function in `gate.sh:54` uses a specific logic where it avoids reporting a failure as a success by checking the exit code after the command execution, preventing \"successful failures\" from being reported as exit 0."},"5064":{"id":"/wiki/ci-43","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"In `docker-smoke.sh:40`, the script avoids using `grep -q` in a pipeline because `set -o pipefail` would cause a successful match to return a non-zero exit code due to the `SIGPIPE` sent to the writer."},"5065":{"id":"/wiki/ci-44","page_id":"/wiki/ci","tags":[],"type":"text","url":"/wiki/ci#behaviour-that-surprise","content":"The `remote-run.sh` script uses `printf ' %q' \"${TASKS[@]}\"` (`remote-run.sh:76`) to ensure that complex arguments are correctly escaped when passed through the SSH transport to the remote shell."},"5066":{"id":"/wiki/ci/the-gate","page_id":"/wiki/ci/the-gate","type":"page","content":"The Gate","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-gate"},"5067":{"id":"/wiki/ci/the-gate-0","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#what-this-module-is-responsible-for","content":"What this module is responsible for"},"5068":{"id":"/wiki/ci/the-gate-1","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#diagram","content":"Diagram"},"5069":{"id":"/wiki/ci/the-gate-2","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#the-part-mechanism","content":"The `part` mechanism"},"5070":{"id":"/wiki/ci/the-gate-3","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#the-skipped_code-convention","content":"The `SKIPPED_CODE` convention"},"5071":{"id":"/wiki/ci/the-gate-4","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#the-selected-filter","content":"The `selected` filter"},"5072":{"id":"/wiki/ci/the-gate-5","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#the-conformance-clientsh-contract","content":"The `conformance-client.sh` contract"},"5073":{"id":"/wiki/ci/the-gate-6","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#the-last_result-lifecycle","content":"The `LAST_RESULT` lifecycle"},"5074":{"id":"/wiki/ci/the-gate-7","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#key-files","content":"Key files"},"5075":{"id":"/wiki/ci/the-gate-8","page_id":"/wiki/ci/the-gate","type":"heading","tags":[],"url":"/wiki/ci/the-gate#behaviour-that-surprises","content":"Behaviour that surprises"},"5076":{"id":"/wiki/ci/the-gate-9","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"5077":{"id":"/wiki/ci/the-gate-10","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#what-this-module-is-responsible-for","content":"The Gate is the unified entry point for all quality checks in the project. It ensures that every component—from the JVM core to various language clients—is verified through a consistent process. It is designed to be the single command a developer runs to ensure the entire system is sound, preventing the \"rotting\" of CI scripts by ensuring the same script used locally is the one used in automation (`gate.sh:7-8`)."},"5078":{"id":"/wiki/ci/the-gate-11","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#the-part-mechanism","content":"The `part` function is the engine of the gate, responsible for executing a command, capturing its exit code, and managing output. When running in a terminal, it streams output to the user and shows the last 25 lines of the log if a failure occurs (`gate.sh:59-81`), whereas in CI environments, it streams everything with a prefix for readability (`gate.sh:64-65`). It also handles the logic of checking if a required toolchain is available before attempting execution (`gate.sh:47-51`)."},"5079":{"id":"/wiki/ci/the-gate-12","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#the-skipped_code-convention","content":"To avoid the \"false red\" problem where a missing toolchain is reported as a failure, the gate uses a specific exit code, `77`, to represent a skipped task (`gate.sh:24-25`). This follows the automake convention, allowing a machine without a specific toolchain (like Go) to report that a part was skipped rather than failed, ensuring the report remains honest (`gate.sh:15-17`)."},"5080":{"id":"/wiki/ci/the-gate-13","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#the-selected-filter","content":"The script allows users to run only specific subsets of the gate by passing arguments. The `selected` function iterates through the provided arguments to determine if a specific language or component should be executed (`gate.sh:89-97`). This allows a developer to run only the `jvm` part or a specific client like `go` (`ci/gate.sh:101, 112`)."},"5081":{"id":"/wiki/ci/the-gate-14","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#the-conformance-clientsh-contract","content":"For a client to participate in the end-to-end conformance run, it must provide a `conformance-client.sh` executable within its directory (`README.md:78-80`). This script must implement a specific contract: it must support `argv` verbs, output `key=value` pairs to stdout, and respect the `BOOBLIK_BROKER` environment variable (`README.md:82-83`)."},"5082":{"id":"/wiki/ci/the-gate-15","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#the-last_result-lifecycle","content":"The gate maintains a strict dependency chain to ensure resources are not wasted on broken code. A client's conformance run (which requires a live Docker container) is only triggered if the client's own `gate.sh` has successfully passed (`gate.sh:118`). This prevents the system from attempting to run a conformance test against a client that is already known to be broken by its own unit tests (`gate.sh:115-116`)."},"5083":{"id":"/wiki/ci/the-gate-16","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"File"},"5084":{"id":"/wiki/ci/the-gate-17","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"Lines"},"5085":{"id":"/wiki/ci/the-gate-18","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"What is there"},"5086":{"id":"/wiki/ci/the-gate-19","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`ci/gate.sh`"},"5087":{"id":"/wiki/ci/the-gate-20","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`24-35`"},"5088":{"id":"/wiki/ci/the-gate-21","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"Definition of `SKIPPED_CODE` and the `LAST_RESULT` state tracking."},"5089":{"id":"/wiki/ci/the-gate-22","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`ci/gate.sh`"},"5090":{"id":"/wiki/ci/the-gate-23","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`42-86`"},"5091":{"id":"/wiki/ci/the-gate-24","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"The `part` function implementation and exit code handling."},"5092":{"id":"/wiki/ci/the-gate-25","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`clients/README.md`"},"5093":{"id":"/wiki/ci/the-gate-26","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`77-83`"},"5094":{"id":"/wiki/ci/the-gate-27","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"The requirements and contract for `conformance-client.sh`."},"5095":{"id":"/wiki/ci/the-gate-28","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`build.gradle.kts`"},"5096":{"id":"/wiki/ci/the-gate-29","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"`120-121`"},"5097":{"id":"/wiki/ci/the-gate-30","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#key-files","content":"Wiring the `checkKotlinAbi` task into the standard `check` lifecycle."},"5098":{"id":"/wiki/ci/the-gate-31","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#behaviour-that-surprises","content":"**The `part` function** does not use `set -e` because it needs to continue running all parts to generate a complete report, even if one fails (`gate.sh:19`)."},"5099":{"id":"/wiki/ci/the-gate-32","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#behaviour-that-surprises","content":"The `conformance` run is the only part that can catch a client that is \"self-consistently wrong\" by testing it against a real broker (`gate.sh:107-108`)."},"5100":{"id":"/wiki/ci/the-gate-33","page_id":"/wiki/ci/the-gate","tags":[],"type":"text","url":"/wiki/ci/the-gate#behaviour-that-surprises","content":"The `booblik-benchmark` module is explicitly excluded from the standard `check` task to prevent API changes in the benchmark from triggering unnecessary ABI validation failures (`build.gradle.kts:105-107`)."},"5101":{"id":"/wiki/ci/the-gated-docker","page_id":"/wiki/ci/the-gated-docker","type":"page","content":"The gated Docker build","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-gated-docker"},"5102":{"id":"/wiki/ci/the-gated-docker-0","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#diagram","content":"Diagram"},"5103":{"id":"/wiki/ci/the-gated-docker-1","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-gate-and-the-distribution","content":"The gate and the distribution"},"5104":{"id":"/wiki/ci/the-gated-docker-2","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik_skip_gate-mode","content":"The `BOOBLIK_SKIP_GATE` mode"},"5105":{"id":"/wiki/ci/the-gated-docker-3","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-image-job-lifecycle","content":"The `image` job lifecycle"},"5106":{"id":"/wiki/ci/the-gated-docker-4","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblikci-image-verification","content":"The `booblik:ci` image verification"},"5107":{"id":"/wiki/ci/the-gated-docker-5","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `booblik-smoke` assertions"},"5108":{"id":"/wiki/ci/the-gated-docker-6","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#the-booblik-smoke-segment-sparseness","content":"The `booblik-smoke` segment sparseness"},"5109":{"id":"/wiki/ci/the-gated-docker-7","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#key-files","content":"Key files"},"5110":{"id":"/wiki/ci/the-gated-docker-8","page_id":"/wiki/ci/the-gated-docker","type":"heading","tags":[],"url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"Behaviour that surprises"},"5111":{"id":"/wiki/ci/the-gated-docker-9","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"5112":{"id":"/wiki/ci/the-gated-docker-10","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-gate-and-the-distribution","content":"To prevent packaging stale or broken code, `docker-build.sh:22` executes the full `check` task via Gradle before any packaging occurs. This ensures that the `installDist` stage, which prepares the files for the image (`docker-build.sh:27-29`), only operates on a distribution that has passed all tests and linting."},"5113":{"id":"/wiki/ci/the-gated-docker-11","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik_skip_gate-mode","content":"For local development and debugging, the build can be bypassed using the `BOOBLIK_SKIP_GATE=1` environment variable (`docker-build.sh:12`). When this mode is active, the script explicitly changes the build's truthfulness, labeling the resulting image as \"WITHOUT THE GATE — from unchecked code\" (`docker-build.sh:25`) instead of the standard \"passed the gate\" (`docker-build.sh:19`)."},"5114":{"id":"/wiki/ci/the-gated-docker-12","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-image-job-lifecycle","content":"The `image` job in `build.yml:65` is decoupled from the `check` job to satisfy two requirements: it requires a Docker daemon which the standard `check` runner lacks (`build.yml:63`), and it must not fail the entire CI pipeline if a Docker-specific issue occurs, as the code correctness was already verified in the `check` job (`build.yml:64`)."},"5115":{"id":"/wiki/ci/the-gated-docker-13","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblikci-image-verification","content":"The verification of the `booblik:ci` image follows a strict sequence: first, the image is built via `./ci/docker-build.sh booblik:ci` (`build.yml:84`), then it is subjected to runtime assertions in `ci/docker-smoke.sh` (`build.yml:89`), and finally, it is validated against a reference client via `./conformance/run.sh` (`build.yml:102`)."},"5116":{"id":"/wiki/ci/the-gated-docker-14","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `ci/docker-smoke.sh` script performs deep inspection of the running container to ensure the runtime environment matches the measured profile. It verifies that:"},"5117":{"id":"/wiki/ci/the-gated-docker-15","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The process runs as the `booblik` user (`docker-smoke.sh:95`)."},"5118":{"id":"/wiki/ci/the-gated-docker-16","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The JVM profile includes exactly six specific flags, such as `-Xmx64M` and `-XX:+UseSerialGC` (`docker-smoke.sh:76-83`)."},"5119":{"id":"/wiki/ci/the-gated-docker-17","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-assertions","content":"The `booblik-health` tool can successfully query the broker's `METADATA` (`docker-smoke.sh:87`)."},"5120":{"id":"/wiki/ci/the-gated-docker-18","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#the-booblik-smoke-segment-sparseness","content":"To ensure the storage layer is efficient, `docker-smoke.sh:104` checks that segment files are created as sparse files. It verifies that the `BLOCKS` count reported by `stat` is less than 2048, ensuring the segment has not been fully materialized on disk."},"5121":{"id":"/wiki/ci/the-gated-docker-19","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"File"},"5122":{"id":"/wiki/ci/the-gated-docker-20","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Lines"},"5123":{"id":"/wiki/ci/the-gated-docker-21","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"What is there"},"5124":{"id":"/wiki/ci/the-gated-docker-22","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`ci/docker-build.sh`"},"5125":{"id":"/wiki/ci/the-gated-docker-23","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`17-38`"},"5126":{"id":"/wiki/ci/the-gated-docker-24","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Logic for gating, distribution, and image size reporting"},"5127":{"id":"/wiki/ci/the-gated-docker-25","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`ci/docker-smoke.sh`"},"5128":{"id":"/wiki/ci/the-gated-docker-26","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`43-85`"},"5129":{"id":"/wiki/ci/the-gated-docker-27","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Log awaiting mechanism and JVM flag verification"},"5130":{"id":"/wiki/ci/the-gated-docker-28","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`…/workflows/build.yml`"},"5131":{"id":"/wiki/ci/the-gated-docker-29","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"`14-90`"},"5132":{"id":"/wiki/ci/the-gated-docker-30","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#key-files","content":"Definition of the `check` and `image` CI jobs"},"5133":{"id":"/wiki/ci/the-gated-docker-31","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `await_log` function in `docker-smoke.sh:43` uses a loop and a local variable to read `docker logs` into a variable before matching, avoiding a SIGPIPE failure that occurs when piping `docker logs` directly into `grep` under `set -o pipefail`."},"5134":{"id":"/wiki/ci/the-gated-docker-32","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `installDist` stage in `docker-build.sh:27` is a prerequisite for `docker build` because the Dockerfile does not contain a build stage; it relies on the files already present in the `build/install` directory."},"5135":{"id":"/wiki/ci/the-gated-docker-33","page_id":"/wiki/ci/the-gated-docker","tags":[],"type":"text","url":"/wiki/ci/the-gated-docker#behaviour-that-surprises","content":"The `booblik-health` check in `docker-smoke.sh:88` is designed to fail if a port is \"healthy\" but no process is actually listening on it, by checking a secondary port that should have no service."},"5136":{"id":"/wiki/ci/the-gatekeeper","page_id":"/wiki/ci/the-gatekeeper","type":"page","content":"The Gatekeeper","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-gatekeeper"},"5137":{"id":"/wiki/ci/the-gatekeeper-0","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#diagram","content":"Diagram"},"5138":{"id":"/wiki/ci/the-gatekeeper-1","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#the-gatesh-execution-loop","content":"The `gate.sh` execution loop"},"5139":{"id":"/wiki/ci/the-gatekeeper-2","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#the-jvm-and-client-lifecycle","content":"The `jvm` and `client` lifecycle"},"5140":{"id":"/wiki/ci/the-gatekeeper-3","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#the-conformance-check","content":"The `conformance` check"},"5141":{"id":"/wiki/ci/the-gatekeeper-4","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#the-check-job-and-the-image-job-separation","content":"The `check` job and the `image` job separation"},"5142":{"id":"/wiki/ci/the-gatekeeper-5","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#key-files","content":"Key files"},"5143":{"id":"/wiki/ci/the-gatekeeper-6","page_id":"/wiki/ci/the-gatekeeper","type":"heading","tags":[],"url":"/wiki/ci/the-gatekeeper#behaviour-that-surprises","content":"Behaviour that surprises"},"5144":{"id":"/wiki/ci/the-gatekeeper-7","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"5145":{"id":"/wiki/ci/the-gatekeeper-8","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#the-gatesh-execution-loop","content":"The core of the gate is the `part` function, which encapsulates the execution of a command and its reporting `gate.sh:43-85`. To maintain honesty in environments where certain toolchains are missing, the script utilizes the `SKIPPED_CODE` (77) convention `gate.sh:24-35`. This allows the script to report that a part was \"skipped\" rather than \"failed,\" preventing a machine without a Go toolchain from reporting a broken Go client when the developer simply hasn't installed the necessary dependencies `gate.sh:132-142`."},"5146":{"id":"/wiki/ci/the-gatekeeper-9","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#the-jvm-and-client-lifecycle","content":"The execution follows a strict dependency chain to ensure efficiency and correctness. The `jvm` part runs the core Gradle checks `gate.sh:101`. For any client module, the gate first executes the client's own internal `gate.sh` `gate.sh:109-114`. A client's conformance check is only triggered if its own unit tests pass and a conformance binary exists `gate.sh:117-120`. To prevent redundant work during the Docker-based image build, the `BOOBLIK_SKIP_GATE` environment variable is used to skip the redundant execution of the gate within the containerized environment `gate.sh:39-40`."},"5147":{"id":"/wiki/ci/the-gatekeeper-10","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#the-conformance-check","content":"The final and most heavy-weight stage is the `conformance` check, which validates the reference client against a live broker `gate.sh:124`. This stage is unique because it requires both a Docker daemon to run the broker and a Gradle environment to manage the test orchestration. It is the only part of the gate that performs an end-to-end verification of the protocol by running a client against a real, running instance of the broker `gate.sh:119`."},"5148":{"id":"/wiki/ci/the-gatekeeper-11","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#the-check-job-and-the-image-job-separation","content":"The CI architecture splits the verification into two distinct jobs in `build.yml:14-90`. The `check` job runs on a standard runner to perform JVM-based tests and smoke tests without requiring Docker `build.yml:35-48`. The `image` job is separated because it requires a Docker daemon and is responsible for verifying the actual containerized process, including the six specific JVM profile flags `docker-smoke.sh:73-84`. This separation ensures that environmental issues in the Docker layer do not mask code-level failures in the JVM layer."},"5149":{"id":"/wiki/ci/the-gatekeeper-12","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"File"},"5150":{"id":"/wiki/ci/the-gatekeeper-13","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"Lines"},"5151":{"id":"/wiki/ci/the-gatekeeper-14","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"What is there"},"5152":{"id":"/wiki/ci/the-gatekeeper-15","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`ci/gate.sh`"},"5153":{"id":"/wiki/ci/the-gatekeeper-16","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`43-85`"},"5154":{"id":"/wiki/ci/the-gatekeeper-17","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"The `part` function logic and exit code handling"},"5155":{"id":"/wiki/ci/the-gatekeeper-18","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`ci/gate.sh`"},"5156":{"id":"/wiki/ci/the-gatekeeper-19","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`109-121`"},"5157":{"id":"/wiki/ci/the-gatekeeper-20","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"The client lifecycle and conformance loop"},"5158":{"id":"/wiki/ci/the-gatekeeper-21","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`…/workflows/build.yml`"},"5159":{"id":"/wiki/ci/the-gatekeeper-22","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`14-90`"},"5160":{"id":"/wiki/ci/the-gatekeeper-23","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"The separation of `check` and `image` jobs"},"5161":{"id":"/wiki/ci/the-gatekeeper-24","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`ci/docker-smoke.sh`"},"5162":{"id":"/wiki/ci/the-gatekeeper-25","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"`73-84`"},"5163":{"id":"/wiki/ci/the-gatekeeper-26","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#key-files","content":"Verification of the six JVM profile flags"},"5164":{"id":"/wiki/ci/the-gatekeeper-27","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#behaviour-that-surprises","content":"The `part` function uses a `case` statement to handle exit codes, ensuring that a command's failure is captured correctly even when using `PIPESTATUS` in a pipeline `gate.sh:65-67`."},"5165":{"id":"/wiki/ci/the-gatekeeper-28","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#behaviour-that-surprises","content":"The `gate.sh` script uses a `trap` to ensure that the temporary directory used for storing logs is cleaned up upon exit `gate.sh:26`."},"5166":{"id":"/wiki/ci/the-gatekeeper-29","page_id":"/wiki/ci/the-gatekeeper","tags":[],"type":"text","url":"/wiki/ci/the-gatekeeper#behaviour-that-surprises","content":"In `ci/docker-smoke.sh`, the script uses a `for` loop to iterate through a specific list of JVM flags to ensure the runtime profile matches the measured requirements `docker-smoke.sh:76-83`."},"5167":{"id":"/wiki/ci/the-performance-floor","page_id":"/wiki/ci/the-performance-floor","type":"page","content":"The performance floor","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-performance-floor"},"5168":{"id":"/wiki/ci/the-performance-floor-0","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#diagram","content":"Diagram"},"5169":{"id":"/wiki/ci/the-performance-floor-1","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#the-benchmark-floor","content":"The benchmark floor"},"5170":{"id":"/wiki/ci/the-performance-floor-2","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"SegmentMode and the disk barrier"},"5171":{"id":"/wiki/ci/the-performance-floor-3","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"SparseOffsetIndex"},"5172":{"id":"/wiki/ci/the-performance-floor-4","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"Recovery after a crash"},"5173":{"id":"/wiki/ci/the-performance-floor-5","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#the-write-actor-and-group-commit","content":"The write actor and group commit"},"5174":{"id":"/wiki/ci/the-performance-floor-6","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#key-files","content":"Key files"},"5175":{"id":"/wiki/ci/the-performance-floor-7","page_id":"/wiki/ci/the-performance-floor","type":"heading","tags":[],"url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"Behaviour that surprises"},"5176":{"id":"/wiki/ci/the-performance-floor-8","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"5177":{"id":"/wiki/ci/the-performance-floor-9","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#the-benchmark-floor","content":"The logic and purpose of the CI check is to provide a \"floor\" that is an order of magnitude below the slowest plausible runner to avoid false positives caused by hardware variance. As noted in `benchmark-floor.sh:11-13`, the check deliberately ignores fine-grained regressions because different CI runs occur on different machines with different neighbors, making percentage-based comparisons unreliable. The script calculates a score by parsing the JMH report and comparing the whole number part of the throughput against a predefined threshold (`benchmark-floor.sh:24-51`)."},"5178":{"id":"/wiki/ci/the-performance-floor-10","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"The benchmarks distinguish between different write paths, specifically focusing on how they interact with the disk barrier. The `mainCiBenchmark` task excludes certain rows to avoid measuring the \"disk barrier\" (the cost of `fsync` or `msync`), which is too variable on hosted runners to be meaningful (`benchmark.yml:22-28`). The two primary modes are:"},"5179":{"id":"/wiki/ci/the-performance-floor-11","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Mode"},"5180":{"id":"/wiki/ci/the-performance-floor-12","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Description"},"5181":{"id":"/wiki/ci/the-performance-floor-13","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"`FILE_CHANNEL`"},"5182":{"id":"/wiki/ci/the-performance-floor-14","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Uses `FileChannel` where the file length acts as a boundary for recovery (`RecoveryTest.kt:67-71`)."},"5183":{"id":"/wiki/ci/the-performance-floor-15","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"`MAPPED`"},"5184":{"id":"/wiki/ci/the-performance-floor-16","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#segmentmode-and-the-disk-barrier","content":"Uses memory mapping where the file is pre-sized, requiring a zero-length prefix to mark record boundaries (`RecoveryTest.kt:87-91`)."},"5185":{"id":"/wiki/ci/the-performance-floor-17","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"The `SparseOffsetIndex` provides a memory-efficient way to map offsets to positions without the allocation overhead of a standard `Map`. It uses a `LongArray` where each entry stores a relative offset in the high 32 bits and a position in the low 32 bits (`SparseOffsetIndex.kt:15-16`)."},"5186":{"id":"/wiki/ci/the-performance-floor-18","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"The mechanics of the index include:"},"5187":{"id":"/wiki/ci/the-performance-floor-19","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Sparsity**: An entry is only added when `intervalBytes` (default 4 KiB) of log data has passed (`SparseOffsetIndex.kt:73-75`)."},"5188":{"id":"/wiki/ci/the-performance-floor-20","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Lookup**: A binary search is performed on the `entries` array to find the largest entry where the relative offset is less than or equal to the target (`SparseOffsetIndex.kt:124-136`)."},"5189":{"id":"/wiki/ci/the-performance-floor-21","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#sparseoffsetindex","content":"**Concurrency**: The `count` is marked `@Volatile` and updated after the array slot is filled to ensure readers see a consistent view (`SparseOffsetIndex.kt:80-82`)."},"5190":{"id":"/wiki/ci/the-performance-floor-22","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"The system is designed to survive a `SIGKILL` during a write operation, ensuring the log remains usable. The invariant is that reopening the log must result in a log that ends on a record boundary with valid checksums (`CrashRecoveryTest.kt:24-28`)."},"5191":{"id":"/wiki/ci/the-performance-floor-23","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"Recovery behavior depends on the `SegmentMode`:"},"5192":{"id":"/wiki/ci/the-performance-floor-24","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"**FILE\\_CHANNEL**: Recovery stops at the last intact record boundary because the file length bounds the data (`RecoveryTest.kt:67-71`)."},"5193":{"id":"/wiki/ci/the-performance-floor-25","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#recovery-after-a-crash","content":"**MAPPED**: Since the file is pre-sized, recovery relies on the fact that the writer stores the body before the prefix; a crash leaves an \"orphaned body\" without a header, which is treated as the end of the log (`RecoveryTest.kt:87-91`)."},"5194":{"id":"/wiki/ci/the-performance-floor-26","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#the-write-actor-and-group-commit","content":"The interaction between `append` calls and the `force` mechanism is central to performance. In a real scenario, group commits allow many appends to be collapsed into a single barrier. This can be tested using `CountingLog`, which tracks the number of `append` calls versus `force` calls (`CountingLog.kt:10-12`). By using `forceMillis` in the test, one can simulate a slow barrier to ensure that the grouping of multiple appends into a single `force` call is functioning as expected (`CountingLog.kt:44`)."},"5195":{"id":"/wiki/ci/the-performance-floor-27","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"File"},"5196":{"id":"/wiki/ci/the-performance-floor-28","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Lines"},"5197":{"id":"/wiki/ci/the-performance-floor-29","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"What is there"},"5198":{"id":"/wiki/ci/the-performance-floor-30","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`ci/benchmark-floor.sh`"},"5199":{"id":"/wiki/ci/the-performance-floor-31","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`24-25`"},"5200":{"id":"/wiki/ci/the-performance-floor-32","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Definition of the floor thresholds for `FILE_CHANNEL` and `MAPPED`."},"5201":{"id":"/wiki/ci/the-performance-floor-33","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`…/storage/SparseOffsetIndex.kt`"},"5202":{"id":"/wiki/ci/the-performance-floor-34","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`130-136`"},"5203":{"id":"/wiki/ci/the-performance-floor-35","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"Binary search implementation for the sparse index lookup."},"5204":{"id":"/wiki/ci/the-performance-floor-36","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`…/log/CountingLog.kt`"},"5205":{"id":"/wiki/ci/the-performance-floor-37","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"`37-40`"},"5206":{"id":"/wiki/ci/the-performance-floor-38","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#key-files","content":"The `append` implementation that increments the `appendCount`."},"5207":{"id":"/wiki/ci/the-performance-floor-39","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"The `SparseOffsetIndex` uses a `LongArray` instead of a `ConcurrentSkipListMap` specifically to avoid boxing `Offset` and `Position` values, which would cause allocations in the hot path (`SparseOffsetIndex.kt:13-15`)."},"5208":{"id":"/wiki/ci/the-performance-floor-40","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"In `MAPPED` mode, a crash can leave \"orphaned\" bytes in the file that are not considered part of the log because they lack a valid header (`RecoveryTest.kt:97-98`)."},"5209":{"id":"/wiki/ci/the-performance-floor-41","page_id":"/wiki/ci/the-performance-floor","tags":[],"type":"text","url":"/wiki/ci/the-performance-floor#behaviour-that-surprises","content":"The `count` in `SparseOffsetIndex` is updated *after* the entry is written to the array to ensure that a reader seeing a new `count` is guaranteed to see the corresponding data in the array (`SparseOffsetIndex.kt:80-82`)."},"5210":{"id":"/wiki/ci/the-smoke-test","page_id":"/wiki/ci/the-smoke-test","type":"page","content":"The Smoke Test","breadcrumbs":["Docs","Wiki","ci"],"tags":[],"url":"/wiki/ci/the-smoke-test"},"5211":{"id":"/wiki/ci/the-smoke-test-0","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#what-this-module-is-responsible-for","content":"What this module is responsible for"},"5212":{"id":"/wiki/ci/the-smoke-test-1","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#diagram","content":"Diagram"},"5213":{"id":"/wiki/ci/the-smoke-test-2","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#the-distribution-lifecycle","content":"The Distribution Lifecycle"},"5214":{"id":"/wiki/ci/the-smoke-test-3","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"The Wire Protocol and CRC32C Verification"},"5215":{"id":"/wiki/ci/the-smoke-test-4","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#the-log-recovery-and-restart-mechanism","content":"The Log Recovery and Restart Mechanism"},"5216":{"id":"/wiki/ci/the-smoke-test-5","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"The Docker Runtime Profile"},"5217":{"id":"/wiki/ci/the-smoke-test-6","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#sparse-segment-materialization","content":"Sparse Segment Materialization"},"5218":{"id":"/wiki/ci/the-smoke-test-7","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#the-health-check-and-metadata-interface","content":"The Health Check and METADATA Interface"},"5219":{"id":"/wiki/ci/the-smoke-test-8","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#key-files","content":"Key files"},"5220":{"id":"/wiki/ci/the-smoke-test-9","page_id":"/wiki/ci/the-smoke-test","type":"heading","tags":[],"url":"/wiki/ci/the-smoke-test#behaviour-that-surprises","content":"Behaviour that surprises"},"5221":{"id":"/wiki/ci/the-smoke-test-10","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"5222":{"id":"/wiki/ci/the-smoke-test-11","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#what-this-module-is-responsible-for","content":"The Smoke Test module ensures that the built distribution and the resulting Docker image are actually functional in a real-world runtime environment. While unit tests verify logic, the smoke tests verify **delivery**: they ensure that configuration is correctly read, the `main` method doesn't die at startup, and the containerized environment preserves the intended runtime profile and security constraints."},"5223":{"id":"/wiki/ci/the-smoke-test-12","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-distribution-lifecycle","content":"The smoke test starts by building the full distribution using the Gradle `installDist` task (`smoke.sh:31`). Once built, it launches the broker as a background process and waits for the \"booblik listening\" log entry to confirm it has successfully bound to the network (`smoke.sh:41`). The lifecycle concludes by killing the broker and starting a second instance to ensure the system can transition from a stopped to a running state without losing data (`smoke.sh:131`)."},"5224":{"id":"/wiki/ci/the-smoke-test-13","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"To ensure the implementation hasn't drifted from the specification, a Python script is used to communicate over a raw socket (`smoke.sh:47`). This script is intentionally written in a language that shares no code with the Kotlin implementation, acting as an independent validator of the binary format (`smoke.sh:51`). It performs the following checks:"},"5225":{"id":"/wiki/ci/the-smoke-test-14","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Field"},"5226":{"id":"/wiki/ci/the-smoke-test-15","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Type"},"5227":{"id":"/wiki/ci/the-smoke-test-16","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Description"},"5228":{"id":"/wiki/ci/the-smoke-test-17","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`length`"},"5229":{"id":"/wiki/ci/the-smoke-test-18","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`int32`"},"5230":{"id":"/wiki/ci/the-smoke-test-19","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Size of the body"},"5231":{"id":"/wiki/ci/the-smoke-test-20","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`apiKey`"},"5232":{"id":"/wiki/ci/the-smoke-test-21","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`int16`"},"5233":{"id":"/wiki/ci/the-smoke-test-22","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Request type"},"5234":{"id":"/wiki/ci/the-smoke-test-23","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`apiVersion`"},"5235":{"id":"/wiki/ci/the-smoke-test-24","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`int16`"},"5236":{"id":"/wiki/ci/the-smoke-test-25","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Protocol version"},"5237":{"id":"/wiki/ci/the-smoke-test-26","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`correlationId`"},"5238":{"id":"/wiki/ci/the-smoke-test-27","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`int32`"},"5239":{"id":"/wiki/ci/the-smoke-test-28","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Request/Response matching"},"5240":{"id":"/wiki/ci/the-smoke-test-29","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`crc32c`"},"5241":{"id":"/wiki/ci/the-smoke-test-30","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"`int32`"},"5242":{"id":"/wiki/ci/the-smoke-test-31","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"Per-record checksum (Castagnoli)"},"5243":{"id":"/wiki/ci/the-smoke-test-32","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-wire-protocol-and-crc32c-verification","content":"The client manually calculates the CRC32C for each record and asserts that the broker's returned checksum matches the expected value (`smoke.sh:125`)."},"5244":{"id":"/wiki/ci/the-smoke-test-33","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-log-recovery-and-restart-mechanism","content":"The tests verify that the append-only log is durable across process restarts. After the first broker instance is killed, a new instance is started using the same properties file (`smoke.sh:133`). The test then verifies that the log segment is recovered by checking that the broker reports the correct offset range for the \"smoke\" topic (`smoke.sh:139`)."},"5245":{"id":"/wiki/ci/the-smoke-test-34","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"The `ci/docker-smoke.sh` script validates that the Docker image preserves the specific resource constraints required for the broker's performance profile. It extracts the `jvm:` line from the container logs and verifies that all six mandatory flags are present (`docker-smoke.sh:75`). These flags include:"},"5246":{"id":"/wiki/ci/the-smoke-test-35","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Flag"},"5247":{"id":"/wiki/ci/the-smoke-test-36","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Purpose"},"5248":{"id":"/wiki/ci/the-smoke-test-37","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-XX:+UseSerialGC`"},"5249":{"id":"/wiki/ci/the-smoke-test-38","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Garbage Collection strategy"},"5250":{"id":"/wiki/ci/the-smoke-test-39","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-XX:ReservedCodeCacheSize=32M`"},"5251":{"id":"/wiki/ci/the-smoke-test-40","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Code cache limit"},"5252":{"id":"/wiki/ci/the-smoke-test-41","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-XX:MaxDirectMemorySize=32M`"},"5253":{"id":"/wiki/ci/the-smoke-test-42","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Direct memory limit"},"5254":{"id":"/wiki/ci/the-smoke-test-43","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-Xss256k`"},"5255":{"id":"/wiki/ci/the-smoke-test-44","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Thread stack size"},"5256":{"id":"/wiki/ci/the-smoke-test-45","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-XX:MaxMetaspaceSize=80M`"},"5257":{"id":"/wiki/ci/the-smoke-test-46","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Metaspace limit"},"5258":{"id":"/wiki/ci/the-smoke-test-47","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"`-Xmx64M`"},"5259":{"id":"/wiki/ci/the-smoke-test-48","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Heap memory limit"},"5260":{"id":"/wiki/ci/the-smoke-test-49","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-docker-runtime-profile","content":"Additionally, it ensures the process does not run as `root` by checking the `id -un` output (`docker-smoke.sh:95`)."},"5261":{"id":"/wiki/ci/the-smoke-test-50","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#sparse-segment-materialization","content":"To optimize disk usage, the broker uses sparse files for its segments. The smoke test executes a command inside the container to locate the latest `.log` segment and uses `stat` to check its apparent size versus its actual disk occupation (`docker-smoke.sh:102`). It asserts that the actual blocks occupied are significantly less than the apparent size, confirming that the segment is indeed sparse (`docker-smoke.sh:104`)."},"5262":{"id":"/wiki/ci/the-smoke-test-51","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#the-health-check-and-metadata-interface","content":"The health check mechanism is tested to ensure it provides meaningful status. It validates that the `booblik-health` tool correctly identifies a live broker via the `METADATA` interface (`docker-smoke.sh:87`). Crucially, it also verifies that the health check does not report a \"healthy\" status if it is attempting to connect to a port that is not actually listening (`docker-smoke.sh:88`)."},"5263":{"id":"/wiki/ci/the-smoke-test-52","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"File"},"5264":{"id":"/wiki/ci/the-smoke-test-53","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"Lines"},"5265":{"id":"/wiki/ci/the-smoke-test-54","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"What is there"},"5266":{"id":"/wiki/ci/the-smoke-test-55","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`ci/smoke.sh`"},"5267":{"id":"/wiki/ci/the-smoke-test-56","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`47-128`"},"5268":{"id":"/wiki/ci/the-smoke-test-57","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"Python-based independent wire protocol validator"},"5269":{"id":"/wiki/ci/the-smoke-test-58","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`ci/docker-smoke.sh`"},"5270":{"id":"/wiki/ci/the-smoke-test-59","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`75-83`"},"5271":{"id":"/wiki/ci/the-smoke-test-60","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"JVM flag profile verification logic"},"5272":{"id":"/wiki/ci/the-smoke-test-61","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`ci/docker-smoke.sh`"},"5273":{"id":"/wiki/ci/the-smoke-test-62","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`94-95`"},"5274":{"id":"/wiki/ci/the-smoke-test-63","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"Non-root user identity check"},"5275":{"id":"/wiki/ci/the-smoke-test-64","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`ci/docker-smoke.sh`"},"5276":{"id":"/wiki/ci/the-smoke-test-65","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"`102-104`"},"5277":{"id":"/wiki/ci/the-smoke-test-66","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#key-files","content":"Sparse file/segment verification"},"5278":{"id":"/wiki/ci/the-smoke-test-67","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#behaviour-that-surprises","content":"The `transferTo` method in the transport layer only provides zero-copy performance when the target is a `SocketChannel` (`README.md:211`)."},"5279":{"id":"/wiki/ci/the-smoke-test-68","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#behaviour-that-surprises","content":"The `booblik-app` start script is responsible for baking the JVM profile into the distribution, but this can be silently overridden by a `JAVA_OPTS` line in a `Dockerfile` (`README.md:80`)."},"5280":{"id":"/wiki/ci/the-smoke-test-69","page_id":"/wiki/ci/the-smoke-test","tags":[],"type":"text","url":"/wiki/ci/the-smoke-test#behaviour-that-surprises","content":"The `booblik-client` is a \"shared codec\" that is used by both the client and the server to ensure the wire format remains consistent (`README.md:222`)."},"5281":{"id":"/wiki/clients-dotnet-Booblik/connection","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"page","content":"Connection","breadcrumbs":["Docs","Wiki","clients/dotnet/Booblik"],"tags":[],"url":"/wiki/clients-dotnet-Booblik/connection"},"5282":{"id":"/wiki/clients-dotnet-Booblik/connection-0","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#what-this-module-is-responsible-for","content":"What this module is responsible for"},"5283":{"id":"/wiki/clients-dotnet-Booblik/connection-1","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#diagram","content":"Diagram"},"5284":{"id":"/wiki/clients-dotnet-Booblik/connection-2","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#connection-lifecycle-and-thread-safety","content":"Connection Lifecycle and Thread Safety"},"5285":{"id":"/wiki/clients-dotnet-Booblik/connection-3","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#request-response-correlation-and-framing","content":"Request-Response Correlation and Framing"},"5286":{"id":"/wiki/clients-dotnet-Booblik/connection-4","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#protocol-error-handling-and-validation","content":"Protocol Error Handling and Validation"},"5287":{"id":"/wiki/clients-dotnet-Booblik/connection-5","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Metadata Decoding and Partition Information"},"5288":{"id":"/wiki/clients-dotnet-Booblik/connection-6","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#produce-and-fetch-request-mechanics","content":"Produce and Fetch Request Mechanics"},"5289":{"id":"/wiki/clients-dotnet-Booblik/connection-7","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#key-files","content":"Key files"},"5290":{"id":"/wiki/clients-dotnet-Booblik/connection-8","page_id":"/wiki/clients-dotnet-Booblik/connection","type":"heading","tags":[],"url":"/wiki/clients-dotnet-Booblik/connection#behaviour-that-surprise","content":"Behaviour that surprise"},"5291":{"id":"/wiki/clients-dotnet-Booblik/connection-9","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"5292":{"id":"/wiki/clients-dotnet-Booblik/connection-10","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#what-this-module-is-responsible-for","content":"The `Connection` class provides a low-level, non-thread-safe transport for the Booblik protocol, managing the lifecycle of a single TCP connection and the framing of request/response pairs (`Connection.cs:40-41`)."},"5293":{"id":"/wiki/clients-dotnet-Booblik/connection-11","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#connection-lifecycle-and-thread-safety","content":"The `Connection` class is explicitly marked as not safe for concurrent use (`Connection.cs:36-38`). Because requests and responses are matched by a `correlationId` in the order they are sent (`Connection.cs:36-37`), multiple callers sharing a single `Connection` would cause interleaved data, where one caller reads the response intended for another (`Connection.cs:37`). To avoid this, the architecture requires one `Connection` per caller or the use of a `Producer` which manages its own instance (`Connection.cs:38`)."},"5294":{"id":"/wiki/clients-dotnet-Booblik/connection-12","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#request-response-correlation-and-framing","content":"The communication relies on a strict framing mechanism where `SendAsync` increments a `_correlation` counter and writes a frame containing the `apiKey`, `apiVersion`, and `correlationId` (`Connection.cs:90-97`). The `ReceiveAsync` method then reads the response frame and performs a critical check: if the received `correlation` does not match the `expect` value, a `ProtocolException` is thrown (`Connection.cs:124-126`). This ensures that the client does not misinterpret a response as belonging to a different request, which would otherwise lead to incorrect offsets being handed to the wrong caller (`Connection.cs:122-123`)."},"5295":{"id":"/wiki/clients-dotnet-Booblik/connection-13","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#protocol-error-handling-and-validation","content":"The client performs several layers of validation during the response phase:"},"5296":{"id":"/wiki/clients-dotnet-Booblik/connection-14","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#protocol-error-handling-and-validation","content":"**Frame Integrity**: If the response length is outside the allowed range (`ResponseHeaderBytes` to `MaxFrameBytes`), a `ProtocolException` is raised (`Connection.cs:110-112`)."},"5297":{"id":"/wiki/clients-dotnet-Booblik/connection-15","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#protocol-error-handling-and-validation","content":"**Correlation Matching**: As noted above, mismatched IDs trigger a `ProtocolException` (`Connection.cs:126`)."},"5298":{"id":"/wiki/clients-dotnet-Booblik/connection-16","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#protocol-error-handling-and-validation","content":"**Broker Errors**: If the response contains a non-zero error code, a `BrokerException` is thrown (`Connection.cs:131`)."},"5299":{"id":"/wiki/clients-dotnet-Booblik/connection-17","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"The `MetadataAsync` method triggers a request to find topics and their partition states (`Connection.cs:145`). The response is processed by `DecodeMetadata`, which iterates through the byte stream to extract:"},"5300":{"id":"/wiki/clients-dotnet-Booblik/connection-18","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Field"},"5301":{"id":"/wiki/clients-dotnet-Booblik/connection-19","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Type"},"5302":{"id":"/wiki/clients-dotnet-Booblik/connection-20","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Description"},"5303":{"id":"/wiki/clients-dotnet-Booblik/connection-21","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"`topicCount`"},"5304":{"id":"/wiki/clients-dotnet-Booblik/connection-22","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Int32"},"5305":{"id":"/wiki/clients-dotnet-Booblik/connection-23","page_id":"/wiki/clients-dotnet-Booblik/connection","tags":[],"type":"text","url":"/wiki/clients-dotnet-Booblik/connection#metadata-decoding-and-partition-information","content":"Number of topics in the response (`Connection.cs:310`)"},"5306":{"id":"/wiki/clients-dotnet-Booblik/connection-24","page_