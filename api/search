client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Why"},"3424":{"id":"/wiki/booblik-client-44","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`BooblikClient`"},"3425":{"id":"/wiki/booblik-client-45","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`BooblikClient.kt:24`"},"3426":{"id":"/wiki/booblik-client-46","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Low-level client for raw requests."},"3427":{"id":"/wiki/booblik-client-47","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`BooblikConnection`"},"3428":{"id":"/wiki/booblik-client-48","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`BooblikConnection.kt:50`"},"3429":{"id":"/wiki/booblik-client-49","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Pipelined connection for concurrent requests."},"3430":{"id":"/wiki/booblik-client-50","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`Producer`"},"3431":{"id":"/wiki/booblik-client-51","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`Producer.kt:54`"},"3432":{"id":"/wiki/booblik-client-52","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"High-level batching producer."},"3433":{"id":"/wiki/booblik-client-53","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`ProducerConfig`"},"3434":{"id":"/wiki/booblik-client-54","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`Producer.kt:21`"},"3435":{"id":"/wiki/booblik-client-55","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Configuration for batching and ack policy."},"3436":{"id":"/wiki/booblik-client-56","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`Consumer`"},"3437":{"id":"/wiki/booblik-client-57","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`Consumer.kt:56`"},"3438":{"id":"/wiki/booblik-client-58","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Stateful partition reader."},"3439":{"id":"/wiki/booblik-client-59","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`ResponseReader`"},"3440":{"id":"/wiki/booblik-client-60","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`ResponseReader.kt:55`"},"3441":{"id":"/wiki/booblik-client-61","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Object for decoding response frames."},"3442":{"id":"/wiki/booblik-client-62","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`ResponseEncoder`"},"3443":{"id":"/wiki/booblik-client-63","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"`ResponseEncoder.kt:15`"},"3444":{"id":"/wiki/booblik-client-64","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#public-api","content":"Object for encoding response frames."},"3445":{"id":"/wiki/booblik-client-65","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#behaviour-that-surprises","content":"The `Producer` uses a `select` expression in its `runLoop` to avoid a specific bug where a cancelled `receive` could drop elements from the `mailbox`, potentially causing callers to wait forever `Producer.kt:154-158`."},"3446":{"id":"/wiki/booblik-client-66","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#behaviour-that-surprises","content":"The `Consumer` can throw a `RecordExceedsMaxBytesException` if a record is larger than the `maxBytes` limit, which results in a permanent stall if the reader does not increase its limit `Consumer.kt:28-36`."},"3447":{"id":"/wiki/booblik-client-67","page_id":"/wiki/booblik-client","tags":[],"type":"text","url":"/wiki/booblik-client#behaviour-that-surprises","content":"The `ResponseEncoder` uses a \"promised\" vs \"inline\" byte mechanism for `fetchHeader` to allow the client to perform zero-copy reads of the response body `ResponseEncoder.kt:39-41`."},"3448":{"id":"/wiki/booblik-client/producer","page_id":"/wiki/booblik-client/producer","type":"page","content":"Producer","breadcrumbs":["Docs","Wiki","booblik-client"],"tags":[],"url":"/wiki/booblik-client/producer"},"3449":{"id":"/wiki/booblik-client/producer-0","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3450":{"id":"/wiki/booblik-client/producer-1","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#diagram","content":"Diagram"},"3451":{"id":"/wiki/booblik-client/producer-2","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#the-accumulator","content":"The Accumulator"},"3452":{"id":"/wiki/booblik-client/producer-3","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#commandappend-and-commandflush","content":"Command.Append and Command.Flush"},"3453":{"id":"/wiki/booblik-client/producer-4","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"AckPolicy and Batch Delivery"},"3454":{"id":"/wiki/booblik-client/producer-5","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#the-lost-record-edge-case","content":"The Lost Record Edge Case"},"3455":{"id":"/wiki/booblik-client/producer-6","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#batching-performance-and-throughput","content":"Batching Performance and Throughput"},"3456":{"id":"/wiki/booblik-client/producer-7","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#key-files","content":"Key files"},"3457":{"id":"/wiki/booblik-client/producer-8","page_id":"/wiki/booblik-client/producer","type":"heading","tags":[],"url":"/wiki/booblik-client/producer#behaviour-that-surprises","content":"Behaviour that surprises"},"3458":{"id":"/wiki/booblik-client/producer-9","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"3459":{"id":"/wiki/booblik-client/producer-10","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#what-this-module-is-responsible-for","content":"The `Producer` is responsible for accumulating individual records into batches to maximize throughput by reducing the number of network requests. It acts as an intermediary between the user's `send` calls and the `BooblikConnection`, managing the lifecycle of records from their arrival in a mailbox to their delivery to the broker."},"3460":{"id":"/wiki/booblik-client/producer-11","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#the-accumulator","content":"The core of the producer is the accumulation loop, which manages pending records in a `LinkedHashMap` of `Key` to `Batch` (`Producer.kt:70-71`). Instead of sending records immediately, the producer waits until either the `maxBatchSize` is reached or the `lingerMillis` window expires (`Producer.kt:23-32`). Crucially, the timer for the `lingerMillis` window starts from the arrival of the *first* record in a batch, not the last, to prevent a steady trickle of records from indefinitely postponing a send (`Producer.kt:47-49`)."},"3461":{"id":"/wiki/booblik-client/producer-12","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#commandappend-and-commandflush","content":"The `runLoop` operates by consuming commands from a buffered `mailbox` channel (`Producer.kt:59`)."},"3462":{"id":"/wiki/booblik-client/producer-13","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#commandappend-and-commandflush","content":"`Command.Append`: Adds a record to the corresponding partition's batch via `accumulate` (`Producer.kt:132-134`)."},"3463":{"id":"/wiki/booblik-client/producer-14","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#commandappend-and-commandflush","content":"`Command.Flush`: Triggers an immediate `sendAll()` and completes the command's deferred value, forcing all currently accumulated batches to be delivered to the connection (`Producer.kt:126-128`)."},"3464":{"id":"/wiki/booblik-client/producer-15","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"The `deliver` function handles the actual network transmission and the subsequent response from the broker (`Producer.kt:195-220`). The behavior of the caller depends on the `AckPolicy`:"},"3465":{"id":"/wiki/booblik-client/producer-16","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"Policy"},"3466":{"id":"/wiki/booblik-client/producer-17","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"Behavior"},"3467":{"id":"/wiki/booblik-client/producer-18","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"`WRITTEN`"},"3468":{"id":"/wiki/booblik-client/producer-19","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"The `CompletableDeferred` is completed with the broker-provided offset (`Producer.kt:214-216`)."},"3469":{"id":"/wiki/booblik-client/producer-20","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"`NONE`"},"3470":{"id":"/wiki/booblik-client/producer-21","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#ackpolicy-and-batch-delivery","content":"The `CompletableDeferred` is completed with `Offset.ZERO` to indicate the batch was sent, even though no broker confirmation was received (`Producer.kt:204-206`)."},"3471":{"id":"/wiki/booblik-client/producer-22","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#the-lost-record-edge-case","content":"A critical edge case occurs when a `receive` operation on the `mailbox` is cancelled (e.g., due to a timeout in `select`) at the exact moment a record is being delivered to the channel. If `withTimeoutOrNull` were used instead of `select`, a cancelled receive could swallow a record, leaving the caller's `CompletableDeferred` hanging forever (`Producer.kt:143-146`). This specific race condition is verified in `ProducerLostRecordTest.kt:52-94`, where two topics at different rates are used to force the collision."},"3472":{"id":"/wiki/booblik-client/producer-23","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#batching-performance-and-throughput","content":"Batching is the single largest performance factor in the project. As noted in `benchmarking.md:140-146`, the difference between sending records one at a time and sending them in batches of 100 can result in a performance increase of approximately 54× (`Producer.kt:39-42`). The `ProducerConfig` allows tuning this via `maxBatchSize` and `lingerMillis` (`ProducerConfig.java:4-16`)."},"3473":{"id":"/wiki/booblik-client/producer-24","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"File"},"3474":{"id":"/wiki/booblik-client/producer-25","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"Lines"},"3475":{"id":"/wiki/booblik-client/producer-26","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"What is there"},"3476":{"id":"/wiki/booblik-client/producer-27","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`…/client/Producer.kt`"},"3477":{"id":"/wiki/booblik-client/producer-28","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`21-34`"},"3478":{"id":"/wiki/booblik-client/producer-29","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`ProducerConfig` data class and its default values"},"3479":{"id":"/wiki/booblik-client/producer-30","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`…/client/Producer.kt`"},"3480":{"id":"/wiki/booblik-client/producer-31","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`54-173`"},"3481":{"id":"/wiki/booblik-client/producer-32","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"The `Producer` class and its `runLoop` implementation"},"3482":{"id":"/wiki/booblik-client/producer-33","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`…/client/Producer.kt`"},"3483":{"id":"/wiki/booblik-client/producer-34","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`253-263`"},"3484":{"id":"/wiki/booblik-client/producer-35","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"The `Command` sealed interface for the mailbox"},"3485":{"id":"/wiki/booblik-client/producer-36","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`…/net/ClientTest.kt`"},"3486":{"id":"/wiki/booblik-client/producer-37","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`84-96`"},"3487":{"id":"/wiki/booblik-client/producer-38","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"Tests verifying batching and `flush` behavior"},"3488":{"id":"/wiki/booblik-client/producer-39","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`…/net/ProducerLostRecordTest.kt`"},"3489":{"id":"/wiki/booblik-client/producer-40","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"`52-103`"},"3490":{"id":"/wiki/booblik-client/producer-41","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#key-files","content":"Test for the race condition in the accumulator"},"3491":{"id":"/wiki/booblik-client/producer-42","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#behaviour-that-surprises","content":"The `lingerMillis` timer is not reset on every new record; it is fixed from the moment the first record of a batch arrives (`Producer.kt:47-49`)."},"3492":{"id":"/wiki/booblik-client/producer-43","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#behaviour-that-surprises","content":"Using `select` with `onReceiveCatching` is mandatory in the `runLoop` to prevent the producer from \"swallowing\" records during a timeout, which would cause callers to hang (`Producer.kt:154-158`)."},"3493":{"id":"/wiki/booblik-client/producer-44","page_id":"/wiki/booblik-client/producer","tags":[],"type":"text","url":"/wiki/booblik-client/producer#behaviour-that-surprises","content":"`AckPolicy.NONE` does not actually wait for a broker response, but it still completes the record's `CompletableDeferred` with `Offset.ZERO` to maintain a consistent API (`Producer.kt:204-206`)."},"3494":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"page","content":"FetchDecodeBenchmark and the JVM reader cost","breadcrumbs":["Docs","Wiki","booblik-benchmark"],"tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the"},"3495":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-0","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3496":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-1","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#diagram","content":"Diagram"},"3497":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-2","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#the-fetch-decoder-dilemma","content":"The Fetch decoder dilemma"},"3498":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-3","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#responsereader-vs-responsedecoder","content":"ResponseReader vs ResponseDecoder"},"3499":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-4","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"RecordSize and throughput scaling"},"3500":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-5","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#corruptrecordexception-and-offset-mapping","content":"CorruptRecordException and offset mapping"},"3501":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-6","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#truncated-response-handling","content":"Truncated response handling"},"3502":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-7","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"Key files"},"3503":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-8","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#behaviour-that-surprises","content":"Behaviour that surprises"},"3504":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-9","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"3505":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-10","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#what-this-module-is-responsible-for","content":"This module provides a performance measurement suite to resolve a specific architectural conflict: whether using a shared, multiplatform decoder for the `FETCH` response imposes a performance penalty on JVM clients compared to a specialized, JVM-only reader."},"3506":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-11","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#the-fetch-decoder-dilemma","content":"The architectural conflict arises from the need for checksum verification. Because the broker streams segment bytes to the socket without looking at them (zero-copy), the client is the only party that can verify the data. This creates a tension between two approaches: a `ResponseReader` optimized for the JVM and a `ResponseDecoder` designed for multiplatform compatibility. As noted in `FetchDecodeBenchmark.kt:19-31`, the decision to merge these paths was deferred until measurements could prove whether the shared decoder's abstraction would cost the JVM reader performance."},"3507":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-12","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#responsereader-vs-responsedecoder","content":"The benchmark compares two distinct paths:"},"3508":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-13","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#responsereader-vs-responsedecoder","content":"**`reader()`**: Uses `ResponseReader.fetch` over `ByteBuffer`, which is a JVM-only implementation (`FetchDecodeBenchmark.kt:74`)."},"3509":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-14","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#responsereader-vs-responsedecoder","content":"**`decoder()`**: Uses `ResponseDecoder.fetch` over `ByteArray` and index arithmetic, which is shared with Kotlin/Native (`FetchDecodeBenchmark.kt:24-25`)."},"3510":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-15","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#responsereader-vs-responsedecoder","content":"The core of the comparison is whether the `CRC32C` intrinsic on the JVM is efficient enough to offset the overhead of the shared decoder's abstraction."},"3511":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-16","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"The `recordSize` parameter is used to isolate the cost of bookkeeping versus the cost of checksumming. The benchmark tests three specific sizes:"},"3512":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-17","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"recordSize"},"3513":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-18","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"Impact"},"3514":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-19","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"64 B"},"3515":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-20","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"Bookkeeping is as visible as it ever gets (`FetchDecodeBenchmark.kt:33`)"},"3516":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-21","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"1024 B"},"3517":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-22","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"Intermediate scaling"},"3518":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-23","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"8192 B"},"3519":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-24","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#recordsize-and-throughput-scaling","content":"Checksum dominates the execution time (`FetchDecodeBenchmark.kt:33`)"},"3520":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-25","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#corruptrecordexception-and-offset-mapping","content":"When a checksum mismatch is detected, the protocol-level `CorruptRecordException` contains an offset relative to the start of the fetch. The `ResponseReader` is responsible for translating this into a client-level exception. Specifically, it catches the protocol exception and re-throws a client-side `CorruptRecordException` where the offset is adjusted to be relative to the fetch, ensuring the caller receives a consistent API (`ResponseReader.kt:93-99`)."},"3521":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-26","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#truncated-response-handling","content":"The decoder must distinguish between different types of incomplete data to prevent false alarms. The `fetch` logic handles two specific edge cases:"},"3522":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-27","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#truncated-response-handling","content":"**Truncated Payload**: If the `size` of a record is greater than the remaining bytes in the buffer, it returns a `FetchResponse` with `truncated = true` and the `truncatedRecordBytes` set to the expected size (`Responses.kt:129-137`)."},"3523":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-28","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#truncated-response-handling","content":"**Truncated Header**: If the response ends while reading a record header (fewer bytes left than `Protocol.RECORD_HEADER_BYTES`), the response is marked as truncated, but the `truncatedRecordBytes` remains zero because the size could not be determined (`Responses.kt:152`)."},"3524":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-29","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"File"},"3525":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-30","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"Lines"},"3526":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-31","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"What is there"},"3527":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-32","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`…/benchmark/FetchDecodeBenchmark.kt`"},"3528":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-33","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`40-78`"},"3529":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-34","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"The benchmark state, setup logic, and the two target benchmark methods."},"3530":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-35","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`…/client/ResponseReader.kt`"},"3531":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-36","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`90-108`"},"3532":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-37","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"The `fetch` implementation that maps protocol results to client results."},"3533":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-38","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`…/wire/Responses.kt`"},"3534":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-39","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"`96-154`"},"3535":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-40","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#key-files","content":"The core `fetch` logic including checksum verification and truncation detection."},"3536":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-41","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#behaviour-that-surprises","content":"`ResponseDecoder.fetch` uses a `check(promised == reader.remaining)` to ensure the frame length matches the promised payload, which serves as a consistency check for the log state (`Responses.kt:114`)."},"3537":{"id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the-42","page_id":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the","tags":[],"type":"text","url":"/wiki/booblik-benchmark/fetchdecodebenchmark-and-the#behaviour-that-surprises","content":"The `ResponseReader.fetch` method performs a translation of exceptions rather than a direct propagation to maintain the library's public API contract (`ResponseReader.kt:94-99`)."},"3538":{"id":"/wiki/booblik-benchmark","page_id":"/wiki/booblik-benchmark","type":"page","content":"booblik-benchmark","breadcrumbs":["Docs","Wiki","booblik-benchmark"],"tags":[],"url":"/wiki/booblik-benchmark"},"3539":{"id":"/wiki/booblik-benchmark-0","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3540":{"id":"/wiki/booblik-benchmark-1","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#diagram","content":"Diagram"},"3541":{"id":"/wiki/booblik-benchmark-2","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#measurementdir-and-volatile-filesystems","content":"MeasurementDir and volatile filesystems"},"3542":{"id":"/wiki/booblik-benchmark-3","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#fetchdecodebenchmark-and-the-jvm-reader-cost","content":"FetchDecodeBenchmark and the JVM reader cost"},"3543":{"id":"/wiki/booblik-benchmark-4","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#flowoverheadbenchmark-and-the-cost-of-abstraction","content":"FlowOverheadBenchmark and the cost of abstraction"},"3544":{"id":"/wiki/booblik-benchmark-5","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#partitionwriterbenchmark-and-batching-efficiency","content":"PartitionWriterBenchmark and batching efficiency"},"3545":{"id":"/wiki/booblik-benchmark-6","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#groupcommitbenchmark-and-the-durability-barrier","content":"GroupCommitBenchmark and the durability barrier"},"3546":{"id":"/wiki/booblik-benchmark-7","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Benchmark configuration and task registration"},"3547":{"id":"/wiki/booblik-benchmark-8","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#key-files","content":"Key files"},"3548":{"id":"/wiki/booblik-benchmark-9","page_id":"/wiki/booblik-benchmark","type":"heading","tags":[],"url":"/wiki/booblik-benchmark#behaviour-that-surprising","content":"Behaviour that surprising"},"3549":{"id":"/wiki/booblik-benchmark-10","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"3550":{"id":"/wiki/booblik-benchmark-11","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#what-this-module-is-responsible-for","content":"The `booblik-benchmark` module provides a comprehensive suite of performance measurements for the `booblik` project. It includes JMH-based benchmarks to measure throughput and latency of core components, as well as specialized \"probes\" designed to answer specific architectural questions regarding durability, recovery, and abstraction overhead."},"3551":{"id":"/wiki/booblik-benchmark-12","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#measurementdir-and-volatile-filesystems","content":"To prevent misleading results where `fsync` operations return instantly because they are running on RAM-backed filesystems like `tmpfs`, the `MeasurementDir` object enforces that all measurements occur on real physical storage. As defined in `MeasurementDir.kt:32-47`, the system explicitly refuses to create a directory if the underlying `FileStore` type is identified as `tmpfs` or `ramfs`."},"3552":{"id":"/wiki/booblik-benchmark-13","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#measurementdir-and-volatile-filesystems","content":"More: MeasurementDir and volatile filesystems"},"3553":{"id":"/wiki/booblik-benchmark-14","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#fetchdecodebenchmark-and-the-jvm-reader-cost","content":"This benchmark addresses M-140 by comparing the performance of the legacy `ResponseReader` (which uses `ByteBuffer`) against the new `ResponseDecoder` (which uses `ByteArray` and index arithmetic). As detailed in `FetchDecodeBenchmark.kt:37-40`, the goal is to determine if merging these two decoders imposes a measurable cost on the platform where reading occurs, with the test varying `recordSize` from 64 B to 8 KiB."},"3554":{"id":"/wiki/booblik-benchmark-15","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#fetchdecodebenchmark-and-the-jvm-reader-cost","content":"More: FetchDecodeBenchmark and the JVM reader cost"},"3555":{"id":"/wiki/booblik-benchmark-16","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#flowoverheadbenchmark-and-the-cost-of-abstraction","content":"This benchmark isolates the cost of the Kotlin `Flow` machinery by removing the network component and comparing three distinct execution shapes: a standard `loop`, a `coldFlow`, and a `bufferedFlow`. According to `FlowOverheadBenchmark.kt:24-35`, this allows the developer to distinguish between the inherent cost of the `Flow` abstraction and the decoupling cost introduced by a channel/buffer."},"3556":{"id":"/wiki/booblik-benchmark-17","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#partitionwriterbenchmark-and-batching-efficiency","content":"This benchmark measures the overhead of the write actor and the efficiency gains provided by batching. As described in `PartitionWriterBenchmark.kt:28-43`, it compares a single-record unit against various `batchSize` settings and `AckPolicy` configurations to determine the \"actor's price\" in terms of records per second."},"3557":{"id":"/wiki/booblik-benchmark-18","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#groupcommitbenchmark-and-the-durability-barrier","content":"This benchmark analyzes how throughput scales as the number of concurrent producers increases and how the `groupWindowMillis` affects the durability barrier. As noted in `GroupCommitBenchmark.kt:34-43`, it tests the hypothesis that a writer collecting multiple producers into a single group can increase throughput without significantly increasing the latency of the individual producers."},"3558":{"id":"/wiki/booblik-benchmark-19","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"The module uses a custom Gradle configuration to manage JMH targets and specialized probes. The `build.gradle.kts` file defines several benchmark configurations:"},"3559":{"id":"/wiki/booblik-benchmark-20","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Configuration"},"3560":{"id":"/wiki/booblik-benchmark-21","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Description"},"3561":{"id":"/wiki/booblik-benchmark-22","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`main`"},"3562":{"id":"/wiki/booblik-benchmark-23","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Full run with 5 warmups and 10 iterations"},"3563":{"id":"/wiki/booblik-benchmark-24","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`writer`"},"3564":{"id":"/wiki/booblik-benchmark-25","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Focuses on `PartitionWriterBenchmark`"},"3565":{"id":"/wiki/booblik-benchmark-26","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`flow`"},"3566":{"id":"/wiki/booblik-benchmark-27","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Focuses on `FlowOverheadBenchmark`"},"3567":{"id":"/wiki/booblik-benchmark-28","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`decode`"},"3568":{"id":"/wiki/booblik-benchmark-29","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Focuses on `FetchDecodeBenchmark`"},"3569":{"id":"/wiki/booblik-benchmark-30","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`ci`"},"3570":{"id":"/wiki/booblik-benchmark-31","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Excludes `GroupCommitBenchmark` and uses `flushEveryAppend = false`"},"3571":{"id":"/wiki/booblik-benchmark-32","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"`quick`"},"3572":{"id":"/wiki/booblik-benchmark-33","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"Short run for rapid feedback (2 warmups, 3 iterations)"},"3573":{"id":"/wiki/booblik-benchmark-34","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#benchmark-configuration-and-task-registration","content":"The `build.gradle.kts:132-140` also registers several `probes` as `JavaExec` tasks, which are ordinary programs used to answer specific architectural questions rather than providing average throughput."},"3574":{"id":"/wiki/booblik-benchmark-35","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"File"},"3575":{"id":"/wiki/booblik-benchmark-36","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Lines"},"3576":{"id":"/wiki/booblik-benchmark-37","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"What is there"},"3577":{"id":"/wiki/booblik-benchmark-38","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`…/benchmark/MeasurementDir.kt`"},"3578":{"id":"/wiki/booblik-benchmark-39","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`27-49`"},"3579":{"id":"/wiki/booblik-benchmark-40","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Logic for creating measurement directories and preventing volatile filesystems."},"3580":{"id":"/wiki/booblik-benchmark-41","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`booblik-benchmark/build.gradle.kts`"},"3581":{"id":"/wiki/booblik-benchmark-42","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`57-125`"},"3582":{"id":"/wiki/booblik-benchmark-43","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"JMH target registrations and benchmark configurations."},"3583":{"id":"/wiki/booblik-benchmark-44","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`…/benchmark/FetchDecodeBenchmark.kt`"},"3584":{"id":"/wiki/booblik-benchmark-45","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`37-40`"},"3585":{"id":"/wiki/booblik-benchmark-46","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Benchmark class for comparing JVM reader and decoder."},"3586":{"id":"/wiki/booblik-benchmark-47","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`…/benchmark/FlowOverheadBenchmark.kt`"},"3587":{"id":"/wiki/booblik-benchmark-48","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`18-35`"},"3588":{"id":"/wiki/booblik-benchmark-49","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Benchmark class for measuring Flow abstraction overhead."},"3589":{"id":"/wiki/booblik-benchmark-50","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`…/benchmark/GroupCommitBenchmark.kt`"},"3590":{"id":"/wiki/booblik-benchmark-51","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`29-43`"},"3591":{"id":"/wiki/booblik-benchmark-52","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Benchmark class for measuring group commit scaling."},"3592":{"id":"/wiki/booblik-benchmark-53","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`…/benchmark/PartitionWriterBenchmark.kt`"},"3593":{"id":"/wiki/booblik-benchmark-54","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"`28-43`"},"3594":{"id":"/wiki/booblik-benchmark-55","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#key-files","content":"Benchmark class for measuring batching and acknowledgement costs."},"3595":{"id":"/wiki/booblik-benchmark-56","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#behaviour-that-surprising","content":"The `MeasurementDir` object treats a volatile filesystem as a **refusal** rather than a warning, throwing an `IllegalStateException` to prevent users from believing \"fast\" but false results (`MeasurementDir.kt:37-47`)."},"3596":{"id":"/wiki/booblik-benchmark-57","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#behaviour-that-surprising","content":"Benchmarks are placed in the `main` source set rather than a dedicated benchmark source set so that any refactoring that breaks a benchmark immediately breaks the build (`build.gradle.kts:54-56`)."},"3597":{"id":"/wiki/booblik-benchmark-58","page_id":"/wiki/booblik-benchmark","tags":[],"type":"text","url":"/wiki/booblik-benchmark#behaviour-that-surprising","content":"In `GroupCommitBenchmark`, the score is reported as **invocations per second**, meaning the actual records per second must be calculated by multiplying the score by the number of producers (`GroupCommitBenchmark.kt:41-43`)."},"3598":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"page","content":"MeasurementDir and volatile filesystems","breadcrumbs":["Docs","Wiki","booblik-benchmark"],"tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile"},"3599":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-0","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#diagram","content":"Diagram"},"3600":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-1","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#measurementdir","content":"MeasurementDir"},"3601":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-2","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#the-volatile-refusal","content":"The VOLATILE refusal"},"3602":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-3","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#the-buildmeasurements-default","content":"The build/measurements default"},"3603":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-4","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#describe-and-filesystem-attribution","content":"describe() and filesystem attribution"},"3604":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-5","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#sustainedwriteprobe-and-the-writeback-barrier","content":"SustainedWriteProbe and the writeback barrier"},"3605":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-6","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"Key files"},"3606":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-7","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir-and-volatile#behaviour-that-surprises","content":"Behaviour that surprises"},"3607":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-8","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"3608":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-9","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#measurementdir","content":"The core mechanism for ensuring measurement validity by preventing tests on RAM-backed storage. The `MeasurementDir` object acts as a gatekeeper for all measuring entry points, ensuring that any directory used for a run is backed by a real device rather than volatile memory (`MeasurementDir.kt:39-47`)."},"3609":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-10","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#the-volatile-refusal","content":"The logic behind rejecting `tmpfs` and `ramfs` to prevent 'fast' but false results. The module defines a `VOLATILE` set containing `tmpfs` and `ramfs` (`MeasurementDir.kt:32`), and it explicitly refuses to return a directory if the `FileStore` type matches these, because `fsync` on such systems is a no-op that merely describes memory speed rather than disk performance (`MeasurementDir.kt:43-45`)."},"3610":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-11","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#the-buildmeasurements-default","content":"The mechanism that forces measurements onto the physical disk where the source tree resides. To avoid the trap of `java.io.tmpdir` (which is `tmpfs` on modern Ubuntu), the default path is set to `build/measurements` relative to the project root (`MeasurementDir.kt:40`), ensuring the measurement lands on the same filesystem where the source tree lives (`build.gradle.kts:31-35`)."},"3611":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-12","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#describe-and-filesystem-attribution","content":"How the physical medium is captured and reported in the benchmark header to ensure comparability. The `describe()` function attempts to capture the `FileStore` type and name (`MeasurementDir.kt:58-61`), which is then printed in the report header so that results from different hosts can be compared only if their medium is known (`MeasurementDir.kt:54-56`)."},"3612":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-13","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#sustainedwriteprobe-and-the-writeback-barrier","content":"How the probe interacts with the filesystem to saturate writeback and expose the difference between mapped and plain paths. The `SustainedWriteProbe` performs a long-running write loop that aims to saturate the kernel's writeback mechanism (`SustainedWriteProbe.kt:30-35`), specifically designed to observe if the memory-mapped path degrades more sharply than the plain path once the log exceeds the machine's physical RAM (`SustainedWriteProbe.kt:12-18`)."},"3613":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-14","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"File"},"3614":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-15","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"Lines"},"3615":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-16","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"What is there"},"3616":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-17","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`MeasurementDir.kt`"},"3617":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-18","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`29-49`"},"3618":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-19","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"Logic for resolving the base directory and validating it is not on a volatile filesystem."},"3619":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-20","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`SustainedWriteProbe.kt`"},"3620":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-21","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`40-137`"},"3621":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-22","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"The main loop for the sustained write probe, including throughput reporting and summary statistics."},"3622":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-23","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`build.gradle.kts`"},"3623":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-24","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"`34-44`"},"3624":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-25","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#key-files","content":"Configuration that injects the `booblik.bench.dir` system property into `JavaExec` tasks."},"3625":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-26","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#behaviour-that-surprises","content":"`MeasurementDir.create` will throw an `IllegalStateException` rather than issuing a warning, because a warning is often ignored after the measurement is already believed (`MeasurementDir.kt:24-25`)."},"3626":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-27","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#behaviour-that-surprises","content":"`SustainedWriteProbe` is designed to make the host machine \"unpleasant to use\" by intentionally saturating the system's writeback (`SustainedWriteProbe.kt:30-32`)."},"3627":{"id":"/wiki/booblik-benchmark/measurementdir-and-volatile-28","page_id":"/wiki/booblik-benchmark/measurementdir-and-volatile","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir-and-volatile#behaviour-that-surprises","content":"The `main` method in `SustainedWriteProbe` reports the machine's physical RAM because the page cache (which the probe competes with) is bounded by RAM, not by the JVM heap (`SustainedWriteProbe.kt:65-71`)."},"3628":{"id":"/wiki/booblik-benchmark/measurementdir","page_id":"/wiki/booblik-benchmark/measurementdir","type":"page","content":"MeasurementDir","breadcrumbs":["Docs","Wiki","booblik-benchmark"],"tags":[],"url":"/wiki/booblik-benchmark/measurementdir"},"3629":{"id":"/wiki/booblik-benchmark/measurementdir-0","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#diagram","content":"Diagram"},"3630":{"id":"/wiki/booblik-benchmark/measurementdir-1","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#what-this-module-is-responsible-for","content":"What this module is responsible for"},"3631":{"id":"/wiki/booblik-benchmark/measurementdir-2","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#measurementdir","content":"MeasurementDir"},"3632":{"id":"/wiki/booblik-benchmark/measurementdir-3","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#volatile-filesystem-refusal","content":"Volatile Filesystem Refusal"},"3633":{"id":"/wiki/booblik-benchmark/measurementdir-4","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#the-create-lifecycle","content":"The `create` Lifecycle"},"3634":{"id":"/wiki/booblik-benchmark/measurementdir-5","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#filesystem-description","content":"Filesystem Description"},"3635":{"id":"/wiki/booblik-benchmark/measurementdir-6","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"Key files"},"3636":{"id":"/wiki/booblik-benchmark/measurementdir-7","page_id":"/wiki/booblik-benchmark/measurementdir","type":"heading","tags":[],"url":"/wiki/booblik-benchmark/measurementdir#behaviour-that-surprises","content":"Behaviour that surprises"},"3637":{"id":"/wiki/booblik-benchmark/measurementdir-8","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir","content":"Model `gemma-mtp`, commit `f508a4b65b3f`, 2026-08-15, sources: 6. Edit the code or the hand-written documentation instead."},"3638":{"id":"/wiki/booblik-benchmark/measurementdir-9","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir","content":"Documentation for the `MeasurementDir` component within the `booblik-benchmark` module, focusing on its role in ensuring measurement integrity by preventing volatile filesystems and providing environmental context."},"3639":{"id":"/wiki/booblik-benchmark/measurementdir-10","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#what-this-module-is-responsible-for","content":"The `MeasurementDir` object is responsible for ensuring that any directory used for benchmarking is backed by physical storage rather than volatile memory. It prevents the \"false speed\" trap where `fsync` operations return instantly because they are only hitting RAM, as seen in the failure where a probe reported 0.01 ms `fsync` on `tmpfs` (`MeasurementDir.kt:10-13`)."},"3640":{"id":"/wiki/booblik-benchmark/measurementdir-11","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#measurementdir","content":"The core object responsible for creating valid measurement environments. It acts as a guard against invalid measurement mediums, ensuring that the results reflect disk performance rather than memory speed (`MeasurementDir.kt:27-49`)."},"3641":{"id":"/wiki/booblik-benchmark/measurementdir-12","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#volatile-filesystem-refusal","content":"The mechanism that prevents measurements on `tmpfs` or `ramfs` to avoid measuring memory instead of disk. The module defines a set of `VOLATILE` filesystems (`tmpfs`, `ramfs`) (`MeasurementDir.kt:32`) and will refuse to return a directory if the `FileStore` type matches these, as a measurement on such a medium is considered \"fiction\" (`MeasurementDir.kt:33-47`)."},"3642":{"id":"/wiki/booblik-benchmark/measurementdir-13","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#the-create-lifecycle","content":"The process of resolving the base directory via `booblik.bench.dir` and validating the `FileStore` type. The `create` function first checks for the `booblik.bench.dir` system property (`MeasurementDir.kt:40`); if absent, it defaults to `build/measurements` (`MeasurementDir.kt:40`). After creating the base directories (`MeasurementDir.kt:41`), it validates the `FileStore` to ensure the medium is not volatile before returning a new temporary directory with the provided prefix (`MeasurementDir.kt:41-49`)."},"3643":{"id":"/wiki/booblik-benchmark/measurementdir-14","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#filesystem-description","content":"The `describe` function and its role in providing the medium's identity in report headers. This function attempts to retrieve the `FileStore` for a given path to return a string containing the filesystem type and name (`MeasurementDir.kt:58-62`), which is used in probe reports to ensure results are comparable across different hosts (`MeasurementDir.kt:54-56`)."},"3644":{"id":"/wiki/booblik-benchmark/measurementdir-15","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"File"},"3645":{"id":"/wiki/booblik-benchmark/measurementdir-16","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"Lines"},"3646":{"id":"/wiki/booblik-benchmark/measurementdir-17","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"What is there"},"3647":{"id":"/wiki/booblik-benchmark/measurementdir-18","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"`…/benchmark/MeasurementDir.kt`"},"3648":{"id":"/wiki/booblik-benchmark/measurementdir-19","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"`27-49`"},"3649":{"id":"/wiki/booblik-benchmark/measurementdir-20","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"The `MeasurementDir` object containing logic for directory creation and validation."},"3650":{"id":"/wiki/booblik-benchmark/measurementdir-21","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"`…/benchmark/MeasurementDir.kt`"},"3651":{"id":"/wiki/booblik-benchmark/measurementdir-22","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"`58-62`"},"3652":{"id":"/wiki/booblik-benchmark/measurementdir-23","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#key-files","content":"The `describe` function for filesystem identification."},"3653":{"id":"/wiki/booblik-benchmark/measurementdir-24","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#behaviour-that-surprises","content":"The `create` function will throw an `IllegalStateException` rather than issuing a warning if a volatile filesystem is detected, because a warning is often ignored after the number has already been believed (`MeasurementDir.kt:24-25`)."},"3654":{"id":"/wiki/booblik-benchmark/measurementdir-25","page_id":"/wiki/booblik-benchmark/measurementdir","tags":[],"type":"text","url":"/wiki/booblik-benchmark/measurementdir#behaviour-that-surprises","content":"The default measurement directory is not the system's temporary directory (`java.io.tmpdir`), but `build/measurements`, to ensure measurements land on a real filesystem where the source tree lives (`MeasurementDir.kt:22-23`)."},"3655":{"id":"/wiki/booblik-core","page_id":"/wiki/booblik-core","type":"page","content":"booblik-core","breadcrumbs":["Docs","Wiki","booblik-core"],"tags":[],"url":"/wiki/booblik-core"},"3656":{"id":"/wiki/booblik-core-0","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#diagram","content":"Diagram"},"3657":{"id":"/wiki/booblik-core-1","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#position","content":"Position"},"3658":{"id":"/wiki/booblik-core-2","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#partitionlog","content":"PartitionLog"},"3659":{"id":"/wiki/booblik-core-3","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#logsegment","content":"LogSegment"},"3660":{"id":"/wiki/booblik-core-4","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#segmentmode","content":"SegmentMode"},"3661":{"id":"/wiki/booblik-core-5","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#recovery-after-a-crash","content":"Recovery after a crash"},"3662":{"id":"/wiki/booblik-core-6","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#the-write-actor-and-group-commit","content":"The write actor and group commit"},"3663":{"id":"/wiki/booblik-core-7","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#key-files","content":"Key files"},"3664":{"id":"/wiki/booblik-core-8","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#public-api","content":"Public API"},"3665":{"id":"/wiki/booblik-core-9","page_id":"/wiki/booblik-core","type":"heading","tags":[],"url":"/wiki/booblik-core#behaviour-that-surprises","content":"Behaviour that surprises"},"3666":{"id":"/wiki/booblik-core-10","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core","content":"Model `gemma-mtp`, commit `ef58254ca7be`, 2026-08-16, sources: 6. Edit the code or the hand-written documentation instead."},"3667":{"id":"/wiki/booblik-core-11","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#position","content":"The `Position` value class represents a byte position inside a single segment file, using an `Int` to match the indexing limits of `MappedByteBuffer` and `transferTo` calls `Position.kt:6-8`."},"3668":{"id":"/wiki/booblik-core-12","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#partitionlog","content":"`PartitionLog` is the high-level abstraction of an ordered list of segments `PartitionLog.kt:33`. It manages the lifecycle of segments, including rolling to a new segment when the active one is full `PartitionLog.kt:75` and implementing a retention mechanism that unlinks old segments to maintain a maximum size or age `PartitionLog.kt:178`."},"3669":{"id":"/wiki/booblik-core-13","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#partitionlog","content":"More: PartitionLog"},"3670":{"id":"/wiki/booblik-core-14","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#logsegment","content":"A `LogSegment` is the physical storage unit consisting of a data file and a sparse index `LogSegment.kt:28`. It supports a dual read/write architecture where a single writer owns the write path while multiple readers can concurrently access the segment via `acquire` and `release` mechanisms `LogSegment.kt:194`."},"3671":{"id":"/wiki/booblik-core-15","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#logsegment","content":"More: LogSegment"},"3672":{"id":"/wiki/booblik-core-16","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"The write path used by a segment is determined by the `SegmentMode` enum `LogSegment.kt:25`:"},"3673":{"id":"/wiki/booblik-core-17","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"Mode"},"3674":{"id":"/wiki/booblik-core-18","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"Description"},"3675":{"id":"/wiki/booblik-core-19","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"`FILE_CHANNEL`"},"3676":{"id":"/wiki/booblik-core-20","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"Uses a standard `FileChannel` for writes."},"3677":{"id":"/wiki/booblik-core-21","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"`MAPPED`"},"3678":{"id":"/wiki/booblik-core-22","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#segmentmode","content":"Uses a memory-mapped buffer for writes."},"3679":{"id":"/wiki/booblik-core-23","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#recovery-after-a-crash","content":"During startup, `LogSegment` performs a recovery process by walking the record headers from the start of the segment to rebuild the `SparseOffsetIndex` `LogSegment.kt:309`. This process verifies each record's checksum to ensure data integrity, discarding any trailing partial records `LogSegment.kt:354`."},"3680":{"id":"/wiki/booblik-core-24","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#the-write-actor-and-group-commit","content":"The `PartitionWriter` acts as a single-threaded actor that owns the write side of a partition `PartitionWriter.kt:18`. It uses a mailbox to receive `WriteCommand` batches and implements \"group commit\" by draining the mailbox to process multiple commands in a single batch, only triggering a costly `Log.force` if any command in the group requires it `PartitionWriter.kt:34`."},"3681":{"id":"/wiki/booblik-core-25","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#key-files","content":"File"},"3682":{"id":"/wiki/booblik-core-26","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#key-files","content":"Lines"},"3683":{"id":"/wiki/booblik-core-27","page_id":"/wiki/booblik-core","tags":[],"type":"text","url":"/wiki/booblik-core#ke